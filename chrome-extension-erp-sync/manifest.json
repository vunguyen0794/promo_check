{
  "manifest_version": 3,
  "name": "Phong Vũ ERP Auto Sync",
  "version": "1.1",
  "description": "Tự động đồng bộ kết nối ERP sang hệ thống Xuất kho nhanh mà không cần thao tác thủ công",
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://erp.phongvu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:3300/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:3300/*",
        "http://222.255.184.49/*",
        "https://webmien.duckdns.org/*",
        "http://webmien.duckdns.org/*",
        "https://*.vercel.app/*"
      ],
      "js": ["app_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
