    // --- HÀNG KHÔNG QUẢN LÝ SERIAL & TRA CỨU TỒN KHO THEO BIN ---
    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function stepNonSerialQty(sku, delta, max) {
        const curr = Number(nonSerialQuantities[sku] || 0);
        const next = Math.max(0, Math.min(Number(max), curr + delta));
        setNonSerialQty(sku, next, max);
    }

    function setNonSerialQty(sku, val, max) {
        let num = parseInt(val, 10);
        if (isNaN(num) || num < 0) num = 0;
        if (num > Number(max)) num = Number(max);
        nonSerialQuantities[sku] = num;
        renderSkuTable();
        if (num >= Number(max)) {
            playBeep('success');
            addLog(`Đã xác nhận đủ số lượng ${num}/${max} cho SKU ${sku} (Hàng không quản lý serial).`, 'success');
        }
    }

    let currentStockSku = null;

    async function openStockByBinModal(sku, skuName) {
        currentStockSku = sku;
        const modal = document.getElementById('stockByBinModal');
        const modalBody = document.getElementById('stockByBinModalBody');
        const badge = document.getElementById('lblStockByBinBadge');
        const nameLabel = document.getElementById('lblStockSkuName');
        const totalLabel = document.getElementById('lblStockTotalSummary');

        nameLabel.textContent = `[${sku}] ${skuName || ''}`;
        const branchCode = '<%= user.branch_code || "" %>' || currentOrder?.exportBranch || currentOrder?.branchCode || 'CP01';
        badge.textContent = `Chi nhánh ${branchCode}`;
        modal.style.display = 'flex';
        modalBody.innerHTML = '<div style="text-align: center; padding: 35px; color: var(--qe-text-muted);">⏳ Đang tra cứu tồn kho thực tế tại các BIN từ ERP...</div>';
        totalLabel.textContent = 'Tổng tồn kho: ...';

        try {
            const siteId = currentOrder?.siteId || '';
            const res = await fetch(`/api/quick-export/stock-by-bin?sku=${encodeURIComponent(sku)}&siteId=${encodeURIComponent(siteId)}`, {
                headers: { 'x-teko-token': tekoToken }
            });
            const data = await res.json();
            if (!data.success || !data.data) {
                throw new Error(data.message || 'Không thể lấy dữ liệu tồn kho từ ERP');
            }

            const stocks = data.data.stocks || [];
            if (stocks.length === 0) {
                modalBody.innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #94a3b8;">
                        <div style="font-size: 32px; margin-bottom: 8px;">📭</div>
                        <div style="font-weight: 600; font-size: 14px;">Không tìm thấy vị trí tồn kho nào còn hàng cho sản phẩm này!</div>
                        <div style="font-size: 12px; margin-top: 4px;">Vui lòng kiểm tra lại trên hệ thống ERP hoặc liên hệ thủ kho.</div>
                    </div>
                `;
                totalLabel.textContent = 'Tổng tồn kho: 0';
                return;
            }

            // Kiểm tra SKU này có phải hàng không serial không (để hiện nút "Chọn BIN")
