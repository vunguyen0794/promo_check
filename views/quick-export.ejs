    function renderSkuTable() {
        const tbody = document.getElementById('skuTableBody');
        tbody.innerHTML = '';

        let totalReq = 0;
        let totalScanned = 0;
        const statusUpper = String(currentOrder?.status || '').trim().toUpperCase();
        const isExported = Boolean(currentOrder?.isExported || statusUpper === 'EXPORTED' || statusUpper === 'COMPLETED');
        const isPacked = Boolean(currentOrder?.isPacked || statusUpper === 'PACKED');
        const isHandled = isExported || isPacked;

        currentOrder.items.forEach(item => {
            const sku = String(item.sku);
            const req = Number(item.requestQuantity) || 1;
            const isNoneTracking = String(item.tracking || '').trim().toLowerCase() === 'none';

            let count = 0;
            let isDone = false;
            let scannedList = [];

            if (isNoneTracking) {
                count = isHandled ? req : (Number(nonSerialQuantities[sku]) || 0);
                isDone = count >= req;
            } else {
                scannedList = scannedSerials[sku] || [];
                // Tự động đồng bộ serials nếu đơn đã xử lý nhưng scannedSerials rỗng
                if (scannedList.length === 0 && Array.isArray(item.serials) && item.serials.length > 0 && isHandled) {
                    scannedSerials[sku] = [...item.serials];
                    scannedList = scannedSerials[sku];
                    const defaultLabel = isPacked ? 'Đã đóng gói' : 'Đã xuất kho';
                    item.serials.forEach(sn => {
                        if (!serialBinNames[sn]) serialBinNames[sn] = defaultLabel;
                        if (!serialFifoMap[sn]) serialFifoMap[sn] = { pass: true, status: defaultLabel, message: `Serial ${defaultLabel.toLowerCase()}` };
                    });
                }
                count = scannedList.length;
                isDone = count >= req;
            }

            totalReq += req;
            totalScanned += count;

            const tr = document.createElement('tr');
            if (isDone) tr.className = 'row-completed';

            // Cột 1: Mã SKU (Bấm để xem gợi ý FIFO hoặc tồn kho theo BIN)
            const skuBadgeHtml = isNoneTracking
                ? `<span class="sku-code-badge" style="cursor: pointer;" onclick="openStockByBinModal('${sku}', '${escapeHtml(item.skuName)}')" title="Bấm để xem tồn kho vật lý theo BIN">${sku}</span>`
                : `<span class="sku-code-badge" style="cursor: pointer;" onclick="openFifoModal('${sku}')" title="Bấm để xem gợi ý serial FIFO của SKU này">${sku}</span>`;

            // Cột 4: Tiến độ (Hàng không serial: Stepper pill 1 dòng tinh gọn)
            let progressColHtml = '';
            if (isNoneTracking) {
                if (isHandled) {
                    progressColHtml = `<span class="badge-qty done">${count}/${req}</span>`;
                } else {
                    progressColHtml = `
                        <div class="qe-stepper ${isDone ? 'done' : 'pending'}">
                            <button type="button" class="btn-step" onclick="stepNonSerialQty('${sku}', -1, ${req})" title="Giảm số lượng" ${count <= 0 ? 'disabled' : ''}>−</button>
                            <span class="step-label" onclick="setNonSerialQty('${sku}', ${count >= req ? 0 : req}, ${req})" title="Bấm để ${count >= req ? 'đặt về 0' : 'soạn đủ'}">${count}/${req}</span>
                            <button type="button" class="btn-step" onclick="stepNonSerialQty('${sku}', 1, ${req})" title="Tăng số lượng" ${count >= req ? 'disabled' : ''}>+</button>
                        </div>
                    `;
                }
            } else {
                progressColHtml = `<span class="badge-qty ${isDone ? 'done' : 'pending'}">${count}/${req}</span>`;
            }

            // Cột 5: Serials hoặc Tồn kho vật lý theo BIN
            let actionColHtml = '';
            if (isNoneTracking) {
                const selBin = nonSerialBins[sku];
                const binInfoHtml = selBin
                    ? `<span style="display:inline-flex;align-items:center;gap:5px;background:#f0fdf4;border:1px solid #86efac;color:#15803d;font-size:12px;font-weight:700;padding:3px 9px;border-radius:6px;">
                           📍 ${selBin.binName}
                           <span style="background:#dcfce7;color:#15803d;font-size:10px;padding:1px 5px;border-radius:3px;">${selBin.quantity} tồn</span>
                           <span onclick="clearNonSerialBin('${sku}')" title="Bỏ chọn BIN này" style="cursor:pointer;color:#94a3b8;font-size:13px;line-height:1;padding-left:2px;">&times;</span>
                       </span>`
                    : `<span style="display:inline-flex;align-items:center;gap:4px;background:#fff7ed;border:1px dashed #fb923c;color:#ea580c;font-size:12px;font-weight:600;padding:3px 9px;border-radius:6px;">
                           ⚠️ Chưa chọn BIN lấy hàng
                       </span>`;
                actionColHtml = `
                    <div class="non-serial-cell">
                        <button type="button" 
                                class="btn-bin-lookup" 
                                onclick="openStockByBinModal('${sku}', '${escapeHtml(item.skuName)}')" 
                                title="Xem tồn kho và chọn BIN lấy hàng">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right: 4px; vertical-align: -1.5px;">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            Chọn BIN lấy hàng
                        </button>
                        ${binInfoHtml}
                    </div>
                `;
            } else {
                actionColHtml = `
                    <div class="serial-tag-box" id="serialList_${sku}">
                        ${scannedList.map((sn, idx) => {
                            const fifo = serialFifoMap[sn];
                            const isPass = fifo ? fifo.pass : true;
                            const diffDays = fifo?.diffDays || 0;
                            const fifoText = isPass 
                                ? (fifo?.rank === 1 ? '✓ FIFO' : `✓ FIFO (+${diffDays}d)`) 
                                : `⚠️ Lệch ${diffDays}d`;

                            return `
                                <div class="serial-item ${isPass ? 'fifo-pass' : 'fifo-warn'}" title="${fifo?.message || ''}">
                                    <strong>${sn}</strong>
                                    <span style="color: #64748b; font-size: 11px;">[${serialBinNames[sn] || pickingBin.name || 'Kho'}]</span>
                                    <span class="serial-fifo-badge ${isPass ? 'pass' : 'warn'}">${fifoText}</span>
                                    ${!isHandled ? `<span class="btn-del-sn" onclick="removeSerial('${sku}', ${idx})" title="Xoá">&times;</span>` : ''}
                                </div>
                            `;
                        }).join('')}
                        ${!isDone && !isHandled ? `
                            <button type="button" class="btn-fifo-quick-pick" onclick="openFifoModal('${sku}')" title="Mở danh sách gợi ý serial FIFO của SKU này">
                                <span>📋</span>
                                <span>Gợi ý Serial FIFO (${req - count} cần lấy)</span>
                            </button>
                        ` : ''}
                        ${scannedList.length === 0 && (isDone || isHandled) ? '<span style="color: #94a3b8; font-size: 12px; font-style: italic;">Chưa có serial nào</span>' : ''}
                    </div>
                `;
            }

            tr.innerHTML = `
                <td>${skuBadgeHtml}</td>
                <td>
                    <div class="sku-name-text">${item.skuName}</div>
                    <div class="sku-sub-meta">
                        <span>ĐVT: ${item.uom || 'Cái'}</span>
                        <span class="sku-meta-dot">•</span>
                        ${isNoneTracking ? '<span class="tag-track-none">Không serial</span>' : '<span class="tag-track-serial">Quản lý serial</span>'}
                    </div>
                </td>
                <td style="text-align: center; font-weight: 700; font-size: 14px;">${req}</td>
                <td style="text-align: center;">${progressColHtml}</td>
                <td>${actionColHtml}</td>
            `;
            tbody.appendChild(tr);
        });

        // Cập nhật tiến độ trên badge
        const progBadge = document.getElementById('scanProgressBadge');
        if (progBadge) {
            if (isExported) {
                progBadge.textContent = `Đã xuất ${totalScanned}/${totalReq} (Hoàn tất)`;
                progBadge.className = 'badge-qty done';
            } else if (isPacked) {
                progBadge.textContent = `Đã đóng gói ${totalScanned}/${totalReq}`;
                progBadge.className = 'badge-qty done';
            } else {
                progBadge.textContent = `${totalScanned}/${totalReq} Đã soạn`;
                progBadge.className = (totalScanned >= totalReq && totalReq > 0) ? 'badge-qty done' : 'badge-qty pending';
            }
        }

        const isReady = (totalScanned >= totalReq && totalReq > 0);
        const packingBtn = document.getElementById('btnConfirmPacking');
        if (packingBtn) {
            packingBtn.disabled = !isReady;
        }

        const finishBtn = document.getElementById('btnFinishExport');
        if (finishBtn) {
            finishBtn.disabled = !isReady;
        }
    }

    // --- QUÉT SERIAL & CHECK FIFO SUPABASE ---
    async function executeScanSerial(serial) {
        if (!serial) throw new Error('Mã serial không được để trống.');
        if (!currentOrder) throw new Error('Vui lòng tìm mã đơn trước!');
        if (currentOrder.isExported || currentOrder.status === 'EXPORTED') {
            throw new Error('Đơn này đã xuất kho hoàn tất!');
        }

        for (const [sku, list] of Object.entries(scannedSerials)) {
            if (list.includes(serial)) {
                throw new Error(`Serial "${serial}" đã được quét trước đó trong SKU ${sku}!`);
            }
        }

        addLog(`Đang kiểm tra Serial [${serial}] và đối soát rule FIFO...`);

        const res = await fetch('/api/quick-export/process-serial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-teko-token': tekoToken
            },
            body: JSON.stringify({
                serial,
                pickingBinId: pickingBin.id,
                pickingBinName: pickingBin.name,
                orderItems: currentOrder.items,
                scannedSerials,
                siteId: currentOrder.siteId
            })
        });

        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Không thể xử lý serial');

        const { sku, moved, binId, binName, fromBinName, toBinName, fifo } = data;

        if (!scannedSerials[sku]) scannedSerials[sku] = [];
        scannedSerials[sku].push(serial);

        serialBinMap[serial] = binId || pickingBin.id;
        serialBinNames[serial] = binName || toBinName || fromBinName || pickingBin.name;
        serialFifoMap[serial] = fifo || { pass: true, status: 'Đạt FIFO' };

        if (fifo && !fifo.pass) {
            playBeep('fifo-warn');
            addLog(`⚠️ [FIFO CẢNH BÁO] Serial [${serial}]: ${fifo.message}`, 'warn');
        } else {
            playBeep('success');
            addLog(`🟢 Serial [${serial}] tại BIN [${fromBinName || binName}]: Đạt FIFO!`, 'success');
        }

        renderSkuTable();
        return data;
    }

    async function handleScanSerialSubmit() {
        const sInput = document.getElementById('txtSerialScan');
        const sBtn = document.getElementById('btnScanSerial');
        const serial = sInput.value.trim();
        if (!serial) return;

        sInput.disabled = true;
        if (sBtn) {
            sBtn.disabled = true;
            sBtn.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:qeSpin 0.6s linear infinite;vertical-align:middle;margin-right:4px;"></span> Đang nhận...';
        }

        try {
            await executeScanSerial(serial);
            sInput.value = '';
        } catch (err) {
            playBeep('error');
            addLog(`Lỗi xử lý serial "${serial}": ${err.message}`, 'error');
            alert(`Lỗi serial: ${err.message}`);
        } finally {
            sInput.disabled = false;
            if (sBtn) {
                sBtn.disabled = false;
                sBtn.innerHTML = '⚡ Nhận Serial';
            }
            sInput.focus();
        }
    }

    function removeSerial(sku, index) {
        if (scannedSerials[sku] && scannedSerials[sku][index] !== undefined) {
            const removed = scannedSerials[sku].splice(index, 1);
            if (removed[0]) {
                delete serialBinMap[removed[0]];
                delete serialBinNames[removed[0]];
                delete serialFifoMap[removed[0]];
                addLog(`Đã huỷ serial ${removed[0]} khỏi SKU ${sku}.`, 'warn');
            }
            renderSkuTable();
        }
    }

    function resetForNewOrder() {
        currentOrder = null;
        scannedSerials = {};
        serialBinMap = {};
        serialBinNames = {};
        serialFifoMap = {};
        document.getElementById('cardScanning').style.display = 'none';
        document.getElementById('orderOverview').style.display = 'none';
        const docInput = document.getElementById('txtDocumentId');
        docInput.value = '';
        docInput.focus();
    }

    // --- XÁC NHẬN SOẠN HÀNG HOẶC HOÀN TẤT XUẤT KHO ---
    let isSubmittingExport = false;
    async function handleConfirmExport(isAutoHandover = true) {
        if (!currentOrder) return;
        if (isSubmittingExport) {
            console.warn('[QuickExport] Đang gửi yêu cầu xuất kho, bỏ qua click lặp lại.');
            return;
        }

        const confirmMsg = isAutoHandover 
            ? `Xác nhận và hoàn tất xuất kho (soạn hàng + bàn giao) cho đơn hàng #${currentOrder.documentId}?`
            : `Xác nhận soạn hàng (chuyển trạng thái sang ĐÃ ĐÓNG GÓI) cho đơn hàng #${currentOrder.documentId}?`;

        if (!confirm(confirmMsg)) return;

        isSubmittingExport = true;
        const packingBtn = document.getElementById('btnConfirmPacking');
        const finishBtn = document.getElementById('btnFinishExport');
        if (packingBtn) packingBtn.disabled = true;
        if (finishBtn) finishBtn.disabled = true;

        if (isAutoHandover) {
            if (finishBtn) finishBtn.textContent = '⏳ Đang hoàn tất xuất kho...';
        } else {
            if (packingBtn) packingBtn.textContent = '⏳ Đang xác nhận soạn hàng...';
        }

        addLog(isAutoHandover 
            ? `Đang gửi yêu cầu xuất kho hoàn tất (bàn giao) lên ERP và tick "Đã xuất" trong bảng FIFO...`
            : `Đang gửi yêu cầu xác nhận soạn hàng (đóng gói) lên ERP và tick "Đã xuất" trong bảng FIFO...`
        );

        try {
            // Kiểm tra hàng không serial: phải chọn BIN trước khi xác nhận
            const missingBinSkus = currentOrder.items
                .filter(it => String(it.tracking || '').trim().toLowerCase() === 'none')
                .filter(it => !nonSerialBins[String(it.sku)])
                .map(it => `${it.sku} - ${it.skuName}`);

            if (missingBinSkus.length > 0) {
                alert(`⚠️ Chưa chọn BIN lấy hàng cho:\n${missingBinSkus.join('\n')}\n\nVui lòng bấm "Chọn BIN lấy hàng" → chọn BIN cần lấy trước khi xác nhận!`);
                if (packingBtn) { packingBtn.disabled = false; packingBtn.innerHTML = '📦 Xác nhận soạn hàng'; }
                if (finishBtn) { finishBtn.disabled = false; finishBtn.innerHTML = '✅ Xác nhận & Hoàn tất xuất kho'; }
                return;
            }

            const payloadItems = currentOrder.items.map(it => {
                const skuKey = String(it.sku);
                const isNoneTracking = String(it.tracking || '').trim().toLowerCase() === 'none';
                const snList = (!isNoneTracking && scannedSerials[skuKey] && scannedSerials[skuKey].length > 0)
                    ? scannedSerials[skuKey]
                    : (Array.isArray(it.serials) ? it.serials : []);
                const selectedBin = nonSerialBins[skuKey];
                return {
                    sku: skuKey,
                    serials: isNoneTracking ? [] : snList,
                    lots: [],
                    ...(isNoneTracking && selectedBin ? { fromBinId: selectedBin.binId, fromBinName: selectedBin.binName } : {})
                };
            });

            const res = await fetch('/api/quick-export/confirm-export', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-teko-token': tekoToken
                },
                body: JSON.stringify({
                    requestId: currentOrder.requestId || currentOrder.documentId,
                    documentId: currentOrder.documentId,
                    pickingBinId: pickingBin.id,
                    items: payloadItems,
                    receiverName: currentOrder.receiverName,
                    siteId: currentOrder.siteId,
                    serialBinMap,
                    isAutoHandover: Boolean(isAutoHandover)
                })
            });

            const data = await res.json();
            if (!data.success) throw new Error(data.message || 'Lỗi xử lý trên ERP');

            playBeep('success');
            const savedDoc = currentOrder.documentId;

            if (data.isAlreadyDone) {
                addLog(`ℹ️ ${data.message}`, 'info');
                alert(`ℹ️ Thông báo:\n${data.message}`);
            } else if (isAutoHandover) {
                addLog(`🎉 XUẤT KHO HOÀN TẤT THÀNH CÔNG ĐƠN HÀNG #${savedDoc}!`, 'success');
                alert(`🎉 Chúc mừng!\nĐơn hàng #${savedDoc} đã hoàn tất xuất kho (soạn hàng + bàn giao) thành công trên ERP và tick "Đã xuất" vào bảng FIFO!`);
            } else {
                addLog(`📦 ĐÃ SOẠN HÀNG (ĐÃ ĐÓNG GÓI) THÀNH CÔNG ĐƠN HÀNG #${savedDoc}!`, 'success');
                alert(`📦 Chúc mừng!\nĐơn hàng #${savedDoc} đã chuyển sang trạng thái ĐÃ ĐÓNG GÓI thành công trên ERP và tick "Đã xuất" vào bảng FIFO!`);
            }

            // Tự động tải lại thông tin đơn hàng vừa soạn để cập nhật trạng thái mới và hiển thị serials đã soạn
            await handleSearchOrder(savedDoc);

        } catch (err) {
            playBeep('error');
            addLog(`Lỗi xử lý: ${err.message}`, 'error');
            alert(`Lỗi: ${err.message}`);
        } finally {
            isSubmittingExport = false;
            if (packingBtn) {
                packingBtn.disabled = false;
                packingBtn.textContent = '📦 Xác nhận soạn hàng';
            }
            if (finishBtn) {
                finishBtn.disabled = false;
                finishBtn.textContent = '✅ Xác nhận & Hoàn tất xuất kho';
            }
        }
    }

    // --- MODAL GỢI Ý SERIAL CHUẨN FIFO ---
    let globalFifoData = null;

    async function openFifoModal(targetSku = null) {
        if (!currentOrder || !currentOrder.items || currentOrder.items.length === 0) {
            alert('Vui lòng tìm mã đơn hàng trước khi xem gợi ý FIFO!');
            return;
        }

        if (targetSku) {
            const it = currentOrder.items.find(i => String(i.sku) === String(targetSku));
            if (it && String(it.tracking || '').trim().toLowerCase() === 'none') {
                openStockByBinModal(targetSku, it.skuName);
                return;
            }
        }

        const serialItems = currentOrder.items.filter(it => String(it.tracking || '').trim().toLowerCase() !== 'none');
        if (serialItems.length === 0) {
            alert('Đơn hàng này không có sản phẩm nào quản lý bằng Serial để check FIFO!');
            return;
        }

        const modal = document.getElementById('fifoModal');
        const modalBody = document.getElementById('fifoModalBody');
        const branchBadge = document.getElementById('lblFifoBranchBadge');
        const tabsBox = document.getElementById('fifoTabsContainer');
        modal.style.display = 'flex';

        const branchCode = '<%= user.branch_code || "" %>' || currentOrder.exportBranch || currentOrder.branchCode || 'CP01';
        branchBadge.textContent = `Chi nhánh ${branchCode}`;
        modalBody.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--qe-text-muted);">⏳ Đang tải dữ liệu serial tồn kho theo chuẩn FIFO...</div>';

        const skus = serialItems.map(it => it.sku);

        try {
            const res = await fetch('/api/quick-export/fifo-recommendation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ skus, branchCode })
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.message || 'Lỗi tải dữ liệu FIFO');

            globalFifoData = data.skusData || {};

            // Render SKU Tabs
            tabsBox.innerHTML = `
                <button type="button" class="btn-header-action" style="border-radius: 20px; font-size: 12px; padding: 4px 12px; background: ${!targetSku ? 'var(--qe-blue-primary)' : '#f8fafc'}; color: ${!targetSku ? '#fff' : 'var(--qe-text-secondary)'};" onclick="renderFifoModalContent(null)">
                    Tất cả SKU (${serialItems.length})
                </button>
            `;

            serialItems.forEach(it => {
                const sCount = (globalFifoData[it.sku] || []).length;
                const isActive = (targetSku && String(targetSku) === String(it.sku));
                tabsBox.innerHTML += `
                    <button type="button" class="btn-header-action" style="border-radius: 20px; font-size: 12px; padding: 4px 12px; background: ${isActive ? 'var(--qe-blue-primary)' : '#f8fafc'}; color: ${isActive ? '#fff' : 'var(--qe-text-secondary)'};" onclick="renderFifoModalContent('${it.sku}')">
                        ${it.sku} (${sCount} tồn)
                    </button>
                `;
            });

            renderFifoModalContent(targetSku);

        } catch (err) {
            modalBody.innerHTML = `<div style="text-align: center; padding: 30px; color: var(--qe-red-primary);">❌ Lỗi tải dữ liệu FIFO: ${err.message}</div>`;
        }
    }

