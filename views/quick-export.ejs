        if (isExported) {
            banner.style.display = 'flex';
            banner.style.background = '#f0fdf4';
            banner.style.borderColor = '#bbf7d0';
            bannerIcon.textContent = '✓';
            bannerIcon.style.background = '#22c55e';
            bannerTitle.textContent = 'ĐƠN HÀNG ĐÃ HOÀN TẤT XUẤT KHO TRÊN ERP';
            bannerTitle.style.color = '#15803d';

            const userStr = currentOrder.exportedBy ? `bởi ${currentOrder.exportedBy}` : '';
            const timeStr = currentOrder.exportedDate ? `lúc ${new Date(currentOrder.exportedDate * 1000).toLocaleString('vi-VN')}` : '';
            bannerDesc.textContent = `Đơn này đã hoàn thành xuất kho ${userStr} ${timeStr}. Dưới đây là danh sách serial đã xuất.`.trim();
            bannerDesc.style.color = '#166534';

            scannerGroup.style.display = 'none';
            actionFooter.innerHTML = `
                <button class="qe-btn-primary" style="background: #64748b;" onclick="resetForNewOrder()">
                    🔄 Quét đơn khác
                </button>
            `;
        } else if (isPacked) {
            banner.style.display = 'flex';
            banner.style.background = '#eff6ff';
            banner.style.borderColor = '#bfdbfe';
            bannerIcon.textContent = '📦';
            bannerIcon.style.background = '#2563eb';
            bannerTitle.textContent = 'ĐƠN HÀNG ĐÃ ĐÓNG GÓI (CHỜ BÀN GIAO XUẤT KHO)';
            bannerTitle.style.color = '#1e40af';

            const userStr = currentOrder.packedBy ? `bởi ${currentOrder.packedBy}` : '';
            const timeStr = currentOrder.packedDate ? `lúc ${new Date(currentOrder.packedDate * 1000).toLocaleString('vi-VN')}` : '';
            bannerDesc.textContent = `Đơn này đã được đóng gói xong ${userStr} ${timeStr}. Dưới đây là các serial đã soạn vào đơn.`.trim();
            bannerDesc.style.color = '#1e40af';

            scannerGroup.style.display = 'none';
            actionFooter.innerHTML = `
                <button class="qe-btn-primary" style="background: #64748b; height: 48px; padding: 0 20px; font-size: 15px;" onclick="resetForNewOrder()">
                    🔄 Quét đơn khác
