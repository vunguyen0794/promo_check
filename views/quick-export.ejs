    function saveManualToken() {
        const t = document.getElementById('txtManualToken').value.trim();
        if (!t) return alert('Vui lòng nhập chuỗi token!');
        tekoToken = t;
        localStorage.setItem('qe_teko_token', tekoToken);
        fetch('/api/quick-export/sync-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: t, userId: window.pvUserId || '', branchCode: window.pvBranchCode || '' })
        });
        updateConfigBadges();
        closeTokenModal();
        hideGate(); // Mở khóa gate screen nếu đang hiển thị
        addLog('Đã lưu Token cá nhân thành công!', 'success');
    }

