<div id="erpGateScreen" style="display:none; position:fixed; inset:0; z-index:9990; background:rgba(15,23,42,0.92); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); align-items:center; justify-content:center; flex-direction:column; font-family:'Be Vietnam Pro','Inter',sans-serif;">
    <div style="background:#fff; border-radius:20px; padding:36px 32px; max-width:480px; width:92%; text-align:center; box-shadow:0 25px 60px rgba(0,0,0,0.35); border:1px solid #e2e8f0;">
        <div style="width:60px;height:60px;background:#eff6ff;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:26px;">🔐</div>
        <h2 style="font-size:20px;font-weight:800;color:#0f172a;margin:0 0 8px;">Chưa kết nối ERP</h2>
        <p style="font-size:13.5px;color:#475569;margin:0 0 18px;line-height:1.6;">Để sử dụng <strong>Xuất kho nhanh</strong>, bạn cần đăng nhập ERP Phong Vũ. Extension sẽ tự động đồng bộ kết nối.</p>
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 14px;margin-bottom:18px;text-align:left;font-size:12.5px;color:#166534;line-height:1.7;">
            <div style="font-weight:700;margin-bottom:4px;color:#15803d;">⚡ Hướng dẫn 2 bước:</div>
            <div>1️⃣ Bấm "<strong>Mở ERP &amp; Đăng nhập</strong>" bên dưới</div>
            <div>2️⃣ Đăng nhập ERP &rarr; Extension tự đồng bộ &rarr; Trang tự động mở khóa 🔓</div>
        </div>
        <div id="gatePollingStatus" style="margin-bottom:14px;font-size:13px;color:#64748b;min-height:20px;"></div>
        <div style="display:flex;flex-direction:column;gap:10px;">
            <a id="btnOpenErpLogin" href="https://erp.phongvu.vn" target="_blank" onclick="startGatePolling()" style="display:block;padding:13px 20px;background:linear-gradient(135deg,#1d4ed8,#2563eb);color:#fff;border-radius:10px;font-size:14.5px;font-weight:700;text-decoration:none;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                🔑 Mở ERP &amp; Đăng nhập
            </a>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                <a href="/phongvu-erp-sync.zip" download="phongvu-erp-sync.zip" style="display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:11px 10px;background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;font-size:12.5px;font-weight:700;color:#166534;text-decoration:none;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#f0fdf4'">
                    <span>⬇️</span> Tải Extension (.zip)
                </a>
                <button type="button" onclick="openTokenModal(true)" style="padding:11px 10px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:10px;font-size:12.5px;font-weight:600;color:#334155;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f8fafc'">
                    ✍️ Nhập thủ công
                </button>
            </div>
            <a href="javascript:void(0)" onclick="showExtensionGuide()" style="font-size:12px;color:#2563eb;text-decoration:underline;margin-top:4px;font-weight:600;">
                📦 Xem hướng dẫn cài Extension (15 giây)
            </a>
        </div>
    </div>
</div>

<script>
    // --- Inject session info từ server ---
    window.pvUserId = '<%= user && user.id ? user.id : "" %>';
    window.pvBranchCode = '<%= user && user.branch_code ? user.branch_code : "" %>';
    window.pvUserEmail = '<%= user && user.email ? user.email : "" %>';

    // Gán vào dataset để extension đọc được qua DOM
    try {
        document.documentElement.dataset.pvUserId = window.pvUserId;
        document.documentElement.dataset.pvUserEmail = window.pvUserEmail;
        document.documentElement.dataset.pvBranchCode = window.pvBranchCode;
        window.dispatchEvent(new CustomEvent('pv-user-info', {
            detail: { userId: window.pvUserId, email: window.pvUserEmail, branchCode: window.pvBranchCode, origin: window.location.origin }
        }));
    } catch(e) {}

    // --- STATE ---
    let currentOrder = null;
    let pickingBin = {
        name: localStorage.getItem('qe_picking_bin_name') || '',
        id: localStorage.getItem('qe_picking_bin_id') || ''
    };
    // Validate token từ localStorage ngay khi init - không trust nếu JWT hết hạn
    (function() {
        const cached = localStorage.getItem('qe_teko_token') || '';
        if (cached) {
            try {
                const parts = cached.split('.');
                if (parts.length >= 2) {
                    const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
                    const exp = payload.exp ? Number(payload.exp) : null;
                    if (exp && exp * 1000 < Date.now()) {
                        // JWT đã hết hạn -> clear luôn
                        localStorage.removeItem('qe_teko_token');
                    }
                }
            } catch(e) {
                // Token dị dạng -> clear
                localStorage.removeItem('qe_teko_token');
            }
        }
    })();
    let tekoToken = localStorage.getItem('qe_teko_token') || '';
    let _gatePollingTimer = null;
    let _gatePollingCount = 0;
    let scannedSerials = {}; // { [sku]: ['SN1'] }
    let nonSerialQuantities = {}; // { [sku]: number } cho hàng quản lý none
    let nonSerialBins = {};      // { [sku]: { binId, binName, quantity } } BIN đã chọn để lấy hàng
    let serialBinMap = {};   // { [serial]: binId }
    let serialBinNames = {}; // { [serial]: binName }
    let serialFifoMap = {};  // { [serial]: { pass, rank, diffDays, message } }

    // ==========================================
    // ERP GATE SCREEN FUNCTIONS
    // ==========================================
    function showGate(reason) {
        const gate = document.getElementById('erpGateScreen');
        if (!gate) return;
        gate.style.display = 'flex';
        const statusEl = document.getElementById('gatePollingStatus');
        if (statusEl) statusEl.textContent = reason || '';
    }

    function hideGate() {
        const gate = document.getElementById('erpGateScreen');
        if (!gate) return;
        gate.style.display = 'none';
        if (_gatePollingTimer) { clearInterval(_gatePollingTimer); _gatePollingTimer = null; }
        _gatePollingCount = 0;
    }

    function getJwtInfo(token) {
        if (!token) return null;
        try {
            const clean = String(token).replace(/^Bearer\s+/i, '').trim();
            const parts = clean.split('.');
            if (parts.length < 2) return null;
            const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
            const expSec = payload.exp ? Number(payload.exp) : null;
            const isExpired = expSec ? (expSec * 1000 < Date.now()) : false;
            return {
                expSec,
                isExpired,
                expiresDate: expSec ? new Date(expSec * 1000) : null,
                email: payload.email || payload.sub || payload.name || '',
                name: payload.name || ''
            };
        } catch (e) {
            return null;
        }
    }

    function startGatePolling() {
        if (_gatePollingTimer) return;
        _gatePollingCount = 0;
        const statusEl = document.getElementById('gatePollingStatus');
        const btnAuto = document.getElementById('btnModalAutoLogin');
        const modalStatusEl = document.getElementById('modalSyncStatus');

        if (statusEl) statusEl.textContent = 'Dang cho dong bo token tu ERP...';

        _gatePollingTimer = setInterval(async () => {
            _gatePollingCount++;
            if (_gatePollingCount > 150) {
                clearInterval(_gatePollingTimer); _gatePollingTimer = null;
                if (statusEl) statusEl.textContent = 'Het gio cho. Thu lai hoac dung Bookmarklet.';
                const s2t = document.getElementById('step2Icon');
                const s3t = document.getElementById('step3Icon');
                const s3TxtT = document.getElementById('step3Txt');
                if (s2t) s2t.innerHTML = '&#10060;';
                if (s3t) s3t.innerHTML = '&#10060;';
                if (s3TxtT) s3TxtT.textContent = 'Het thoi gian!';
                if (btnAuto) {
                    btnAuto.disabled = false;
                    btnAuto.innerHTML = '&#128640; Mo ERP &amp; Ket noi Token';
                    btnAuto.style.background = '';
                    btnAuto.style.borderColor = '';
                    btnAuto.style.opacity = '1';
                }
                return;
            }
            try {
                const res = await fetch('/api/quick-export/settings');
                const data = await res.json();
                if (data && data.success && data.settings && data.settings.tekoToken) {
                    const jwt = getJwtInfo(data.settings.tekoToken);
                    if (jwt && !jwt.isExpired) {
                        clearInterval(_gatePollingTimer);
                        _gatePollingTimer = null;
                        tekoToken = data.settings.tekoToken;
                        localStorage.setItem('qe_teko_token', tekoToken);
                        playBeep('success');
                        const s2ok = document.getElementById('step2Icon');
                        const s3ok = document.getElementById('step3Icon');
                        const s3TxtEl = document.getElementById('step3Txt');
                        if (s2ok) s2ok.innerHTML = '&#9745;';
                        if (s3ok) s3ok.innerHTML = '&#9745;';
                        if (s3TxtEl) s3TxtEl.textContent = 'Token da ve server!';
                        if (statusEl) statusEl.textContent = 'Ket noi ERP thanh cong!';
                        if (btnAuto) {
                            btnAuto.innerHTML = 'KET NOI THANH CONG!';
                            btnAuto.style.background = '#16a34a';
                        }
                        if (modalStatusEl) {
                            modalStatusEl.style.display = 'block';
                            modalStatusEl.innerHTML = '<div style="background:#dcfce7;color:#166534;font-weight:700;padding:10px 14px;border-radius:8px;text-align:center;">Da nhan Token ERP! Dang vao...</div>';
                        }
                        setTimeout(() => {
                            const cl = document.getElementById('tokenStepChecklist');
                            if (cl) cl.style.display = 'none';
                            if (modalStatusEl) modalStatusEl.style.display = 'none';
                            closeTokenModal();
                            hideGate();
                            updateConfigBadges();
                            addLog('Token ERP da dong bo thanh cong!', 'success');
                            if (btnAuto) {
                                btnAuto.disabled = false;
                                btnAuto.innerHTML = '&#128640; Mo ERP &amp; Tu dong ket noi Token';
                                btnAuto.style.background = '';
                                btnAuto.style.opacity = '1';
                            }
                        }, 1200);
                        return;
                    }
                }
                if (_gatePollingCount === 4) {
                    const s2s = document.getElementById('step2Icon');
                    if (s2s && s2s.innerHTML.includes('9744')) s2s.innerHTML = '&#9203;';
                }
                if (_gatePollingCount % 4 === 0) {
                    const d = '.'.repeat((_gatePollingCount/4)%4+1);
                    if (statusEl) statusEl.textContent = 'Dang cho' + d + '...';
                }
            } catch (e) {}
        }, 1500);
    }


    // Gọi khi Teko API trả 401/403 → invalidate token và show gate
    function handleErpAuthError(msg) {
        console.warn('[QE] ERP Auth Error:', msg);
        tekoToken = '';
        localStorage.removeItem('qe_teko_token');
        // Xóa token trên server
        fetch('/api/quick-export/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tekoToken: '', pickingBinName: pickingBin.name, pickingBinId: pickingBin.id })
        }).catch(() => {});
        updateConfigBadges();
        showGate('⚠️ Token ERP đã hết hạn. Vui lòng đăng nhập lại để tiếp tục.');
    }

    // Wrap fetch calls - detect 401 từ Teko và trigger gate
    function isErpAuthError(data) {
        if (!data) return false;
        const msg = (data.message || data.error || '').toLowerCase();
        return msg.includes('401') || msg.includes('403') || msg.includes('unauthorized') || msg.includes('unauthenticated') || msg.includes('token') && (msg.includes('invalid') || msg.includes('expired') || msg.includes('hết hạn'));
    }

    // ==========================================
    function playBeep(type = 'success') {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (type === 'success') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                osc.frequency.setValueAtTime(880.00, ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.22);
                osc.start();
                osc.stop(ctx.currentTime + 0.22);
            } else if (type === 'fifo-warn') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(440, ctx.currentTime);
                osc.frequency.setValueAtTime(349.23, ctx.currentTime + 0.12);
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                osc.start();
                osc.stop(ctx.currentTime + 0.3);
            } else if (type === 'error') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, ctx.currentTime);
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.28);
                osc.start();
                osc.stop(ctx.currentTime + 0.28);
            }
        } catch (e) {}
    }

    function addLog(msg, type = 'info') {
        const stream = document.getElementById('logStream');
        if (!stream) return;
        const p = document.createElement('p');
        const time = new Date().toLocaleTimeString('vi-VN');
        let color = '#38bdf8';
        if (type === 'success') color = '#4ade80';
        if (type === 'warn') color = '#fbbf24';
        if (type === 'error') color = '#f87171';

        p.innerHTML = `<span style="color: #64748b;">[${time}]</span> <span style="color: ${color};">${msg}</span>`;
        stream.appendChild(p);
        stream.scrollTop = stream.scrollHeight;
    }

    // --- STATUS BADGES ---
    function updateConfigBadges() {
        const dotBin = document.getElementById('dotBin');
        const lblBin = document.getElementById('lblPickingBin');
        const dotToken = document.getElementById('dotToken');
        const lblToken = document.getElementById('lblTokenStatus');

        if (pickingBin.name && pickingBin.id) {
            dotBin.classList.add('active');
            lblBin.textContent = pickingBin.name;
        } else if (pickingBin.name) {
            dotBin.classList.add('active');
            lblBin.textContent = pickingBin.name;
        } else {
            dotBin.classList.remove('active');
            lblBin.textContent = 'Chưa gán';
        }

        const jwt = getJwtInfo(tekoToken);
        if (tekoToken && jwt && !jwt.isExpired) {
            dotToken.classList.add('active');
            dotToken.style.background = '#22c55e';
            const expTime = jwt.expiresDate ? jwt.expiresDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '';
            lblToken.innerHTML = `ERP đã kết nối <span style="font-size:11px;font-weight:400;color:#16a34a;">(Hạn: ${expTime})</span>`;
            lblToken.style.color = 'var(--qe-green-primary)';
            lblToken.style.fontWeight = '700';
        } else if (tekoToken && jwt && jwt.isExpired) {
            dotToken.classList.remove('active');
            dotToken.style.background = '#ef4444';
            lblToken.textContent = '⚠️ Token ERP hết hạn';
            lblToken.style.color = '#dc2626';
            lblToken.style.fontWeight = '700';
            tekoToken = '';
            localStorage.removeItem('qe_teko_token');
        } else {
            dotToken.classList.remove('active');
            dotToken.style.background = '#94a3b8';
            lblToken.textContent = 'Chưa kết nối ERP';
            lblToken.style.color = 'var(--qe-red-primary)';
            lblToken.style.fontWeight = '600';
        }
    }

    // --- EXTENSION GUIDE MODAL ---
    function showExtensionGuide() {
        document.getElementById('extensionGuideModal').style.display = 'flex';
    }

    function closeExtensionGuideModal() {
        document.getElementById('extensionGuideModal').style.display = 'none';
    }

    // --- TOKEN MODAL & BOOKMARKLET ---
    function getBookmarkletCode() {
        const host = window.location.origin;
        return `javascript:(function(){function f(){try{if(window.TekoID&&window.TekoID.user&&typeof window.TekoID.user.getAccessToken==='function'){var t=window.TekoID.user.getAccessToken();if(t&&t.length>30)return Promise.resolve(t);}}catch(e){}try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);var v=localStorage.getItem(k)||'';if(v.startsWith('eyJ')&&v.length>40)return Promise.resolve(v);try{var p=JSON.parse(v);if(p){var tok=p.access_token||p.accessToken||p.id_token||(p.currentUser&&(p.currentUser.access_token||p.currentUser.accessToken));if(tok&&tok.length>30)return Promise.resolve(tok);}}catch(e){}}}catch(e){}try{for(var j=0;j<sessionStorage.length;j++){var sk=sessionStorage.key(j);var sv=sessionStorage.getItem(sk)||'';if(sv.startsWith('eyJ')&&sv.length>40)return Promise.resolve(sv);try{var sp=JSON.parse(sv);if(sp){var stok=sp.access_token||sp.accessToken||sp.id_token;if(stok&&stok.length>30)return Promise.resolve(stok);}}catch(e){}}}catch(e){}return new Promise(function(res){try{var req=indexedDB.open('ERPAdminLocalDB');req.onsuccess=function(e){try{var db=e.target.result;if(!db||!db.objectStoreNames||!db.objectStoreNames.contains('currentUser')){return res(null);}var tx=db.transaction('currentUser','readonly');var st=tx.objectStore('currentUser');var getReq=st.getAll();getReq.onsuccess=function(ev){var r=ev.target.result;var u=r&&r[0];var tok=u&&(u.accessToken||u.access_token||u.token);res(tok||null);};getReq.onerror=function(){res(null);};}catch(err){res(null);}};req.onerror=function(){res(null);};}catch(err){res(null);}});}f().then(function(tok){if(!tok){alert('❌ Không tìm thấy Token ERP trên trang này!\\n\\n👉 Hãy đăng nhập tại https://erp.phongvu.vn rồi bấm lại bookmark này nhé.');return;}var cl=tok.startsWith('Bearer ')?tok.slice(7).trim():tok.trim();var h='${host}';var cp=false;try{var ta=document.createElement('textarea');ta.value=cl;ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.focus();ta.select();cp=document.execCommand('copy');document.body.removeChild(ta);}catch(e){}if(!cp&&navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(cl).then(function(){cp=true;}).catch(function(){});}try{fetch(h+'/api/quick-export/sync-token',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:cl,userId:'${window.pvUserId||""}',branchCode:'${window.pvBranchCode||""}'}),mode:'no-cors'}).catch(function(){});new Image().src=h+'/api/quick-export/sync-token?token='+encodeURIComponent(cl)+'&userId='+encodeURIComponent('${window.pvUserId||""}')+'&branchCode='+encodeURIComponent('${window.pvBranchCode||""}');}catch(e){}var old=document.getElementById('pv-token-banner');if(old)old.remove();var b=document.createElement('div');b.id='pv-token-banner';b.style.cssText='position:fixed;top:24px;right:24px;z-index:99999999;background:#ffffff;border:2px solid #2563eb;border-radius:12px;padding:16px 20px;box-shadow:0 12px 35px rgba(0,0,0,0.3);font-family:-apple-system,BlinkMacSystemFont,sans-serif;max-width:380px;color:#0f172a;';b.innerHTML='<div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;\"><span style=\"font-weight:800;font-size:14px;color:#1e40af;\">⚡ ĐỒNG BỘ TOKEN ERP</span><button id=\"pv-close-bn\" style=\"border:none;background:none;font-size:18px;cursor:pointer;color:#64748b;\">&times;</button></div><div style=\"background:#dcfce7;border:1px solid #bbf7d0;color:#166534;font-size:12px;padding:8px 10px;border-radius:6px;font-weight:600;margin-bottom:12px;\">'+(cp?'✅ Đã tự động copy Token vào bộ nhớ tạm!':'✅ Đã lấy được mã Token ERP!')+'</div><div style=\"display:flex;gap:8px;\"><button id=\"pv-copy-btn\" style=\"flex:1;background:#2563eb;color:#fff;border:none;padding:9px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;\">📋 Copy Token</button><a href=\"'+h+'/quick-export?token='+encodeURIComponent(cl)+'\" target=\"_blank\" style=\"flex:1.2;background:#10b981;color:#fff;text-decoration:none;padding:9px;border-radius:6px;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;\">🚀 Mở Xuất Kho</a></div>';document.body.appendChild(b);document.getElementById('pv-close-bn').onclick=function(){b.remove();};document.getElementById('pv-copy-btn').onclick=function(){if(navigator.clipboard){navigator.clipboard.writeText(cl).then(function(){alert('✅ Đã copy Token ERP vào Clipboard!');});}else{var t2=document.createElement('textarea');t2.value=cl;document.body.appendChild(t2);t2.select();document.execCommand('copy');document.body.removeChild(t2);alert('✅ Đã copy Token ERP vào Clipboard!');}};});})();`.replace(/\s+/g, ' ').trim();
