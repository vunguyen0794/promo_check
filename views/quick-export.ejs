    async function loadAdminTokensList() {
        const tbody = document.getElementById('tblAdminTokensBody');
        const countLbl = document.getElementById('lblAdminTokensCount');
        if (!tbody) return;
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 24px; color: #94a3b8;">Đang tải danh sách token...</td></tr>`;

        try {
            const res = await fetch('/api/quick-export/admin/tokens');
            const data = await res.json();
            if (!data.success) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 20px; color: #dc2626;">Lỗi: ${data.message}</td></tr>`;
                return;
            }

            const tokens = data.tokens || [];
            if (countLbl) countLbl.textContent = tokens.length;

            if (tokens.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 24px; color: #94a3b8;">Chưa có token nào được lưu trong hệ thống.</td></tr>`;
                return;
            }

            tbody.innerHTML = tokens.map(t => {
                const isExpired = t.isExpired;
                const expDateStr = t.expiresAt ? new Date(t.expiresAt).toLocaleString('vi-VN') : 'Không xác định';
                const updDateStr = t.updatedAt ? new Date(t.updatedAt).toLocaleString('vi-VN') : '-';

                let typeBadge = '';
                if (t.type === 'global') {
                    typeBadge = `<span style="background: #e0e7ff; color: #3730a3; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">HỆ THỐNG</span>`;
                } else if (t.type === 'branch') {
                    typeBadge = `<span style="background: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">CHI NHÁNH</span>`;
                } else {
                    typeBadge = `<span style="background: #dcfce7; color: #166534; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">CÁ NHÂN</span>`;
                }

                const statusBadge = isExpired
                    ? `<span style="background: #fee2e2; color: #dc2626; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">⚠️ ĐÃ HẾT HẠN</span>`
                    : `<span style="background: #dcfce7; color: #166534; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;">✓ CÒN HẠN</span>`;

                return `
                    <tr>
                        <td>
                            <div style="font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 6px;">
                                ${typeBadge}
                                <span>${t.userName || t.title}</span>
                            </div>
                            ${t.userEmail ? `<div style="font-size: 12px; color: #64748b; margin-top: 2px;">${t.userEmail}</div>` : ''}
                            ${t.jwtSubject ? `<div style="font-size: 11px; color: #94a3b8; font-family: monospace;">ERP Subject: ${t.jwtSubject}</div>` : ''}
                        </td>
                        <td style="text-align: center; font-weight: 700; color: #2563eb;">
                            ${t.branchCode || '-'}
                        </td>
                        <td>
                            <code style="font-size: 11px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; color: #0f172a;">${t.tokenMasked}</code>
                        </td>
                        <td style="text-align: center; font-size: 12px;">
                            ${statusBadge}
                            <div style="font-size: 11px; color: #64748b; margin-top: 3px;">${expDateStr}</div>
                        </td>
                        <td style="text-align: center; font-size: 12px; color: #64748b;">
                            ${updDateStr}
                        </td>
                        <td style="text-align: center;">
                            <button type="button" 
                                    class="btn-header-action" 
                                    style="height: 28px; padding: 0 10px; font-size: 11px; background: #fee2e2; color: #dc2626; border-color: #fca5a5; font-weight: 700;"
                                    onclick="deleteAdminToken('${t.key}', '${t.userName || t.userEmail || t.title}')">
                                🗑️ Xoá
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 20px; color: #dc2626;">Lỗi tải dữ liệu: ${err.message}</td></tr>`;
        }
    }

    async function deleteAdminToken(key, name) {
        if (!confirm(`Bạn có chắc chắn muốn xoá Token của [${name}]?\n\nSau khi xoá, người này sẽ bị khóa xuất kho và phải đăng nhập ERP để cấp lại token.`)) return;

        try {
            const res = await fetch(`/api/quick-export/admin/tokens/${encodeURIComponent(key)}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message);
                loadAdminTokensList();
            } else {
                alert('Lỗi: ' + data.message);
            }
        } catch (e) {
            alert('Lỗi kết nối: ' + e.message);
        }
    }

    async function purgeAllAdminTokens() {
        if (!confirm('CẢNH BÁO NGUY HIỂM:\n\nBạn có chắc chắn muốn XOÁ SẠCH TOÀN BỘ Token ERP trong hệ thống?\n\nTất cả nhân viên ở tất cả các chi nhánh sẽ bị yêu cầu đăng nhập lại ERP từ đầu.')) return;

        try {
            const res = await fetch('/api/quick-export/admin/tokens/purge-all', {
                method: 'POST'
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message);
                loadAdminTokensList();
            } else {
                alert('Lỗi: ' + data.message);
            }
        } catch (e) {
            alert('Lỗi kết nối: ' + e.message);
        }
    }

    // --- CONFIG MODAL ---
    async function loadSitesDropdown(selectedSiteId) {
        const select = document.getElementById('cfgSiteId');
        if (!select) return;
        try {
            const res = await fetch('/api/quick-export/sites');
            const data = await res.json();
            if (data.success && Array.isArray(data.sites) && data.sites.length > 0) {
                select.innerHTML = '<option value="">-- Chọn kho / chi nhánh làm việc --</option>';
                data.sites.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = `[ID: ${s.id}] ${s.name}`;
                    select.appendChild(opt);
                });
                if (data.sites.length === 1) {
                    select.value = data.sites[0].id;
                    localStorage.setItem('qe_site_id', data.sites[0].id);
                } else {
                    const target = selectedSiteId || currentOrder?.siteId || localStorage.getItem('qe_site_id');
                    if (target) select.value = target;
                }
            }
        } catch (e) {}
    }

