                    📦 Xác nhận soạn hàng
                </button>
                <button class="qe-btn-primary qe-btn-success" 
                        id="btnFinishExport" 
                        onclick="handleConfirmExport(true)" 
                        disabled 
                        style="height: 48px; padding: 0 24px; font-size: 15px;">
                    ✅ Xác nhận & Hoàn tất xuất kho
