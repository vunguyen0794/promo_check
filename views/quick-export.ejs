    function copyBookmarkletCode() {
        const code = getBookmarkletCode();
        if (navigator.clipboard) {
            navigator.clipboard.writeText(code).then(() => {
                alert('✓ Đã copy mã Bookmarklet! Bạn có thể tạo Dấu trang mới trên trình duyệt và dán mã này vào.');
            }).catch(() => {
                prompt('Mã Bookmarklet (nhấn Ctrl+C để copy):', code);
            });
        } else {
            prompt('Mã Bookmarklet (nhấn Ctrl+C để copy):', code);
        }
    }

