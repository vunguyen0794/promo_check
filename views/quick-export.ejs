            let totalQty = 0;
            let html = `
                <table class="sku-table" style="margin-top: 0; width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 22%;">Vị trí BIN</th>
                            <th style="width: 22%;">Khu vực kho</th>
                            <th style="width: 26%;">Phân loại hàng</th>
                            <th style="width: 14%; text-align: center;">Tồn kho</th>
                            ${isNoneTrackingSku ? '<th style="width: 16%; text-align: center;">Thao tác</th>' : ''}
                        </tr>
                    </thead>
                    <tbody>
            `;

            stocks.forEach(s => {
                totalQty += s.quantity;
                const isSoanHang = (s.zoneName || '').includes('Soạn') || (s.binName || '').startsWith('SH-');
                const isSelected = nonSerialBins[currentStockSku]?.binName === s.binName;
                const rowStyle = isSelected ? 'background: #f0fdf4; outline: 2px solid #86efac; outline-offset: -2px;' : (isSoanHang ? 'background: #eff6ff;' : '');
                const canSelect = s.quantity > 0;
                html += `
                    <tr style="${rowStyle}">
                        <td>
                            <strong style="color: var(--qe-blue-primary); font-size: 13px; font-variant-numeric: tabular-nums;">${s.binName}</strong>
                            ${isSelected ? '<span style="font-size: 10px; background: #dcfce7; color: #15803d; padding: 1px 5px; border-radius: 3px; margin-left: 4px; font-weight: 700;">✓ Đang chọn</span>' : (isSoanHang ? '<span style="font-size: 10px; background: #dbeafe; color: #1e40af; padding: 1px 5px; border-radius: 3px; margin-left: 4px; font-weight: 700;">Soạn hàng</span>' : '')}
                        </td>
                        <td>
                            <span style="font-weight: 600; color: var(--qe-text-main); font-size: 13px;">${s.zoneName}</span>
                        </td>
                        <td>
                            <span style="font-size: 12px; color: #64748b;">${s.productStatusTypeName}</span>
                        </td>
                        <td style="text-align: center;">
                            <span style="font-weight: 800; font-size: 15px; font-variant-numeric: tabular-nums; color: ${s.quantity > 0 ? 'var(--qe-green-primary)' : '#94a3b8'};">
                                ${new Intl.NumberFormat('vi-VN').format(s.quantity)}
                            </span>
                            <span style="font-size: 11px; color: #64748b; margin-left: 2px;">${s.uom}</span>
                        </td>
                        ${isNoneTrackingSku ? `
                        <td style="text-align: center;">
                            ${isSelected
                                ? `<span style="color:#15803d;font-size:12px;font-weight:700;">✓ Đã chọn</span>`
                                : (canSelect
                                    ? `<button type="button" onclick="selectBinForNonSerial('${currentStockSku}', '${s.binName}', '', ${s.quantity})" 
                                               style="background:#eff6ff;color:#1d4ed8;border:1px solid #93c5fd;border-radius:5px;padding:3px 10px;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;"
                                               onmouseover="this.style.background='#dbeafe'" onmouseout="this.style.background='#eff6ff'">
                                           Chọn BIN này
                                       </button>`
                                    : `<span style="color:#94a3b8;font-size:12px;">Hết hàng</span>`)
                            }
                        </td>
                        ` : ''}
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            modalBody.innerHTML = html;
            totalLabel.innerHTML = `Tổng tồn kho tại chi nhánh: <span style="color: var(--qe-green-primary); font-weight: 800; font-size: 15px; font-variant-numeric: tabular-nums;">${new Intl.NumberFormat('vi-VN').format(totalQty)}</span> Cái`;

        } catch (err) {
            modalBody.innerHTML = `
                <div style="text-align: center; padding: 30px; color: #dc2626;">
                    ⚠️ Lỗi tải dữ liệu tồn kho: ${err.message}
                </div>
            `;
            totalLabel.textContent = 'Lỗi tra cứu';
        }
    }

    function closeStockByBinModal() {
        const modal = document.getElementById('stockByBinModal');
        if (modal) modal.style.display = 'none';
    }

    function selectBinForNonSerial(sku, binName, binId, quantity) {
        nonSerialBins[sku] = { binName, binId, quantity };
        addLog(`Đã chọn BIN <strong>${binName}</strong> (tồn: ${quantity}) để lấy hàng cho SKU ${sku}.`, 'success');
        closeStockByBinModal();
        renderSkuTable();
    }

    function clearNonSerialBin(sku) {
        delete nonSerialBins[sku];
        renderSkuTable();
    }

    let isProcessingFifoSelect = false;

    async function selectFifoSerial(btn, sku, serial) {
        if (!btn || isProcessingFifoSelect) return;
        isProcessingFifoSelect = true;

        const originalText = btn.innerHTML;
        const originalBg = btn.style.background;

        btn.disabled = true;
        btn.style.opacity = '0.85';
        btn.style.cursor = 'wait';
        btn.innerHTML = `<span style="display:inline-block;width:12px;height:12px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:qeSpin 0.6s linear infinite;vertical-align:middle;margin-right:4px;"></span> Đang nhận...`;

        // Vô hiệu hoá tạm thời tất cả các nút chọn khác trong modal để chống bấm đúp
        const otherBtns = document.querySelectorAll('.btn-fifo-select');
        otherBtns.forEach(b => { if (b !== btn) b.disabled = true; });

        try {
            await executeScanSerial(serial);

            // Đổi trạng thái nút thành công
            btn.innerHTML = '✓ Đã nhận';
            btn.style.background = '#10b981';
            btn.style.borderColor = '#059669';
            btn.style.cursor = 'default';
            btn.classList.add('btn-fifo-done');

            // Cập nhật lại nội dung modal sau một chút để user thấy phản hồi trực quan
            setTimeout(() => {
                renderFifoModalContent(currentFifoTabSku);
            }, 500);

        } catch (err) {
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
            btn.innerHTML = originalText;
            btn.style.background = originalBg;
            playBeep('error');
            addLog(`Lỗi chọn serial "${serial}": ${err.message}`, 'error');
            alert(`Lỗi nhận serial: ${err.message}`);
        } finally {
            isProcessingFifoSelect = false;
            const remainingBtns = document.querySelectorAll('.btn-fifo-select');
            remainingBtns.forEach(b => {
                if (!b.classList.contains('btn-fifo-done')) b.disabled = false;
            });
        }
    }

    // --- KHỞI TẠO & LẮNG NGHE ENTER ---
    document.addEventListener('DOMContentLoaded', async () => {
        // Khởi tạo link bookmarklet với origin hiện tại
        initBookmarklet();

        // Tự động nhận token nếu được truyền qua URL (?token=...)
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const paramToken = urlParams.get('token');
            if (paramToken && paramToken.trim().length > 30) {
                tekoToken = paramToken.trim().replace(/^Bearer\s+/i, '');
                localStorage.setItem('qe_teko_token', tekoToken);
                fetch('/api/quick-export/sync-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: tekoToken })
                }).catch(() => {});
                window.history.replaceState({}, document.title, window.location.pathname);
                addLog('🎉 Đã tự động kết nối Token ERP thành công từ liên kết!', 'success');
            }
        } catch (e) {}

        updateConfigBadges();

        // Tải cài đặt từ server - server là source of truth
        try {
            const res = await fetch('/api/quick-export/settings');
            const data = await res.json();
            if (data && data.success && data.settings) {
                // Server không có token -> clear localStorage stale
                if (!data.settings.hasToken || !data.settings.tekoToken) {
                    tekoToken = '';
                    localStorage.removeItem('qe_teko_token');
                } else {
                    // Server có token -> validate JWT expiry
                    const jwt = getJwtInfo(data.settings.tekoToken);
                    if (jwt && !jwt.isExpired) {
                        tekoToken = data.settings.tekoToken;
                        localStorage.setItem('qe_teko_token', tekoToken);
                    } else {
                        // Token trên server cũng hết hạn -> clear hết
                        tekoToken = '';
                        localStorage.removeItem('qe_teko_token');
                    }
                }
                if (data.settings.pickingBinName && !pickingBin.name) {
                    pickingBin.name = data.settings.pickingBinName;
                    pickingBin.id = data.settings.pickingBinId;
                    localStorage.setItem('qe_picking_bin_name', pickingBin.name);
                    if (pickingBin.id) localStorage.setItem('qe_picking_bin_id', pickingBin.id);
                }
                updateConfigBadges();
            }
        } catch (e) {}

        // === GATE CHECK: Nếu không có token sau khi load settings → hiện Gate Screen ===
        if (!tekoToken) {
            showGate('');
        }

        const docInputEl = document.getElementById('txtDocumentId');
        if (docInputEl) {
            docInputEl.addEventListener('paste', function(e) {
                const text = (e.clipboardData || window.clipboardData)?.getData('text');
                if (text) {
                    const clean = text.trim();
                    this.value = clean;
                    setTimeout(() => {
                        handleSearchOrder(clean);
                    }, 50);
                }
            });
            docInputEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleSearchOrder();
                }
            });
        }

        const serialInputEl = document.getElementById('txtSerialScan');
        if (serialInputEl) {
            serialInputEl.addEventListener('paste', function(e) {
                const text = (e.clipboardData || window.clipboardData)?.getData('text');
                if (text) {
                    const clean = text.trim();
                    this.value = clean;
                    setTimeout(() => {
                        handleScanSerialSubmit();
                    }, 50);
                }
            });
            serialInputEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleScanSerialSubmit();
                }
            });
        }
    });
</script>

