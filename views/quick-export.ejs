    async function verifyPickingBin() {
        const binName = document.getElementById('cfgBinName').value.trim();
        const siteId = document.getElementById('cfgSiteId')?.value || currentOrder?.siteId || '';
        const statusEl = document.getElementById('cfgBinStatus');
        if (!binName) {
            statusEl.style.color = 'var(--qe-red-primary)';
            statusEl.textContent = 'Vui lòng nhập tên BIN!';
            return;
        }

        statusEl.style.color = 'var(--qe-blue-primary)';
        statusEl.textContent = 'Đang kiểm tra trên ERP...';

        try {
            const res = await fetch('/api/quick-export/verify-bin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ binName, siteId, token: tekoToken })
            });
            const data = await res.json();
            if (data.success && data.bin) {
                statusEl.style.color = 'var(--qe-green-primary)';
                statusEl.textContent = `✅ BIN hợp lệ! (ID hệ thống: ${data.bin.binId})`;
                pickingBin.id = data.bin.binId;
                pickingBin.name = data.bin.binName || binName;
            } else {
                statusEl.style.color = 'var(--qe-red-primary)';
                statusEl.textContent = `❌ ${data.message || 'Không tìm thấy BIN trên ERP'}`;
            }
        } catch (err) {
            statusEl.style.color = 'var(--qe-red-primary)';
            statusEl.textContent = `❌ Lỗi: ${err.message}`;
        }
    }

    async function saveConfig() {
        pickingBin.name = document.getElementById('cfgBinName').value.trim();
        const siteVal = document.getElementById('cfgSiteId')?.value || '';

        localStorage.setItem('qe_picking_bin_name', pickingBin.name);
        if (pickingBin.id) localStorage.setItem('qe_picking_bin_id', pickingBin.id);
        if (siteVal) localStorage.setItem('qe_site_id', siteVal);

        try {
            await fetch('/api/quick-export/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pickingBinName: pickingBin.name,
                    pickingBinId: pickingBin.id,
                    tekoToken
                })
            });
        } catch (e) {}

        updateConfigBadges();
        closeConfigModal();
        addLog('Đã lưu cấu hình BIN soạn hàng.', 'success');
    }

    // --- TÌM ĐƠN HÀNG (Yêu cầu 3: Hiển thị Sale, CPxx, Nơi giao & Fix ảnh 2) ---
    async function handleSearchOrder(customCode = null) {
        const codeInput = document.getElementById('txtDocumentId');
        const code = (typeof customCode === 'string' && customCode.trim()) ? customCode.trim() : codeInput.value.trim();
        if (!code) {
            alert('Vui lòng nhập hoặc quét mã đơn!');
            codeInput.focus();
            return;
        }
        codeInput.value = code;

        if (!tekoToken) {
            showGate('Bạn cần đăng nhập ERP trước khi tra cứu đơn hàng.');
            return;
        }

        const btn = document.getElementById('btnSearchOrder');
        btn.disabled = true;
        btn.textContent = '⏳ Đang tải...';
        addLog(`Đang tìm thông tin đơn hàng "${code}"...`);

        try {
            const res = await fetch(`/api/quick-export/order?code=${encodeURIComponent(code)}&binId=${encodeURIComponent(pickingBin.id || '')}`, {
                headers: { 'x-teko-token': tekoToken }
            });
            const data = await res.json();

            if (!data.success || !data.data) {
                if (isErpAuthError(data)) {
                    handleErpAuthError(data.message || data.error);
                    return;
                }
                throw new Error(data.message || 'Không tìm thấy đơn hàng trên ERP');
            }

            currentOrder = data.data;
            scannedSerials = {};
            nonSerialQuantities = {};
            nonSerialBins = {};
            serialBinMap = {};
            serialBinNames = {};
            serialFifoMap = {};

            const orderSiteId = currentOrder.siteId;
            if (orderSiteId) localStorage.setItem('qe_site_id', orderSiteId);

            // Tự động kiểm tra BIN theo site của đơn nếu chưa có ID
            if (pickingBin.name && orderSiteId && !pickingBin.id) {
                try {
                    const bRes = await fetch('/api/quick-export/verify-bin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ binName: pickingBin.name, siteId: orderSiteId, token: tekoToken })
                    });
                    const bData = await bRes.json();
                    if (bData.success && bData.bin?.binId) {
                        pickingBin.id = bData.bin.binId;
                        localStorage.setItem('qe_picking_bin_id', pickingBin.id);
                        updateConfigBadges();
                    }
                } catch (e) {}
            }

            // NẾU ĐƠN ĐÃ EXPORTED HOẶC PACKED -> TỰ ĐỘNG PREFILL SERIALS ĐÃ SOẠN/XUẤT
            const statusUpper = String(currentOrder.status || '').trim().toUpperCase();
            const isAlreadyHandled = Boolean(currentOrder.isExported || currentOrder.isPacked || statusUpper === 'EXPORTED' || statusUpper === 'PACKED' || statusUpper === 'COMPLETED');
            if (isAlreadyHandled) {
                const defaultLabel = (currentOrder.isPacked || statusUpper === 'PACKED') ? 'Đã đóng gói' : 'Đã xuất kho';
                currentOrder.items.forEach(it => {
                    const skuKey = String(it.sku);
                    const isNone = String(it.tracking || '').trim().toLowerCase() === 'none';
                    if (isNone) {
                        nonSerialQuantities[skuKey] = Number(it.requestQuantity) || 1;
                    } else {
                        const snList = Array.isArray(it.serials) ? it.serials : [];
                        scannedSerials[skuKey] = [...snList];
                        snList.forEach(sn => {
                            serialBinNames[sn] = it.binName || defaultLabel;
                            serialFifoMap[sn] = { pass: true, status: defaultLabel, message: `Serial ${defaultLabel.toLowerCase()}` };
                        });
                    }
                });
            }

            renderOrderDetails();
            playBeep('success');
            addLog(`Tải thành công đơn #${currentOrder.documentId} (Trạng thái: ${currentOrder.status}).`, 'success');

            if (!isAlreadyHandled) {
                setTimeout(() => {
                    const sInput = document.getElementById('txtSerialScan');
                    if (sInput) sInput.focus();
                }, 100);
            }

        } catch (err) {
            playBeep('error');
            addLog(`Lỗi tải đơn hàng: ${err.message}`, 'error');
            alert(`Lỗi: ${err.message}`);
        } finally {
            btn.disabled = false;
            btn.textContent = '🔍 Tìm đơn';
        }
    }

    function renderOrderDetails() {
        document.getElementById('dispDocId').textContent = currentOrder.documentId;
        
        // Chi nhánh bán: chỉ hiển thị branchCode ngắn (VD: CP01)
        const sellBranch = currentOrder.branchCode || '';
        document.getElementById('dispBranchCode').textContent = sellBranch || '-';

        // Kho xuất: siteName đầy đủ (VD: "264A Nguyễn Thị Minh Khai") hoặc exportBranch
        const expEl = document.getElementById('dispExportWarehouse');
        if (expEl) {
            const exportSiteName = currentOrder.siteName || '';
            const exportBranch  = currentOrder.exportBranch || '';
            // Ưu tiên siteName đầy đủ, nếu không có thì dùng exportBranch
            expEl.textContent = exportSiteName || exportBranch || '-';
        }

        // Sale bán
        document.getElementById('dispSaleName').textContent = currentOrder.saleName || 'Điều chuyển / Hệ thống';

        // Người nhận
        const phone = currentOrder.receiverPhone ? ` (${currentOrder.receiverPhone})` : '';
        document.getElementById('dispReceiver').textContent = `${currentOrder.receiverName || '-'}${phone}`;

        // Yêu cầu 3: Hiển thị Địa chỉ giao
        document.getElementById('dispDeliveryAddress').textContent = currentOrder.deliveryAddress || currentOrder.receiverName || 'Nhận tại quầy / Kho xuất';

        // Trạng thái đơn (Nằm ngay dưới Mã đơn hàng theo Yêu cầu 2)
        const statusUpper = String(currentOrder.status || '').trim().toUpperCase();
        const isExported = Boolean(currentOrder.isExported || statusUpper === 'EXPORTED' || statusUpper === 'COMPLETED');
        const isPacked = Boolean(currentOrder.isPacked || statusUpper === 'PACKED');
        const dispStatus = document.getElementById('dispStatus');
        if (isExported) {
            dispStatus.innerHTML = `<span style="background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">✓ ĐÃ XUẤT KHO</span>`;
        } else if (isPacked) {
            dispStatus.innerHTML = `<span style="background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">📦 ĐÃ ĐÓNG GÓI</span>`;
        } else {
            dispStatus.innerHTML = `<span style="background: #eff6ff; color: var(--qe-blue-primary); border: 1px solid #bfdbfe; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">${currentOrder.status || 'READY'}</span>`;
        }

        // Thời gian tạo đơn (Ngày và Giờ)
        const dispCreated = document.getElementById('dispCreatedDate');
        if (dispCreated) {
            const rawDate = currentOrder.createdDate;
            if (rawDate) {
                let d = null;
                if (typeof rawDate === 'number' || /^\d+$/.test(String(rawDate).trim())) {
                    const num = Number(rawDate);
                    d = new Date(num > 1e11 ? num : num * 1000);
                } else {
                    d = new Date(rawDate);
                }
                if (!isNaN(d.getTime())) {
                    const pad = n => String(n).padStart(2, '0');
                    const hours = pad(d.getHours());
                    const mins = pad(d.getMinutes());
                    const secs = pad(d.getSeconds());
                    const day = pad(d.getDate());
                    const month = pad(d.getMonth() + 1);
                    const year = d.getFullYear();
                    dispCreated.innerHTML = `<span style="font-weight: 700; color: #1e293b; font-variant-numeric: tabular-nums;">${hours}:${mins}:${secs}</span> <span style="color: #64748b; font-size: 12px; margin-left: 4px;">${day}/${month}/${year}</span>`;
                } else {
                    dispCreated.textContent = String(rawDate);
                }
            } else {
                dispCreated.textContent = '-';
            }
        }

        // Yêu cầu 4: Thông tin thanh toán (COD là Chưa thanh toán)
        const pStatus = currentOrder.paymentStatus || 'Chưa thanh toán';
        const dispPStatus = document.getElementById('dispPaymentStatus');
        if (pStatus === 'Đã thanh toán') {
            dispPStatus.innerHTML = `<span style="background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">✓ Đã thanh toán</span>`;
        } else if (pStatus === 'Thanh toán 1 phần') {
            dispPStatus.innerHTML = `<span style="background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">⏳ Thanh toán 1 phần</span>`;
        } else {
            dispPStatus.innerHTML = `<span style="background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 12px;">⚠️ Chưa thanh toán</span>`;
        }

        // Yêu cầu 4: Phương thức thanh toán
        document.getElementById('dispPaymentMethod').textContent = currentOrder.paymentMethod || 'Tiền mặt';

        // Yêu cầu 4: Số tiền còn lại (Hiển thị đúng số tiền nợ/cần thu)
        const remain = Number(currentOrder.remainPayment ?? 0);
        const dispRemain = document.getElementById('dispRemainPayment');
        if (remain <= 0 && pStatus === 'Đã thanh toán') {
            dispRemain.innerHTML = `<span style="color: var(--qe-green-primary); font-weight: 700; font-variant-numeric: tabular-nums;">0 đ</span>`;
        } else {
            dispRemain.innerHTML = `<span style="color: #dc2626; font-weight: 800; font-size: 15px; font-variant-numeric: tabular-nums;">${new Intl.NumberFormat('vi-VN').format(remain)} đ</span>`;
        }

        // Yêu cầu 4: Ghi chú đơn hàng (Không tô vàng, phong cách trang nhã)
        const noteBox = document.getElementById('dispOrderNoteBox');
        const noteText = document.getElementById('dispOrderNote');
        const note = currentOrder.orderNote || currentOrder.requestNote || '';
        if (note && note.trim()) {
            noteText.textContent = note.trim();
            noteBox.style.display = 'block';
        } else {
            noteBox.style.display = 'none';
        }

        document.getElementById('orderOverview').style.display = 'block';
        document.getElementById('cardScanning').style.display = 'block';

        // Xử lý giao diện khi đơn đã xuất hoàn tất hoặc đã đóng gói
        const banner = document.getElementById('exportedBanner');
