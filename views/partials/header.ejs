        <script>
            // --- KHAI BÁO HÀM TOÀN CỤC (GLOBAL) ĐỂ HTML GỌI ĐƯỢC ---

            // 1. Hàm mở modal & GỌI API ĐÁNH DẤU ĐÃ ĐỌC
            // --- [UPDATED] XỬ LÝ CLICK: LUÔN HIỆN MODAL + NÚT LINK (NẾU CÓ) ---
            window.handleNotificationClick = async function (element) {
                const id = element.getAttribute('data-id');
                const isRead = element.getAttribute('data-read') === 'true';
                const link = element.getAttribute('data-link'); // Lấy link từ data attribute

                // 1. GỌI API ĐÁNH DẤU ĐÃ ĐỌC (Giữ nguyên logic cũ)
                if (!isRead && id) {
                    try {
                        fetch('/api/notifications/mark-read', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: id })
                        });

                        // Cập nhật UI Badge (ẩn chấm đỏ, giảm số)
                        const badgeCount = document.getElementById('badge-count');
                        if (badgeCount) {
                            let currentCount = parseInt(badgeCount.innerText) || 0;
                            if (currentCount > 0) {
                                currentCount--;
                                badgeCount.innerText = currentCount > 99 ? '99+' : currentCount;
                                if (currentCount === 0) badgeCount.style.display = 'none';
                            }
                        }
                        // Làm mờ dòng thông báo
                        element.style.opacity = '0.7';
                        element.style.background = 'transparent';
                        element.setAttribute('data-read', 'true');
                        const titleEl = element.querySelector('.n-title');
                        if (titleEl) titleEl.style.fontWeight = '400';
                        const dot = element.querySelector('.unread-dot');
                        if (dot) dot.style.display = 'none';
                    } catch (err) { console.error('Lỗi mark read:', err); }
                }

                // 2. [LOGIC MỚI] ĐỔ DỮ LIỆU VÀO MODAL
                const modalOverlay = document.getElementById('notif-modal-overlay');
                const notifDropdown = document.getElementById('notifDropdown');
                const btnAction = document.getElementById('modal-action-btn'); // Nút truy cập

                document.getElementById('modal-title').innerText = element.getAttribute('data-title');
                // Render HTML nội dung
                document.getElementById('modal-content').innerHTML = element.getAttribute('data-content');
                const timeStr = element.getAttribute('data-time'); // Ví dụ: 10:30
                const dateStr = element.getAttribute('data-date'); // Ví dụ: 20/10/2025
                document.getElementById('modal-time').innerText = `${timeStr} - ${dateStr}`; // Kết quả: 10:30 - 20/10/2025

                document.getElementById('modal-user').innerText = element.getAttribute('data-user');


                const badge = document.getElementById('modal-badge');
                badge.innerText = element.getAttribute('data-type');
                badge.className = 'n-badge ' + element.getAttribute('data-type-class');

                // 3. XỬ LÝ NÚT LIÊN KẾT
                if (link && link !== '' && link !== 'null') {
                    // Nếu có link -> Hiện nút và gán href
                    btnAction.style.display = 'inline-flex';
                    btnAction.href = link;
                } else {
                    // Nếu không có link -> Ẩn nút
                    btnAction.style.display = 'none';
                    btnAction.href = '#';
                }

                // 4. HIỆN MODAL
                if (modalOverlay) modalOverlay.classList.add('show');
                if (notifDropdown) notifDropdown.classList.remove('show');
            };

            // 2. Hàm Đọc Tất Cả
            window.markAllRead = async function (e) {
                e.preventDefault();
                // Xóa dòng confirm nếu thấy phiền
                // if(!confirm('Đánh dấu tất cả là đã đọc?')) return; 

                try {
                    const res = await fetch('/api/notifications/mark-all-read', { method: 'POST' });

                    if (res.ok) {
                        // Chỉ khi Server báo OK (200) thì mới ẩn số trên giao diện
                        const badgeCount = document.getElementById('badge-count');
                        if (badgeCount) badgeCount.style.display = 'none';

                        // Làm mờ danh sách
                        const items = document.querySelectorAll('.notif-item');
                        items.forEach(item => {
                            item.classList.remove('unread');
                            item.classList.add('read');
                            const dot = item.querySelector('.unread-dot');
                            if (dot) dot.style.display = 'none';
                            const title = item.querySelector('.n-title');
                            if (title) title.style.fontWeight = '400';
                        });
                    } else {
                        console.error('Lỗi server khi đánh dấu đọc tất cả');
                    }
                } catch (err) {
                    console.error('Lỗi kết nối:', err);
                }
            };

            window.closeNotifModal = function () {
                const modalOverlay = document.getElementById('notif-modal-overlay');
                if (modalOverlay) modalOverlay.classList.remove('show');
            };


            // --- SỰ KIỆN LOAD TRANG ---
            document.addEventListener('DOMContentLoaded', function () {
                // Logic Dropdown Tiện ích (Click & Hover)
                const utilsBtn = document.getElementById('utilitiesDropdownToggle');
                const utilsMenu = document.getElementById('utilitiesDropdownMenu');
                const utilsDropdown = document.querySelector('.dropdown');
                if (utilsBtn && utilsMenu) {
                    utilsBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const isOpen = utilsMenu.classList.contains('open');
                        if (isOpen) {
                            utilsMenu.classList.remove('open');
                            utilsBtn.classList.remove('open');
                            if (utilsDropdown) utilsDropdown.classList.remove('open');
                        } else {
                            const notifDropdown = document.getElementById('notifDropdown');
                            if (notifDropdown) notifDropdown.classList.remove('show');

                            utilsMenu.classList.add('open');
                            utilsBtn.classList.add('open');
                            if (utilsDropdown) utilsDropdown.classList.add('open');
                        }
                    });

                    utilsMenu.addEventListener('click', function (e) {
                        const link = e.target.closest('a');
                        if (link && link.getAttribute('href') && link.getAttribute('href') !== '#') {
                            return; // Cho phép điều hướng trang
                        }
                        e.stopPropagation();
                    });

                    document.addEventListener('click', function (e) {
                        if (!utilsBtn.contains(e.target) && !utilsMenu.contains(e.target)) {
                            utilsMenu.classList.remove('open');
                            utilsBtn.classList.remove('open');
                            if (utilsDropdown) utilsDropdown.classList.remove('open');
                        }
                    });
                }

                // Logic Sticky Header
                const stickyBar = document.querySelector('.sticky-top-bar');
                if (stickyBar) {
                    let lastScrollTop = 0;
                    window.addEventListener('scroll', () => {
                        let st = window.pageYOffset || document.documentElement.scrollTop;
                        if (st > lastScrollTop && st > 100) stickyBar.classList.add('sticky-top-bar--hidden');
                        else if (st < lastScrollTop) stickyBar.classList.remove('sticky-top-bar--hidden');
                        lastScrollTop = st <= 0 ? 0 : st;
                    }, { passive: true });
                }

                // Logic Dropdown Thông Báo
                const notifBtn = document.getElementById('notifToggleBtn');
                const notifDropdown = document.getElementById('notifDropdown');
                if (notifBtn && notifDropdown) {
                    notifBtn.addEventListener('click', (e) => {
                        e.preventDefault(); e.stopPropagation();
                        notifDropdown.classList.toggle('show');
                    });
                    document.addEventListener('click', (e) => {
                        if (!notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) notifDropdown.classList.remove('show');
                    });
                }

                // Logic Click ngoài Modal để đóng
                const modalOverlay = document.getElementById('notif-modal-overlay');
                if (modalOverlay) {
                    modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) window.closeNotifModal(); });
                }

                // Logic Sync BQ
                // Logic Sync BQ
                const syncButton = document.getElementById('btnSyncBigQuery');
                if (syncButton) {
                    syncButton.addEventListener('click', async () => {
                        if (!confirm('Bạn có chắc muốn đồng bộ SKUs từ BigQuery?\nViệc này sẽ chèn các SKU mới vào hệ thống.')) return;

                        syncButton.disabled = true;
                        syncButton.textContent = 'Đang sync...';

                        try {
                            // 1. Gọi API
                            const res = await fetch('/api/admin/sync-bq-skus', { method: 'POST' });

                            // 2. QUAN TRỌNG: Phải đọc dữ liệu JSON trả về từ server
                            const data = await res.json();

                            if (!res.ok) throw new Error(data.error || 'Lỗi không xác định');

                            // 3. Hiển thị thông báo có kèm số lượng (data.new_skus)
                            // Nếu server trả về data.new_skus = 0 thì báo "Không có mới", ngược lại báo số lượng.
                            if (data.new_skus > 0) {
                                alert(`✅ Đồng bộ thành công!\n📦 Đã thêm mới: ${data.new_skus} SKU.`);
                            } else {
                                alert(`✅ Đồng bộ thành công!\n(Không phát hiện SKU mới nào)`);
                            }

                            // Tải lại trang để cập nhật dữ liệu mới nếu cần
                            // window.location.reload(); 

                        } catch (err) {
                            alert('❌ Lỗi đồng bộ: ' + err.message);
                        } finally {
                            syncButton.disabled = false;
                            syncButton.textContent = 'Sync BQ';
                        }
                    });
                }

                // Logic Manual Sync Inventory (Dành cho Fallback)
                const syncInvButton = document.getElementById('btnSyncInventory');
                if (syncInvButton) {
                    syncInvButton.addEventListener('click', async () => {
                        if (!confirm('Bạn có chắc muốn NẠP LẠI TỒN KHO từ BigQuery sang Supabase ngay bây giờ?\n(Chỉ nên dùng khi data bị sai hoặc thiếu. Quá trình có thể mất 30s-1p.)')) return;

                        syncInvButton.disabled = true;
                        syncInvButton.textContent = 'Đang sync...';

                        try {
                            const res = await fetch('/api/admin/sync-inventory', { method: 'POST' });
                            const data = await res.json();

                            if (!res.ok) throw new Error(data.error || 'Lỗi không xác định');

                            alert(`✅ Đồng bộ Tồn Kho Dự Phòng thành công!\nHệ thống đã nạp dữ liệu fallback từ BQ.`);
                        } catch (err) {
                            alert('❌ Lỗi đồng bộ Tồn Kho: ' + err.message);
                        } finally {
                            syncInvButton.disabled = false;
                            syncInvButton.textContent = 'Sync Supabase Fallback';
                        }
                    });
                }
            });

            // ============================================================
            // GLOBAL PAGE LOADER CONTROLLER
            // ============================================================
            (function() {
                let progressTimer = null;
                let failsafeTimer = null;

                window.showGlobalPageLoader = function(title, subtitle) {
                    const loader = document.getElementById('global-page-loader');
                    const progressBar = document.getElementById('global-top-progress');
                    const titleEl = document.getElementById('globalLoaderTitle');
                    const subEl = document.getElementById('globalLoaderSubtitle');

                    if (titleEl && title) titleEl.innerText = title;
                    if (subEl && subtitle) subEl.innerText = subtitle;

                    if (progressBar) {
                        progressBar.classList.add('active');
                        progressBar.style.width = '15%';
                        clearInterval(progressTimer);
                        progressTimer = setInterval(() => {
                            const cur = parseFloat(progressBar.style.width) || 15;
                            if (cur < 85) {
                                progressBar.style.width = (cur + Math.random() * 12) + '%';
                            }
                        }, 250);
                    }

                    if (loader) {
                        loader.classList.add('active');
                        loader.setAttribute('aria-hidden', 'false');
                    }

                    clearTimeout(failsafeTimer);
                    failsafeTimer = setTimeout(() => {
                        window.hideGlobalPageLoader();
                    }, 12000);
                };

                window.hideGlobalPageLoader = function() {
                    const loader = document.getElementById('global-page-loader');
                    const progressBar = document.getElementById('global-top-progress');
                    clearInterval(progressTimer);
                    clearTimeout(failsafeTimer);

                    if (progressBar) {
                        progressBar.style.width = '100%';
                        setTimeout(() => {
                            progressBar.classList.remove('active');
                            progressBar.style.opacity = '0';
                            setTimeout(() => { progressBar.style.width = '0%'; }, 200);
                        }, 180);
                    }

                    if (loader) {
                        loader.classList.remove('active');
                        loader.setAttribute('aria-hidden', 'true');
                    }
                };

                window.addEventListener('pageshow', function() {
                    window.hideGlobalPageLoader();
                });
                window.addEventListener('load', function() {
                    window.hideGlobalPageLoader();
                });

                // Tự động chặn các click vào link nội bộ để hiển thị loading mượt mà
                document.addEventListener('click', function(e) {
                    const link = e.target.closest('a');
                    if (!link) return;

                    if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                    if (link.target === '_blank' || link.hasAttribute('download')) return;

                    const href = link.getAttribute('href');
                    if (!href || href === '#' || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

                    if (link.id === 'utilitiesDropdownToggle' || link.id === 'notifToggleBtn' || link.classList.contains('dropdown-item-header') || link.getAttribute('onclick')) return;

                    const isInternal = href.startsWith('/') || href.startsWith(window.location.origin);
                    if (!isInternal) return;

                    const path = href.split('?')[0].split('#')[0];
                    const curPath = window.location.pathname;
                    if (path === curPath && !href.includes('?')) return;

                    let title = 'Đang tải dữ liệu...';
                    let sub = 'Vui lòng chờ trong giây lát...';

                    if (path === '/' || path === '') {
                        title = 'Trang chủ';
                        sub = 'Đang nạp dữ liệu khuyến mãi & tin tức...';
                    } else if (path.includes('/profile')) {
                        title = 'Profile cá nhân';
                        sub = 'Đang nạp thông tin doanh số, KPI & xếp hạng...';
                    } else if (path.includes('/customer-care')) {
                        title = 'Chăm sóc khách hàng';
                        sub = 'Đang nạp danh sách khách hàng & lịch sử chăm sóc...';
                    } else if (path.includes('/fifo-checking') || path.includes('/fifo')) {
                        title = 'Kiểm tra tồn kho FIFO';
                        sub = 'Đang nạp danh sách tồn kho theo chi nhánh...';
                    } else if (path.includes('/sales-dashboard')) {
                        title = 'Doanh thu Real-time';
                        sub = 'Đang tổng hợp số liệu doanh thu từ hệ thống...';
                    } else if (path.includes('/quick-export')) {
                        title = 'Xuất kho nhanh';
                        sub = 'Đang khởi động module xuất kho...';
                    } else if (path.includes('/quote-builder')) {
                        title = 'Báo giá nhanh';
                        sub = 'Đang nạp bảng giá và cấu hình linh kiện...';
                    } else if (path.includes('/pc-builder')) {
                        title = 'Build PC';
                        sub = 'Đang nạp danh mục linh kiện & kiểm tra tương thích...';
                    } else if (path.includes('/clearance-check')) {
                        title = 'Hàng thanh lý';
                        sub = 'Đang nạp danh sách sản phẩm thanh lý...';
                    } else if (path.includes('/bom-')) {
                        title = 'BOM PCPV';
                        sub = 'Đang nạp cấu hình bộ linh kiện...';
                    } else if (path.includes('/search-promotion')) {
                        title = 'Tra cứu khuyến mãi';
                        sub = 'Đang nạp thông tin sản phẩm & CTKM...';
                    }

                    window.showGlobalPageLoader(title, sub);
                });

                // Tự động chặn khi người dùng submit form tra cứu SKU
                document.addEventListener('submit', function(e) {
                    const form = e.target;
                    if (!form) return;
                    const action = (form.getAttribute('action') || '').toLowerCase();
                    if (action.includes('/search-promotion') || form.id === 'searchForm') {
                        const input = form.querySelector('input[name="sku"], input[name="query"], #skuSearch');
                        const skuVal = input ? input.value.trim() : '';
                        window.showGlobalPageLoader(
                            'Tra cứu khuyến mãi',
                            skuVal ? 'Đang nạp chi tiết SKU: ' + skuVal + '...' : 'Đang tổng hợp CTKM sản phẩm...'
                        );
                    }
                });
            })();
        </script>
        <main class="main-content">
            <div class="container">