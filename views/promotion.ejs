                            <button id="btnCancelPrice" class="btn-price-abort">Hủy</button>
                        </span>
                    </div>

                    <!-- Block Thông số kỹ thuật & Đồng bộ -->
                    <div class="product-spec-row">
                        <button id="btnViewSpec" type="button" class="btn-spec-action" title="Xem chi tiết thông số kỹ thuật dạng popup">
                            Thông số kỹ thuật
                        </button>
                        <button id="btnSyncSpec" type="button" class="btn-spec-sync" title="Đồng bộ lại thông số & giá mới nhất từ hệ thống" style="padding: 5px 8px; font-size: 13px;">
                            🔄
                        </button>
                    </div>
                </div>
    
                    <div class="uupm-stock-section">
                        <% if (typeof isGlobalAdmin !== 'undefined' && isGlobalAdmin && inventoryMap && inventoryMap.get(product.sku)) { %>
                            <div class="uupm-stock-title-row">
                                <strong class="uupm-stock-title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 8-9 5-9-5"/><path d="M3 8l9-5 9 5v8l-9 5-9-5Z"/><path d="M12 13v8"/></svg>Tồn kho hệ thống</strong>
                                <span class="uupm-stock-note">Đã trừ serial đã xuất</span>
                            </div>
                            
                            <div class="admin-stock-wrapper">
                                <div class="admin-stock-header">
                                    <div>Chi nhánh</div>
                                    <div>Bán mới</div>
                                    <div>TB CĐ</div>
                                    <div>Lưu TL</div>
                                    <div>TB TL</div>
                                    <div>Khác</div>
                                </div>
                                <div class="admin-stock-list">
                                    <% const branchMap = inventoryMap.get(product.sku); %>
                                    <% if (branchMap && branchMap.size > 0) { %>
                                        <% [...branchMap.keys()].sort().forEach(branchId => { %>
                                            <% const counts = branchMap.get(branchId); %>
                                            <div class="admin-stock-row">
                                                <div><%= branchId %></div>
                                                <div class="<%= counts.hang_ban_moi === 0 ? 'zero-muted' : '' %>">
                                                    <strong><%= counts.hang_ban_moi %></strong>
                                                </div>
                                                <div class="<%= counts.trung_bay_chi_dinh === 0 ? 'zero-muted' : '' %>">
                                                    <%= counts.trung_bay_chi_dinh %>
                                                </div>
                                                <div class="<%= counts.luu_kho_tl === 0 ? 'zero-muted' : '' %>">
                                                    <%= counts.luu_kho_tl %>
                                                </div>
                                                <div class="<%= counts.trung_bay_tl === 0 ? 'zero-muted' : '' %>">
                                                    <%= counts.trung_bay_tl %>
                                                </div>
                                                <div class="<%= counts.ton_khac === 0 ? 'zero-muted' : '' %>">
                                                    <%= counts.ton_khac %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="no-data" style="padding:10px;">Không có dữ liệu tồn kho.</div>
                                    <% } %>
                                </div>
                            </div>

                        <% } else if (typeof inventoryCounts !== 'undefined' && inventoryCounts) { %>
                            <div class="uupm-stock-title-row">
                                <strong class="uupm-stock-title"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 8-9 5-9-5"/><path d="M3 8l9-5 9 5v8l-9 5-9-5Z"/><path d="M12 13v8"/></svg>Tồn kho: <%= userBranch %></strong>
                                <span class="uupm-stock-note">Đã trừ serial đã xuất</span>
                            </div>
                            <div class="stock-mini-grid">
                                <div class="stock-pill <%= inventoryCounts.hang_ban_moi > 0 ? 'active' : '' %>">
                                    <span class="num"><%= inventoryCounts.hang_ban_moi %></span>
                                    <span class="lbl">Bán mới</span>
                                </div>
                                <div class="stock-pill <%= inventoryCounts.trung_bay_chi_dinh > 0 ? 'active' : '' %>">
                                    <span class="num"><%= inventoryCounts.trung_bay_chi_dinh %></span>
                                    <span class="lbl">TB CĐ</span>
                                </div>
                                <div class="stock-pill" style="opacity: 0.9;">
                                    <span class="num"><%= inventoryCounts.luu_kho_tl %></span>
                                    <span class="lbl">LK TL</span>
                                </div>
                                <div class="stock-pill" style="opacity: 0.9;">
                                    <span class="num"><%= inventoryCounts.trung_bay_tl %></span>
                                    <span class="lbl">TB TL</span>
                                </div>
                                <div class="stock-pill" style="opacity: 0.7;">
                                    <span class="num"><%= inventoryCounts.ton_khac %></span>
                                    <span class="lbl">Khác</span>
                                </div>
                            </div>

                        <% } else { %>
                            <div class="no-data" style="padding: 20px; background: #f8fafc; border-radius: 10px; border:1px dashed #e2e8f0;">
                                <small>Không có dữ liệu tồn kho BigQuery <% if (!isGlobalAdmin) { %>tại <%= userBranch %><% } %></small>
                            </div>
                        <% } %>
    
                        <% if (typeof oldestSerials !== 'undefined' && oldestSerials.length > 0) { %>
                            <div class="uupm-oldest-box">
                                <div class="uupm-oldest-header">
                                    <strong class="uupm-oldest-title"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="m10.3 3.9-8.2 14.2A2 2 0 0 0 3.8 21h16.4a2 2 0 0 0 1.7-2.9L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>5 serial tồn lâu nhất</strong>
                                </div>
                                <div class="uupm-oldest-list">
                                    <% oldestSerials.forEach(s => { %>
                                        <div class="uupm-oldest-item">
                                            <span class="uupm-oldest-serial"><%= s.serial %><span class="uupm-oldest-zone">(<%= s.bin_zone %>)</span></span>
                                            <strong class="uupm-oldest-days"><%= s.days_old %> ngày</strong>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
        </div>

    <div class="history-banner">
    <div class="info-group">
        <div class="icon-box">🔎</div>
        <div>
            <h4 class="title-text">
                Lịch sử so sánh giá
                <span class="count-badge"><%= comparisonCount || 0 %> lần</span>
            </h4>
            <span style="font-size: 13px; color: #64748b;">Xem lại các lần so găng giá của SKU này.</span>
        </div>
    </div>
    <a href="/price-battle?sku=<%= product.sku %>" class="btn-view-modern">Xem chi tiết →</a>
</div>

        <% if (typeof promoGroups !== 'undefined') { 
            if (promoGroups.other && promoGroups.other.length > 0) {
            promoGroups.other = promoGroups.other.filter(p => p.promo_type !== 'KFI');
        };
            const hasHot = promoGroups.hot && promoGroups.hot.length > 0;
             const hasFuture = promoGroups.future && promoGroups.future.length > 0;
             const hasPayment = promoGroups.payment && promoGroups.payment.length > 0;
             const hasInstallment = promoGroups.installment && promoGroups.installment.length > 0;
             const hasOther = promoGroups.other && promoGroups.other.length > 0;
        %>

        <% if (typeof sortedPromosList !== 'undefined' && sortedPromosList && sortedPromosList.length > 0) { %>
            <!-- 1. BẢNG DANH SÁCH CTKM ÁP DỤNG (SẮP XẾP GIẢM DẦN THEO MỨC GIẢM) - UI/UX PRO MAX -->
            <div class="promo-section-card">
                <div class="promo-section-header">
                    <div class="promo-section-title-wrap">
                        <div class="promo-section-icon-badge">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="promo-section-title">
                                <span>Danh Sách CTKM Áp Dụng (Xếp Giảm Dần)</span>
                                <span class="promo-count-pill">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                    <%= sortedPromosList.length %> chương trình
                                </span>
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="promo-sorted-list">
                    <% sortedPromosList.forEach((promo, idx) => { 
                        const rankClass = idx === 0 ? 'top-1' : (idx === 1 ? 'top-2' : (idx === 2 ? 'top-3' : ''));
                        const promoPayload = {
                            name: promo.name || 'Chương trình khuyến mãi',
                            icon: promo.__icon || '🏷️',
                            category: promo.category || '',
                            promo_type: promo.__promo_type || promo.promo_type || promo.__category_badge || 'Khuyến mãi',
                            apply_channels: promo.__apply_channels || promo.channel || promo.apply_channels || 'All channels',
                            conditions: promo.__conditions || promo.conditions || promo.special_conditions || promo.description || '',
                            detail_link: promo.__detail_link || promo.detail_link || '',
                            sku: promo.sku || '',
                            short_desc: promo.__short_desc || promo.description || '',
                            discount_label: promo.__discount_label || '',
                            start_date: promo.start_date || '',
                            end_date: promo.end_date || '',
                            source: promo.source_sheet || '',
                            compatible_icons: promo.__compatible_icons || [],
                            compatible_specific_promos: promo.__compatible_specific_promos || [],
                            detail_fields: promo.detail_fields || null
                        };
                        const encodedPromo = encodeURIComponent(JSON.stringify(promoPayload));
                    %>
                        <div class="sorted-promo-row">
                            <!-- Cột 1: Rank Badge -->
                            <div class="sorted-rank <%= rankClass %>" title="Hạng #<%= idx + 1 %>">
                                <% if (idx === 0) { %>
                                    👑
                                <% } else { %>
                                    #<%= idx + 1 %>
                                <% } %>
                            </div>
                            
                            <!-- Cột 2: Icon nhận diện -->
                            <div class="sorted-icon-box" style="background: <%= promo.__icon_bg || '#f1f5f9' %>; color: <%= promo.__icon_color || '#334155' %>;">
                                <%= promo.__icon || '🏷️' %>
                            </div>

                            <!-- Cột 3: Tên & Mô tả & HSD -->
                            <div class="sorted-main-info">
                                <div class="sorted-title"><%= promo.name %></div>
                                <div class="sorted-desc"><%= promo.__short_desc || promo.description || 'Ưu đãi áp dụng khi mua sản phẩm' %></div>
                                <% if (promo.end_date) { %>
                                    <div class="sorted-dates">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        <span>Đến <%= new Date(promo.end_date).toLocaleDateString('vi-VN') %></span>
                                        <% if (promo.source_sheet) { %>
                                            <span style="color: #94a3b8;">•</span>
                                            <span><%= promo.source_sheet %></span>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Cột 4: Mức giảm giá -->
                            <div class="sorted-discount-col">
                                <div class="sorted-discount-badge">
                                    <%= promo.__discount_label || 'Ưu đãi đặc biệt' %>
                                </div>
                            </div>

                            <!-- Cột 5: Dùng chung với -->
                            <div class="sorted-compat-col">
                                <div class="sorted-compat-title">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    <span>Dùng chung với:</span>
                                </div>
                                <div class="sorted-compat-icons">
                                    <% 
                                        const specificList = promo.__compatible_specific_promos || [];
                                        const maxVisible = 2;
                                        const visibleChips = specificList.slice(0, maxVisible);
                                        const remainingCount = specificList.length - maxVisible;
                                    %>
                                    <% if (specificList.length > 0) { %>
                                        <% visibleChips.forEach(cp => { %>
                                            <span class="compat-chip-specific" title="<%= cp.name %>">
                                                <span><%= cp.icon %></span>
                                                <span><%= cp.shortLabel %></span>
                                            </span>
                                        <% }) %>
                                        <% if (remainingCount > 0) { %>
                                            <button type="button" class="btn-compat-more js-btn-compat-more" 
                                                    data-promo-name="<%= promo.name %>" 
                                                    data-promo-icon="<%= promo.__icon || '🏷️' %>"
                                                    data-compat-list="<%- encodeURIComponent(JSON.stringify(specificList)) %>">
                                                +<%= remainingCount %> khác
                                            </button>
                                        <% } %>
                                    <% } else if (promo.__compatible_icons && promo.__compatible_icons.length > 0) { %>
                                        <% promo.__compatible_icons.slice(0, maxVisible).forEach(ci => { %>
                                            <span class="compat-chip-specific" title="<%= ci.name %>">
                                                <span><%= ci.icon %></span>
                                                <span><%= ci.name %></span>
                                            </span>
                                        <% }) %>
                                        <% if (promo.__compatible_icons.length > maxVisible) { %>
                                            <span class="compat-none-tag">+<%= promo.__compatible_icons.length - maxVisible %></span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="compat-none-tag">Áp dụng độc lập</span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Cột 6: Nút hành động -->
                            <div class="sorted-actions-col">
                                <button type="button" class="btn-sorted-detail js-btn-promo-detail" data-promo="<%- encodedPromo %>">
                                    <span>Chi tiết</span>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <% 
            const matrixList = (typeof compatMatrix !== 'undefined' && compatMatrix) ? (compatMatrix.promoList || compatMatrix.promos || []) : []; 
            const matrixCells = (typeof compatMatrix !== 'undefined' && compatMatrix) ? (compatMatrix.matrix || compatMatrix.cells || []) : [];
        %>
        <% if (matrixList && matrixList.length > 1) { %>
            <!-- 2. BẢNG MA TRẬN KẾT HỢP CTKM (CÓ THỂ DÙNG CHUNG) - UI/UX PRO MAX -->
            <div class="promo-section-card">
                <div class="promo-section-header">
                    <div class="promo-section-title-wrap">
                        <div class="promo-section-icon-badge" style="background: #ecfdf5; color: #059669;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="promo-section-title">
                                <span>Ma Trận Kết Hợp CTKM (Có Thể Dùng Chung)</span>
                            </h3>
                        </div>
                    </div>
                    <div class="matrix-legend">
                        <span><strong style="color: #059669;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Có thể:</strong> Dùng chung được</span>
                        <span><strong style="color: #dc2626;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Không:</strong> Loại trừ lẫn nhau</span>
                        <span><strong style="color: #94a3b8;">― :</strong> Cùng chương trình</span>
                    </div>
                </div>

                <div class="promo-matrix-wrapper">
                    <table class="promo-matrix-table">
                        <thead>
                            <tr>
                                <th class="col-sticky">Chương Trình Khuyến Mãi</th>
                                <% matrixList.forEach((p, colIdx) => { %>
                                    <th title="<%= p.name %>">
                                        <div class="matrix-th-label">
                                            <span style="font-size: 16px;"><%= p.icon || p.__icon || '🏷️' %></span>
                                            <span class="matrix-th-name"><%= p.name %></span>
                                        </div>
                                    </th>
                                <% }) %>
                                <th style="min-width: 90px;">Xem Chi Tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% matrixList.forEach((rowP, rowIdx) => { 
                                const rowPayload = {
                                    name: rowP.name || 'Chương trình khuyến mãi',
                                    icon: rowP.icon || rowP.__icon || '🏷️',
                                    category: rowP.categoryBadge || rowP.category || '',
                                    promo_type: rowP.type || rowP.categoryBadge || 'Khuyến mãi',
                                    apply_channels: rowP.apply_channels || rowP.channel || 'All channels',
                                    conditions: rowP.conditions || rowP.special_conditions || rowP.description || '',
                                    detail_link: rowP.detail_link || '',
                                    sku: rowP.sku || '',
                                    short_desc: rowP.short_desc || rowP.__short_desc || rowP.description || '',
                                    discount_label: rowP.discountLabel || rowP.__discount_label || '',
                                    start_date: rowP.start_date || '',
                                    end_date: rowP.end_date || '',
                                    source: rowP.source || rowP.source_sheet || rowP.group || '',
                                    compatible_icons: rowP.__compatible_icons || [],
                                    compatible_specific_promos: rowP.__compatible_specific_promos || [],
                                    detail_fields: rowP.detail_fields || null
                                };
                                const encodedRowPromo = encodeURIComponent(JSON.stringify(rowPayload));
                            %>
                                <tr>
                                    <td class="col-sticky">
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <span style="font-size: 18px;"><%= rowP.icon || rowP.__icon || '🏷️' %></span>
                                            <div>
                                                <div style="font-weight: 700; color: #1e293b; font-size: 13px; line-height: 1.3;"><%= rowP.name %></div>
                                                <div style="font-size: 11px; color: #ef4444; font-weight: 700; margin-top: 2px;"><%= rowP.discountLabel || rowP.__discount_label %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <% matrixList.forEach((colP, colIdx) => { 
                                        const rawCell = (matrixCells[rowIdx] && matrixCells[rowIdx][colIdx]);
                                        const cellVal = (typeof rawCell === 'object' && rawCell !== null) ? rawCell.status : (rawCell || 'deny');
                                    %>
                                        <td>
                                            <% if (cellVal === 'self') { %>
                                                <span class="matrix-badge-self">―</span>
                                            <% } else if (cellVal === 'allow') { %>
                                                <span class="matrix-badge-allow" title="Có thể kết hợp cùng">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                                    Có thể
                                                </span>
                                            <% } else { %>
