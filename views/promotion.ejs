    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px; padding-top:12px; border-top:1px solid #f1f5f9; font-size:12px; color:#94a3b8;">
      <span id="specModalUpdatedAt">
        <% if (typeof product !== 'undefined' && product && product.spec_updated_at) { %>
          Cập nhật: <%= new Date(product.spec_updated_at).toLocaleString('vi-VN') %> (Supabase)
        <% } else { %>
          Lưu trữ nội bộ Supabase
        <% } %>
      </span>
      <button type="button" class="btn-close-spec" style="padding:7px 16px; background:#f1f5f9; color:#475569; border:none; border-radius:8px; font-weight:700; cursor:pointer;">Đóng</button>
