            <div style="font-size:13px; max-width:400px; margin:0 auto 15px auto;">Sản phẩm chưa được lưu thông số vào Supabase. Bấm nút dưới để đồng bộ thông tin ngay.</div>
            <button type="button" onclick="document.getElementById('btnSyncSpec').click()" style="padding:8px 16px; background:#2563eb; color:#fff; border:none; border-radius:6px; font-weight:700; font-size:13px; cursor:pointer;">🔄 Đồng bộ thông số từ hệ thống</button>
          </div>
        <% } %>
