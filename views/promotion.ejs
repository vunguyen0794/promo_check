                                <% if (p.compat_allow_names && p.compat_allow_names.length) { %>
                                    <div class="compat-tag allow" title="Được áp dụng đồng thời">✅ Cùng: <%= p.compat_allow_names.join(', ') %></div>
                                <% } %>
                                <% if (p.compat_exclude_names && p.compat_exclude_names.length) { %>
                                    <div class="compat-tag deny" title="Không áp dụng cùng">⛔ Trừ: <%= p.compat_exclude_names.join(', ') %></div>
                                <% } %>
                            </div>
                        <% } %>

                        <% if (p.coupon_code) { %>
