                                        if (opt.skus && Array.isArray(opt.skus) && opt.skus.length > 0) {
                                            promoOptions.push({
                                                type: 'Combo',
                                                cssClass: 'badge-combo',
                                                // Combo thường không có code riêng lẻ ở đây, nhưng cứ lấy nếu có
                                                code: opt.code, 
