                <span style="color: #0f172a;">Giá khách mua:</span>
                <strong><%= new Intl.NumberFormat('vi-VN').format(finalPrice) %> VNĐ</strong>
            </div>
            
            <div style="font-size:12px; color:#94a3b8; margin-top:10px; font-style:italic;">
                * Giá trên chưa bao gồm giảm thêm từ ưu đãi thanh toán, mã giảm đơn hàng sau.
            </div>
        </div>
        <% } %>
    
        <% } else { %>
            <% if (typeof product === 'undefined') { %>
               <div style="text-align: center; padding: 40px; color: #94a3b8;">
                   <p style="font-size: 16px;">Vui lòng nhập SKU để tra cứu chương trình khuyến mãi.</p>
               </div>
            <% } else { %>
               <div class="no-data"><i>📭</i> <p>Không có dữ liệu cho SKU này.</p></div>
            <% } %>
        <% } %>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function parseNumber(s) { return parseInt(String(s || '').replace(/\D/g, ''), 10) || 0; }
    function formatNumber(n) { return new Intl.NumberFormat('vi-VN').format(Number(n || 0)); }
    
    // Popup Coupon List
    window.showCouponListModal = function (button) {
        var modal = document.getElementById('couponListModal');
        var titleEl = document.getElementById('couponModalTitle');
        var container = document.getElementById('couponModalTableContainer');
        if (!modal || !titleEl || !container) return;
        var promoName = (button && button.dataset && button.dataset.promoName) ? button.dataset.promoName : '—';
        var coupons = [];
        try { coupons = JSON.parse((button && button.dataset && button.dataset.coupons) ? button.dataset.coupons : '[]'); } catch (e) { coupons = []; }
        function fmt(n) { return new Intl.NumberFormat('vi-VN').format(n); }
        var sorted = coupons.slice().sort(function(a, b) {
            return (parseFloat(String(b.discount).replace(/\D/g,'')) || 0) - (parseFloat(String(a.discount).replace(/\D/g,'')) || 0);
        });
        var rows = sorted.map(function(c) {
            var disc = parseFloat(String(c.discount).replace(/\D/g,'')) || 0;
            return `<tr><td>${c.name||'-'}</td><td><button class="code-badge" onclick="copyCode(this)" data-code="${c.code||''}">${c.code||''}</button></td><td class="money">${disc?fmt(disc):'-'}</td><td>${c.note||'-'}</td></tr>`;
        }).join('');
        titleEl.textContent = 'Danh sách coupon: ' + promoName;
        container.innerHTML = '<div class="table-scroll-wrapper"><table class="info-table" style="margin-top:10px"><thead><tr><th>Tên/Nhóm</th><th>Mã</th><th>Giảm</th><th>Ghi chú</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
        modal.style.display = 'flex';
    };

    // Copy Code Logic
    window.copyCode = function(btn) {
        const code = btn.getAttribute('data-code');
        if (code) {
            navigator.clipboard.writeText(code).then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<span>Đã copy!</span>';
                setTimeout(() => btn.innerHTML = originalText, 1500);
            });
        }
    };

    // Logic Sửa giá / Lịch sử giá (như cũ)
    const sku = "<%= (typeof product !== 'undefined' && product) ? product.sku : '' %>";
    if (sku) {
        const btnEdit = document.getElementById('btnEditPrice');
        const btnSave = document.getElementById('btnSavePrice');
        const btnCancel = document.getElementById('btnCancelPrice');
        const view = document.getElementById('priceView');
        const editWrap = document.getElementById('priceEdit');
        const input = document.getElementById('priceInput');
        const btnHistory = document.getElementById('btnHistoryPrice');
        const historyModal = document.getElementById('priceHistoryModal');
        const historyTbody = document.querySelector('#phTable tbody');

        if (input) input.addEventListener('input', (e) => { e.target.value = formatNumber(parseNumber(e.target.value)); });
        if (btnEdit) btnEdit.onclick = () => { editWrap.style.display = editWrap.style.display === 'none' ? 'block' : 'none'; if (editWrap.style.display === 'block') input.focus(); };
        if (btnCancel) btnCancel.onclick = () => { editWrap.style.display = 'none'; };
        
        if (btnSave) btnSave.onclick = async () => {
            try {
                const newPrice = parseNumber(input.value);
                if (newPrice < 0) { alert('Giá không hợp lệ'); return; }
                const res = await fetch(`/api/sku/${encodeURIComponent(sku)}/price`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ new_price: newPrice })
                });
                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error(res.status === 401 ? 'Phiên đăng nhập đã hết hạn.' : `Máy chủ phản hồi mã ${res.status}.`);
                }
                const js = await res.json();
                if (!js.ok) throw new Error(js.error || 'Cập nhật thất bại');
                document.getElementById('searchForm').submit();
            } catch (e) { alert(e.message); }
        };

        if (btnHistory) btnHistory.onclick = async (e) => {
            e.preventDefault();
            historyTbody.innerHTML = '<tr><td colspan="4" style="text-align:center">Đang tải...</td></tr>';
            historyModal.style.display = 'flex';
            try {
                const res = await fetch(`/api/sku/${encodeURIComponent(sku)}/price-history`);
                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error(res.status === 401 ? 'Phiên đăng nhập đã hết hạn.' : `Lỗi ${res.status}`);
                }
                const js = await res.json();
                if (!js.ok) throw new Error(js.error);
                const rows = (js.history || []).map(r => `<tr><td>${new Date(r.changed_at).toLocaleString('vi-VN')}</td><td>${new Intl.NumberFormat('vi-VN').format(r.old_price||0)}</td><td><strong>${new Intl.NumberFormat('vi-VN').format(r.new_price||0)}</strong></td><td>${r.user||'-'}</td></tr>`).join('');
                historyTbody.innerHTML = rows || `<tr><td colspan="4" style="text-align:center">Chưa có lịch sử</td></tr>`;
            } catch (e) { historyTbody.innerHTML = `<tr><td colspan="4">Lỗi: ${e.message}</td></tr>`; }
        };
        
        // Logic Xem Thông số KT / Đồng bộ thông số
        const btnViewSpec = document.getElementById('btnViewSpec');
        const btnSyncSpec = document.getElementById('btnSyncSpec');
        const specModal = document.getElementById('specificationsModal');

        if (btnViewSpec) {
            btnViewSpec.onclick = () => {
                if (specModal) specModal.style.display = 'flex';
            };
        }

        if (btnSyncSpec) {
            btnSyncSpec.onclick = async () => {
                const originalText = btnSyncSpec.innerHTML;
                btnSyncSpec.disabled = true;
                btnSyncSpec.innerHTML = '<span>⏳ Đang đồng bộ...</span>';
                try {
                    const res = await fetch(`/api/sku/${encodeURIComponent(sku)}/refresh-spec`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' }
                    });
                    const contentType = res.headers.get('content-type') || '';
                    if (!contentType.includes('application/json')) {
                        throw new Error(res.status === 401 ? 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.' : `Máy chủ phản hồi mã ${res.status}. Vui lòng thử lại.`);
                    }
                    const js = await res.json();
                    if (!js.ok) throw new Error(js.error || 'Đồng bộ thất bại');
                    
                    alert('Đã cập nhật thông số và giá mới nhất vào Supabase thành công!');
                    window.location.reload();
                } catch (err) {
                    alert('Lỗi: ' + err.message);
                } finally {
                    btnSyncSpec.disabled = false;
                    btnSyncSpec.innerHTML = originalText;
                }
            };
        }

        if (specModal) {
            const closeBtn = specModal.querySelector('.close-spec-modal');
            const closeFooterBtn = specModal.querySelector('.btn-close-spec');
            if (closeBtn) closeBtn.onclick = () => specModal.style.display = 'none';
            if (closeFooterBtn) closeFooterBtn.onclick = () => specModal.style.display = 'none';
        }
        
        window.currentProductData = {
            sku: "<%= (typeof product !== 'undefined' && product) ? product.sku : '' %>",
            name: "<%= (typeof product !== 'undefined' && product) ? (product.product_name || '').replace(/\"/g, '\\"') : '' %>",
            brand: "<%= (typeof product !== 'undefined' && product) ? (product.brand || '') : '' %>",
            price: <%= (typeof product !== 'undefined' && product && product.list_price) ? Number(product.list_price) : 0 %>,
            promo_price: <%= (typeof product !== 'undefined' && product && product.promo_price) ? Number(product.promo_price) : 0 %>,
            warranty: "<%= (typeof product !== 'undefined' && product && product.warranty) ? (product.warranty || '').replace(/\s*chính\s*hãng/gi, '').trim() : '' %>",
            vat_rate: <%= (typeof product !== 'undefined' && product && product.vat_rate !== null) ? Number(product.vat_rate) : 'null' %>,
            attributes: <%- (typeof product !== 'undefined' && product && product.specifications && product.specifications.attributes) ? JSON.stringify(product.specifications.attributes) : '[]' %>
        };

        window.filterSpecs = function(query) {
            const q = (query || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#specTableContainer .spec-table tbody tr');
            let count = 0;
            rows.forEach(tr => {
                const text = tr.innerText.toLowerCase();
                const match = !q || text.includes(q);
                tr.style.display = match ? '' : 'none';
                if (match) count++;
            });
            const noMatch = document.getElementById('specFilterNoMatch');
            if (noMatch) {
                noMatch.style.display = (count === 0 && q) ? 'block' : 'none';
            }
        };

        window.runCompareSku = async function() {
            const input = document.getElementById('compareSkuInput');
            const alertBox = document.getElementById('compareAlert');
            const btnRun = document.getElementById('btnRunCompare');
            const btnClear = document.getElementById('btnClearCompare');
            const targetSku = (input ? input.value : '').trim();

            if (!targetSku) {
                if (alertBox) {
                    alertBox.style.display = 'block';
                    alertBox.style.background = '#fef2f2';
                    alertBox.style.color = '#b91c1c';
                    alertBox.style.border = '1px solid #fecaca';
                    alertBox.innerHTML = 'Vui lòng nhập mã SKU laptop cần so sánh.';
                }
                return;
            }

            if (targetSku === window.currentProductData.sku) {
                if (alertBox) {
                    alertBox.style.display = 'block';
                    alertBox.style.background = '#fffbeb';
                    alertBox.style.color = '#b45309';
                    alertBox.style.border = '1px solid #fde68a';
                    alertBox.innerHTML = 'Mã SKU này trùng với sản phẩm hiện tại. Vui lòng nhập SKU khác để so sánh.';
                }
                return;
            }

            if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = '#eff6ff';
                alertBox.style.color = '#1d4ed8';
                alertBox.style.border = '1px solid #bfdbfe';
                alertBox.innerHTML = '⏳ Đang tải thông số SKU ' + targetSku + '...';
            }
            if (btnRun) {
                btnRun.disabled = true;
                btnRun.innerText = 'Đang tải...';
            }

            try {
                const res = await fetch(`/api/sku/${encodeURIComponent(targetSku)}/details`);
                const js = await res.json();
                if (!res.ok || !js.ok || !js.product) {
                    throw new Error(js.error || `Không tìm thấy sản phẩm với SKU: ${targetSku}`);
                }

                renderCompareTable(js.product);

                if (alertBox) {
                    alertBox.style.display = 'block';
                    alertBox.style.background = '#f0fdf4';
                    alertBox.style.color = '#15803d';
                    alertBox.style.border = '1px solid #bbf7d0';
                    alertBox.innerHTML = `✓ Đang so sánh: <strong>${window.currentProductData.sku}</strong> vs <strong>${js.product.sku}</strong> (${js.product.product_name})`;
                }
                if (btnClear) btnClear.style.display = 'inline-block';
            } catch (err) {
                if (alertBox) {
                    alertBox.style.display = 'block';
                    alertBox.style.background = '#fef2f2';
                    alertBox.style.color = '#b91c1c';
                    alertBox.style.border = '1px solid #fecaca';
                    alertBox.innerHTML = 'Lỗi: ' + err.message;
                }
            } finally {
                if (btnRun) {
                    btnRun.disabled = false;
                    btnRun.innerText = 'So sánh';
                }
            }
        };

        window.clearCompareSku = function() {
            const input = document.getElementById('compareSkuInput');
            const alertBox = document.getElementById('compareAlert');
            const btnClear = document.getElementById('btnClearCompare');
            const modalContent = document.querySelector('#specificationsModal .modal-content');

            if (input) input.value = '';
            if (alertBox) alertBox.style.display = 'none';
            if (btnClear) btnClear.style.display = 'none';
            if (modalContent) modalContent.style.maxWidth = '780px';

            renderSingleTable();
            window.filterSpecs(document.getElementById('specFilterInput')?.value || '');
        };

        function renderCompareTable(p2) {
            const container = document.getElementById('specTableContainer');
            const modalContent = document.querySelector('#specificationsModal .modal-content');
            if (modalContent) modalContent.style.maxWidth = '960px';

            const p1 = window.currentProductData;
            const p1Attrs = p1.attributes || [];
            const p2Attrs = (p2.specifications && p2.specifications.attributes) || [];

            const map1 = {};
            p1Attrs.forEach(a => { if (a && a.name) map1[a.name.trim()] = a.value || '-'; });

            const map2 = {};
            p2Attrs.forEach(a => { if (a && a.name) map2[a.name.trim()] = a.value || '-'; });

            const allNames = [];
            const seen = new Set();
            p1Attrs.forEach(a => {
                const n = a && a.name ? a.name.trim() : '';
                if (n && !seen.has(n)) { seen.add(n); allNames.push(n); }
            });
            p2Attrs.forEach(a => {
                const n = a && a.name ? a.name.trim() : '';
                if (n && !seen.has(n)) { seen.add(n); allNames.push(n); }
            });

            const p1Price = p1.promo_price > 0 ? (new Intl.NumberFormat('vi-VN').format(p1.promo_price) + ' đ') : (p1.price > 0 ? new Intl.NumberFormat('vi-VN').format(p1.price) + ' đ' : '-');
            const p2Price = p2.promo_price > 0 ? (new Intl.NumberFormat('vi-VN').format(p2.promo_price) + ' đ') : (p2.list_price > 0 ? new Intl.NumberFormat('vi-VN').format(p2.list_price) + ' đ' : '-');

            const p1Warranty = p1.warranty || '-';
            const p2Warranty = p2.warranty ? p2.warranty.replace(/\s*chính\s*hãng/gi, '').trim() : '-';

            const p1Vat = p1.vat_rate !== null ? (p1.vat_rate + '%') : '-';
            const p2Vat = p2.vat_rate !== null ? (p2.vat_rate + '%') : '-';

            let html = `
            <table class="spec-table spec-compare-table">
              <thead>
                <tr style="background:#f8fafc; border-bottom:2px solid #cbd5e1;">
                  <th style="width:24%; font-size:12.5px; font-weight:800; color:#475569; padding:8px 10px;">Thuộc tính</th>
                  <th style="width:38%; font-size:12.5px; font-weight:800; color:#1d4ed8; padding:8px 10px; background:#eff6ff;">
                    <div>SKU: ${p1.sku} (Đang xem)</div>
                    <div style="font-size:12px; font-weight:600; color:#334155; margin-top:2px; line-height:1.35;">${p1.name}</div>
                    <div style="margin-top:4px; font-size:15px; font-weight:900; color:#dc2626;">${p1Price}</div>
                  </th>
                  <th style="width:38%; font-size:12.5px; font-weight:800; color:#059669; padding:8px 10px; background:#f0fdf4;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                      <span>SKU: ${p2.sku}</span>
                      <a href="/search-promotion?sku=${encodeURIComponent(p2.sku)}" target="_blank" style="font-size:11.5px; color:#2563eb; text-decoration:none; font-weight:700;">Xem chi tiết ↗</a>
                    </div>
                    <div style="font-size:12px; font-weight:600; color:#334155; margin-top:2px; line-height:1.35;">${p2.product_name}</div>
                    <div style="margin-top:4px; font-size:15px; font-weight:900; color:#dc2626;">${p2Price}</div>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr style="background:#fafafa;">
                  <th style="font-weight:700; color:#334155;">Bảo hành</th>
                  <td style="font-weight:700; color:#1e40af; background:#f8fafc;">${p1Warranty}</td>
                  <td style="font-weight:700; color:#065f46; background:#fcfdfd;">${p2Warranty}</td>
                </tr>
                <tr style="background:#fafafa;">
                  <th style="font-weight:700; color:#334155;">VAT</th>
                  <td style="background:#f8fafc;">${p1Vat}</td>
                  <td style="background:#fcfdfd;">${p2Vat}</td>
                </tr>
            `;

            allNames.forEach(name => {
                const val1 = map1[name] || '-';
                const val2 = map2[name] || '-';
                const isDiff = (val1 !== '-' && val2 !== '-' && val1.trim() !== val2.trim());
                const rowStyle = isDiff ? 'style="background:#fffbeb;"' : '';
                html += `
                <tr ${rowStyle}>
                  <th>${name} ${isDiff ? '<span title="Điểm khác biệt" style="color:#d97706; font-size:12px;">★</span>' : ''}</th>
                  <td style="vertical-align:top; font-size:12.5px;">${val1}</td>
                  <td style="vertical-align:top; font-size:12.5px;">${val2}</td>
                </tr>`;
            });

            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function renderSingleTable() {
            const container = document.getElementById('specTableContainer');
            const p1 = window.currentProductData;
            const p1Attrs = p1.attributes || [];

            if (!p1Attrs || p1Attrs.length === 0) {
                container.innerHTML = '<div style="text-align:center; padding:30px; color:#64748b;">Chưa có thông số kỹ thuật chi tiết</div>';
                return;
            }

            let rows = p1Attrs.map(a => `<tr><th>${a.name}</th><td>${a.value}</td></tr>`).join('');
            container.innerHTML = `<table class="spec-table" id="singleSpecTable"><tbody>${rows}</tbody></table>`;
        }

        // Close modal
        window.onclick = (e) => {
            if (e.target == historyModal) historyModal.style.display = "none";
            if (e.target == document.getElementById('couponListModal')) document.getElementById('couponListModal').style.display = "none";
            if (specModal && e.target == specModal) specModal.style.display = "none";
        }
        document.querySelectorAll('.close').forEach(el => el.onclick = function() { this.closest('.modal').style.display = 'none'; });
    }
});
</script>

<div id="specificationsModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; overflow:auto; background-color:rgba(15,23,42,0.65); backdrop-filter:blur(6px); align-items:center; justify-content:center;">
  <div class="modal-content" style="background:#fff; margin:20px auto; padding:24px 28px; border-radius:16px; width:92%; max-width:780px; max-height:88vh; display:flex; flex-direction:column; box-shadow:0 25px 50px -12px rgba(15,23,42,0.25); border:1px solid #e2e8f0; position:relative;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid #f1f5f9;">
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="font-size:26px; width:48px; height:48px; background:#eff6ff; color:#2563eb; border-radius:12px; display:flex; align-items:center; justify-content:center; border:1px solid #dbeafe; flex-shrink:0;">📑</span>
        <div>
          <h3 id="specModalTitle" style="margin:0; font-size:17px; font-weight:800; color:#0f172a; line-height:1.35;"><%= (typeof product !== 'undefined' && product) ? product.product_name : '' %></h3>
          <div style="font-size:12.5px; color:#64748b; margin-top:3px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span>SKU: <strong style="color:#2563eb;"><%= (typeof product !== 'undefined' && product) ? product.sku : '' %></strong></span>
            <% if (typeof product !== 'undefined' && product && product.warranty) { %>
                <span>• 🛡️ <%= product.warranty.replace(/\s*chính\s*hãng/gi, '').trim() %></span>
            <% } %>
            <% if (typeof product !== 'undefined' && product && product.vat_rate !== null) { %>
                <span>• 📋 VAT: <%= product.vat_rate %>%</span>
            <% } %>
          </div>
        </div>
      </div>
      <span class="close-spec-modal" style="font-size:28px; font-weight:700; color:#94a3b8; cursor:pointer; line-height:1; transition:color 0.15s; margin-left:10px;">&times;</span>
    </div>

    <!-- Modal Body -->
    <div id="specModalBody" style="overflow-y:auto; flex:1; padding-right:6px;">
      <% if (typeof product !== 'undefined' && product && product.specifications && product.specifications.images && product.specifications.images.length > 0) { %>
        <div class="spec-thumb-gallery">
          <% product.specifications.images.forEach(function(imgUrl) { %>
            <img src="<%= imgUrl %>" alt="Product Image" class="spec-thumb-item" onclick="window.open('<%= imgUrl %>', '_blank')" title="Bấm để xem ảnh phóng to">
          <% }); %>
        </div>
      <% } %>

      <div class="spec-modal-controls" style="margin-bottom:12px; position:sticky; top:0; background:#fff; z-index:10; padding:2px 0 6px 0; display:flex; flex-direction:column; gap:8px;">
        <!-- Hàng 1: Tìm kiếm nhanh thông số -->
        <input type="text" id="specFilterInput" placeholder="🔍 Lọc nhanh thông số (CPU, RAM, màn hình, cổng kết nối, pin, card...)" oninput="filterSpecs(this.value)" style="width:100%; box-sizing:border-box; padding:8px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px; outline:none; background:#f8fafc; transition:all 0.2s;" onfocus="this.style.borderColor='#2563eb'; this.style.background='#fff';" onblur="this.style.borderColor='#cbd5e1'; if(!this.value) this.style.background='#f8fafc';">

        <!-- Hàng 2: So sánh cấu hình với SKU khác -->
        <div style="display:flex; align-items:center; gap:8px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:6px 10px;">
          <span style="font-size:12.5px; font-weight:700; color:#1e40af; white-space:nowrap; display:flex; align-items:center; gap:4px;">
            ⚖️ So sánh với SKU:
          </span>
          <input type="text" id="compareSkuInput" placeholder="Nhập mã SKU laptop thứ 2 (vd: 240801234)..." style="flex:1; min-width:120px; padding:6px 10px; border:1px solid #93c5fd; border-radius:6px; font-size:12.5px; outline:none;" onkeydown="if(event.key==='Enter'){event.preventDefault();runCompareSku();}">
          <button type="button" id="btnRunCompare" onclick="runCompareSku()" style="padding:6px 14px; background:#2563eb; color:#fff; border:none; border-radius:6px; font-weight:700; font-size:12px; cursor:pointer; white-space:nowrap; transition:background 0.15s;">
            So sánh
          </button>
          <button type="button" id="btnClearCompare" onclick="clearCompareSku()" style="display:none; padding:6px 10px; background:#e2e8f0; color:#475569; border:none; border-radius:6px; font-weight:600; font-size:12px; cursor:pointer; white-space:nowrap;">
            ✕ Hủy so sánh
          </button>
