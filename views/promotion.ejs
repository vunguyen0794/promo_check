                                    <%= promoPrice > 0 ? new Intl.NumberFormat('vi-VN').format(promoPrice) + ' đ' : (origPrice > 0 ? new Intl.NumberFormat('vi-VN').format(origPrice) + ' đ' : 'Chưa có') %>
                                </span>
                                <span class="price-text-discount <%= discountAmt > 0 ? 'has-saving' : '' %>" id="discountBadge">
                                    <%= discountAmt > 0 ? ('- ' + new Intl.NumberFormat('vi-VN').format(discountAmt) + ' đ') : '0 đ' %>
                                </span>
                            </div>

                            <div class="price-v-sep"></div>

                            <div class="price-cell-orig">
                                <span class="price-text-lbl">Giá gốc:</span>
                                <span class="price-text-val orig <%= discountAmt > 0 ? 'is-slashed' : '' %>" id="priceView">
                                    <%= origPrice > 0 ? new Intl.NumberFormat('vi-VN').format(origPrice) + ' đ' : 'Chưa có' %>
                                </span>
                            </div>
                        </div>

                        <span id="priceEdit" class="price-edit-inline" style="display:none; margin-top:8px;">
                            <input id="priceInput" class="price-edit-field" type="text" value="<%= origPrice ? new Intl.NumberFormat('vi-VN').format(origPrice) : '0' %>">
