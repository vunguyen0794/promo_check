                            </div>
                        </div>

                        <% 
                            const origPrice = Number(product.list_price) || 0;
                            const promoPrice = (product.promo_price && Number(product.promo_price) > 0)
                                ? Number(product.promo_price)
                                : origPrice;
                            const discountAmt = (product.discount_amount && Number(product.discount_amount) > 0)
                                ? Number(product.discount_amount)
                                : Math.max(0, origPrice - promoPrice);
