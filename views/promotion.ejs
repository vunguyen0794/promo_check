    z-index: 5;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}
.mini-stock-badge.out-stock { color: #dc2626; border-color: #fecaca; } /* Hết hàng màu đỏ */

.mini-sku-card { position: relative; } /* Để neo badge tồn */
