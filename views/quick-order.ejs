  function startQoTokenPolling() {
    if (_qoPollingTimer) return;
    _qoPollingCount = 0;
    const btn = document.getElementById('btnQoAutoLogin');
    const s2 = document.getElementById('qoStep2Icon');
    const s3 = document.getElementById('qoStep3Icon');
    const s3Txt = document.getElementById('qoStep3Txt');

    _qoPollingTimer = setInterval(async () => {
      _qoPollingCount++;
      if (_qoPollingCount > 150) {
        clearInterval(_qoPollingTimer);
        _qoPollingTimer = null;
        if (s2) s2.innerHTML = '&#10060;';
        if (s3) s3.innerHTML = '&#10060;';
        if (s3Txt) s3Txt.textContent = 'Hết thời gian chờ!';
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '🚀 Mở ERP &amp; Tự động kết nối Token';
        }
        return;
      }
      try {
        const res = await fetch('/api/quick-export/settings');
        const data = await res.json();
        if (data && data.success && data.settings?.tekoToken) {
          const jwt = getJwtInfo(data.settings.tekoToken);
          if (jwt && !jwt.isExpired) {
            clearInterval(_qoPollingTimer);
            _qoPollingTimer = null;
            if (s2) s2.innerHTML = '&#9745;';
            if (s3) s3.innerHTML = '&#9745;';
            if (s3Txt) s3Txt.textContent = 'Token đã về server!';
            if (btn) {
              btn.innerHTML = '✅ KẾT NỐI THÀNH CÔNG!';
              btn.style.background = '#16a34a';
            }
            localStorage.setItem('qe_teko_token', data.settings.tekoToken);
            validateAndApplyToken(data.settings.tekoToken, false, false);
            setTimeout(() => {
              closeQoTokenModal();
            }, 1200);
          }
        }
      } catch (e) {}
    }, 2000);
  }

  async function pasteTokenFromClipboardQo() {
    try {
      const text = await navigator.clipboard.readText();
      const clean = text.replace(/^Bearer\s+/i, '').trim();
      if (!clean || clean.length < 30) {
        alert('Nội dung trong Clipboard không phải là token hợp lệ!');
        return;
      }
      const jwt = getJwtInfo(clean);
      if (!jwt || jwt.isExpired) {
        alert('Token trong Clipboard không hợp lệ hoặc đã hết hạn!');
        return;
      }
      if (jwt.isVuSub && !isVuUser) {
        alert('⚠️ CẢNH BÁO AN TOÀN:\n\nToken này thuộc về tài khoản Vũ Nguyễn Tuấn! Bạn không thể sử dụng token của người khác.');
        return;
      }
      localStorage.setItem('qe_teko_token', clean);
      fetch('/api/quick-export/sync-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: clean, userId: currentUserId, branchCode: currentBranchCode })
      }).catch(() => {});

      validateAndApplyToken(clean, false, false);
      alert('✅ Đã nhận diện Token SPOS thành công từ Clipboard!');
      closeQoTokenModal();
    } catch (e) {
      alert('Không thể đọc Clipboard: ' + e.message);
    }
  }
