  // ==========================================
  // THÊM & CẬP NHẬT GIỎ HÀNG (REALTIME PROMO & STOCK/BIN)
  // ==========================================
  async function addItemToCart(sku) {
    searchDropdown.style.display = 'none';
    searchInput.value = '';

    // Nếu đã có trong giỏ -> Tăng số lượng
    if (cart[sku]) {
      cart[sku].quantity += 1;
      renderCart();
      return;
    }

    // Nếu chưa có -> Tạo tạm và gọi API lấy chi tiết giá KM & Tồn kho BIN mới nhất
    cart[sku] = {
      sku: sku,
      name: `Đang tải thông tin ${sku}...`,
      listPrice: 0,
      promoPrice: 0,
      discount: 0,
      quantity: 1,
      stockInfo: null,
      _loading: true
    };
    renderCart();

    try {
      const [resProd, resStock] = await Promise.all([
        fetch(`/api/sku/${encodeURIComponent(sku)}/details?branch=${encodeURIComponent(currentBranchCode)}&refresh=1`).then(r => r.json()).catch(() => null),
        fetch(`/api/quick-order/stock-detail?sku=${encodeURIComponent(sku)}&branch=${encodeURIComponent(currentBranchCode)}`).then(r => r.json()).catch(() => null)
      ]);

      if (resStock && resStock.ok && cart[sku]) {
        cart[sku].stockInfo = resStock;
      }

      if (resProd && resProd.ok && resProd.product && cart[sku]) {
        const p = resProd.product;
        const listP = Number(p.list_price) || 0;
        const promoP = (p.promo_price && Number(p.promo_price) > 0) ? Number(p.promo_price) : listP;

        cart[sku].sku = sku;
        cart[sku].name = p.product_name || `Sản phẩm ${sku}`;
        cart[sku].brand = p.brand || '';
        cart[sku].listPrice = listP;
        cart[sku].promoPrice = promoP;
        cart[sku].discount = 0; // Giảm giá xin thêm mặc định là 0
        cart[sku].promotions = p.promotions || [];
        const discountPromo = (p.promotions || []).find(pr => (pr.benefit?.discount?.flat > 0 || pr.benefit?.discount?.percent > 0));
        cart[sku].selectedPromotionId = discountPromo ? discountPromo.id : ((p.promotions && p.promotions.length > 0) ? p.promotions[0].id : null);
        cart[sku].flashSales = p.flash_sales || [];
        cart[sku].marketingPromotions = p.marketing_promotions || [];
        cart[sku].marketing_promotions = p.marketing_promotions || [];
        cart[sku].warranty = p.warranty || '';
        cart[sku].vat_rate = p.vat_rate;
        delete cart[sku]._loading;
      } else {
        if (cart[sku]) {
          cart[sku].name = `Sản phẩm ${sku}`;
          delete cart[sku]._loading;
        }
      }
    } catch (e) {
      console.warn('Lỗi fetch chi tiết SKU & tồn kho:', e);
      if (cart[sku]) {
        cart[sku].name = `Sản phẩm SKU ${sku}`;
        delete cart[sku]._loading;
      }
    }

    renderCart();
  }

  function changeQuantity(sku, delta) {
    if (!cart[sku]) return;
    const newQty = cart[sku].quantity + delta;
    if (newQty <= 0) {
      delete cart[sku];
    } else {
      cart[sku].quantity = newQty;
    }
    renderCart();
  }

  function setQuantity(sku, val) {
    if (!cart[sku]) return;
    const qty = Math.max(1, parseInt(val) || 1);
    cart[sku].quantity = qty;
    renderCart();
  }

  function changeItemDiscount(sku, val) {
    if (!cart[sku]) return;
    cart[sku].discount = Math.max(0, parseFloat(val) || 0);
    renderCart();
  }

  function removeItem(sku) {
    delete cart[sku];
    renderCart();
  }

  function clearCart() {
    if (Object.keys(cart).length === 0) return;
    if (confirm('Bạn có chắc chắn muốn làm trống giỏ hàng?')) {
      for (const k in cart) delete cart[k];
      renderCart();
    }
  }

  // Bóc tách danh sách quà tặng từ CTKM (hỗ trợ cả mảng gifts của Teko và chuỗi ghép nối)
  function extractPromotionGifts(p) {
    if (!p) return [];
    const gifts = [];

    // 1. Nếu p.benefit.gifts là mảng danh sách quà tặng chuẩn từ Teko API
    if (Array.isArray(p.benefit?.gifts) && p.benefit.gifts.length > 0) {
      p.benefit.gifts.forEach(g => {
        const gName = (g.name || '').trim();
        const gSku = String(g.sku || '').trim();
        if (gName || gSku) {
          gifts.push({
            sku: gSku || undefined,
            name: gName || `Quà tặng ${gSku}`,
            quantity: Number(g.quantity) || 1
          });
        }
      });
      if (gifts.length > 0) return gifts;
    }

    // 2. Nếu p.benefit.gift là 1 đối tượng hoặc chuỗi
    if (p.benefit?.gift) {
      if (typeof p.benefit.gift === 'object') {
        const gName = (p.benefit.gift.name || '').trim();
        const gSku = String(p.benefit.gift.sku || '').trim();
        if (gName || gSku) {
          gifts.push({ sku: gSku || undefined, name: gName || `Quà tặng ${gSku}`, quantity: 1 });
        }
      } else if (typeof p.benefit.gift === 'string' && p.benefit.gift.trim()) {
        gifts.push({ name: p.benefit.gift.trim(), quantity: 1 });
      }
      if (gifts.length > 0) return gifts;
    }

    // 3. Nếu p.gift là chuỗi (Marketing promotions)
    const rawGiftStr = typeof p.gift === 'string' ? p.gift.trim() : '';
    if (rawGiftStr) {
      if (rawGiftStr.includes('+')) {
        const parts = rawGiftStr.split('+').map(s => s.trim()).filter(Boolean);
        parts.forEach(part => {
          gifts.push({ name: part, quantity: 1 });
        });
      } else {
        gifts.push({ name: rawGiftStr, quantity: 1 });
      }
      if (gifts.length > 0) return gifts;
    }

    // 4. Nếu trong tên CTKM (p.name hoặc p.description) có cụm từ "tặng bộ quà ... + ..." hoặc "tặng ... + ..."
    const fullName = (p.name || p.description || '').trim();
    const tangMatch = fullName.match(/tặng\s+(?:bộ\s+quà\s+)?([^\(\)]+)/i);
    if (tangMatch && tangMatch[1]) {
      const giftPart = tangMatch[1].trim();
      if (giftPart.includes('+')) {
        const parts = giftPart.split('+').map(s => s.trim().replace(/^[\-\•\*\s]+/, '')).filter(Boolean);
        parts.forEach(part => {
          gifts.push({ name: part, quantity: 1 });
        });
      } else if (giftPart.length > 3 && !/^\d+\s*đ/i.test(giftPart) && !/^giảm/i.test(giftPart)) {
        gifts.push({ name: giftPart, quantity: 1 });
      }
    }

    return gifts;
  }

  // ==========================================
  // RENDER CART & TÍNH TOÁN TỔNG TIỀN
  // ==========================================
  function renderCart() {
    const skus = Object.keys(cart);
    const cartCountEl = document.getElementById('cartCount');
    const emptyStateEl = document.getElementById('cartEmptyState');
    const tableWrapperEl = document.getElementById('cartTableWrapper');
    const tbody = document.getElementById('cartTableBody');
    const btnSubmit = document.getElementById('btnSubmitOrder');

    cartCountEl.textContent = skus.length;

    if (skus.length === 0) {
      emptyStateEl.style.display = 'block';
      tableWrapperEl.style.display = 'none';
      btnSubmit.disabled = true;
      updateSummary(0, 0, 0, 0);
      return;
    }

    emptyStateEl.style.display = 'none';
    tableWrapperEl.style.display = 'block';
    btnSubmit.disabled = false;

    let totalList = 0;
    let totalPromo = 0;
    let totalManual = 0;
    let totalPayable = 0;

    let html = '';
    const giftStockTasks = [];
    skus.forEach((sku) => {
      const it = cart[sku];
      const listP = it.listPrice || 0;
      const promoP = it.promoPrice > 0 ? it.promoPrice : listP;
      const promoD = Math.max(0, listP - promoP);
      const manualD = it.discount || 0;
      const finalP = Math.max(0, promoP - manualD);
      const lineTotal = finalP * it.quantity;

      totalList += listP * it.quantity;
      totalPromo += promoD * it.quantity;
      totalManual += manualD * it.quantity;
      totalPayable += lineTotal;

      const hasStockRow = !!(it.stockInfo || it._loading);

      const branchLabel = it.stockInfo?.branch || currentBranchCode;
      
      // Tập hợp danh sách các CTKM áp dụng chính xác cho sản phẩm này
      const activePromos = [];
      const installmentPromos = [];

      // 1. Duyệt các CTKM từ Teko API (Nguồn chuẩn thời gian thực, có giá trị pháp lý khi tạo đơn)
      if (it.promotions && it.promotions.length > 0) {
        it.promotions.forEach(p => {
          const pName = (p.name || p.description || '').trim();
          if (pName && !activePromos.some(ap => ap.name === pName)) {
            const flatVal = p.benefit?.discount?.flat;
            const maxVal = p.benefit?.discount?.maxAmount;
            const pctVal = p.benefit?.discount?.percent;
            const promoGifts = extractPromotionGifts(p);

            let dText = '';
            if (flatVal && flatVal > 0) {
              dText = `Giảm ${formatNumber(flatVal)}đ`;
            } else if (maxVal && maxVal > 0) {
              dText = `Giảm ${formatNumber(maxVal)}đ`;
            } else if (pctVal && pctVal > 0) {
              dText = `Giảm ${pctVal}%`;
            } else if (it.promotions.length === 1 && promoGifts.length === 0 && promoD > 0) {
              dText = `Giảm ${formatNumber(promoD)}đ`;
            }

            activePromos.push({
              name: pName,
              discountText: dText,
              gifts: promoGifts,
              gift: promoGifts.length > 0 ? promoGifts.map(g => g.name).join(' + ') : '',
              couponCode: (p.coupon || p.benefit?.coupon || '').trim().toUpperCase(),
              fromTeko: true
            });
          }
        });
      }

      // 2. Duyệt các CTKM từ Google Sheets / Supabase (marketingPromotions)
      const mPromos = (it.marketingPromotions || it.marketing_promotions || []);
      if (mPromos.length > 0) {
        const brandStr = ((it.brand || '') + ' ' + (it.name || '')).toUpperCase();
        mPromos.forEach(mp => {
          const mName = (mp.name || '').trim();
          if (!mName) return;
          if (mName.includes('MÁY IN') && !brandStr.includes('MÁY IN')) return;

          const sheetUpper = (mp.sheet || '').toUpperCase();
          const nameUpper = mName.toUpperCase();

          // 2.1. Phân loại Chính sách Trả góp / Hỗ trợ tài chính (Chỉ có trên docs/Google Sheets, không có trên Teko cart API)
          const isInstallment = sheetUpper.includes('GÓP') || nameUpper.includes('TRẢ GÓP') || nameUpper.includes('GÓP 0%') ||
            sheetUpper.includes('HOMECREDIT') || sheetUpper.includes('PAYOO') || sheetUpper.includes('SHINHAN') ||
            nameUpper.includes('MỞ THẺ') || sheetUpper.includes('MỞ THẺ') || nameUpper.includes('VIB') || nameUpper.includes('EVO');

          if (isInstallment) {
            if (!installmentPromos.some(ip => ip.name === mName)) {
              installmentPromos.push({
                name: mName,
                sheet: mp.sheet
              });
            }
            return;
          }

          // 2.2. Khử trùng lặp: Nếu Teko API đã có CTKM tương tự (cùng quà tặng, cùng mã coupon hoặc cùng nội dung hãng), BỎ QUA dòng trùng lặp từ sheet!
          const couponInfo = resolvePromoCouponInfo(mp, brandStr);
          const couponCode = couponInfo ? couponInfo.code : '';
          const giftName = couponInfo ? couponInfo.gift : (mp.gift || '');

          const isDuplicateWithTeko = activePromos.some(ap => {
            // Trùng coupon
            if (couponCode && ap.couponCode === couponCode) return true;

            // Trùng loại quà tặng (ví dụ cả hai đều tặng USB, hoặc cả hai đều tặng Chuột/Ba lô)
            if (giftName && ap.gifts && ap.gifts.length > 0) {
              const cleanG = giftName.toLowerCase().replace(/[\(\[\{].*?[\)\]\}]/g, '').trim();
              if (cleanG.length >= 3 && ap.gifts.some(g => g.name.toLowerCase().includes(cleanG) || cleanG.includes(g.name.toLowerCase()))) {
                return true;
              }
            }

            // Trùng từ khóa tên hãng và danh mục quà (ví dụ "SANDISK" và "USB")
            const apNameUpper = ap.name.toUpperCase();
            if (nameUpper.includes('SANDISK') && apNameUpper.includes('SANDISK') && (nameUpper.includes('USB') || sheetUpper.includes('USB'))) {
              return true;
            }
            if (nameUpper.includes('ASUS') && apNameUpper.includes('ASUS') && ap.gifts && ap.gifts.length > 0 && nameUpper.includes('TẶNG')) {
              return true;
            }

            // Trùng tên
            if (ap.name === mName) return true;

            return false;
          });

          if (isDuplicateWithTeko) {
            return; // Đã có trên Teko API với thông tin chuẩn xác và mã SKU quà tặng thực tế
          }

          const promoGifts = extractPromotionGifts({ ...mp, gift: giftName, name: mName });

          if (!activePromos.some(ap => ap.name === mName)) {
            activePromos.push({
              name: mName,
              discountText: '', // CTKM sheet marketing không tự động gán tiền giảm nếu không có voucher
              gifts: promoGifts,
              gift: promoGifts.length > 0 ? promoGifts.map(g => g.name).join(' + ') : (giftName || ''),
              couponCode: couponCode,
              fromTeko: false
            });
          }
        });
      }

      if (activePromos.length === 0 && promoD > 0) {
        activePromos.push({
          name: `CTKM ${branchLabel}`,
          discountText: `Giảm ${formatNumber(promoD)}đ`,
          gifts: [],
          gift: '',
          couponCode: ''
        });
      }

      html += `
        <tr class="qo-cart-item-row ${hasStockRow ? 'has-stock-row' : ''}">
          <td style="padding: 12px 14px 8px 14px;">
            <div class="qo-cart-product-title">${escapeHtml(it.name)}</div>
            <div class="qo-cart-product-meta">
              <span class="qo-sku-badge">${sku}</span>
              ${it.warranty ? `<span>• BH: ${escapeHtml(it.warranty)}</span>` : ''}
            </div>
            ${activePromos.length > 0 ? `
              <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 6px;">
                ${activePromos.map((pr, prIdx) => {
                  if (pr.gifts && pr.gifts.length > 0) {
                    pr.gifts.forEach((g, gIdx) => {
                      const targetGiftId = `giftStock_${sku}_${prIdx}_${gIdx}`;
                      giftStockTasks.push({
                        giftName: g.name,
                        giftSku: g.sku,
                        sku: sku,
                        targetId: targetGiftId
                      });
                    });
                  } else if (pr.gift) {
                    const targetGiftId = `giftStock_${sku}_${prIdx}_0`;
                    giftStockTasks.push({
                      giftName: pr.gift,
                      sku: sku,
                      targetId: targetGiftId
                    });
                  }

                  return `
                  <div class="qo-promo-banner" title="${escapeHtml(pr.name)}">
                    <!-- Hàng trên: 2 cột (Trái: Tên CTKM, Phải: Mã giảm / Nút áp mã) -->
                    <div class="qo-promo-banner-header">
                      <div class="qo-promo-banner-left">
                        <span class="qo-promo-banner-icon">🎁</span>
                        <div class="qo-promo-banner-name">${escapeHtml(pr.name)}</div>
                      </div>
                      <div class="qo-promo-banner-right">
                        ${pr.discountText ? `
                          <span class="qo-promo-banner-tag">${escapeHtml(pr.discountText)}</span>
                        ` : ''}
                        ${!pr.couponCode && pr.discountText ? `
                          <span class="qo-promo-applied-badge" style="background: #ecfdf5; color: #047857; border-color: #a7f3d0; font-weight: 600;">✓ Tự động giảm giá đơn</span>
                        ` : ''}
                        ${!pr.couponCode && !pr.discountText && ((pr.gifts && pr.gifts.length > 0) || pr.gift) ? `
                          <span class="qo-promo-applied-badge" style="background: #f0fdf4; color: #166534; border-color: #bbf7d0; font-weight: 600;">✓ Quà tặng kèm đơn</span>
                        ` : ''}
                        ${pr.couponCode ? `
                          ${appliedVoucher && appliedVoucher.code === pr.couponCode ? `
                            <span class="qo-promo-applied-badge">✓ Đã áp mã ${escapeHtml(pr.couponCode)}</span>
                          ` : `
                            <button type="button" class="qo-btn-apply-coupon-inline" onclick="applySuggestedVoucher('${escapeHtml(pr.couponCode)}')" title="Nhấn để áp dụng mã giảm giá này">
                              🎟️ Áp mã: ${escapeHtml(pr.couponCode)}
                            </button>
                          `}
                        ` : ''}
                      </div>
                    </div>

                    <!-- Hàng dưới: Bóc tách từng món quà tặng & tra cứu tồn/bin -->
                    ${pr.gifts && pr.gifts.length > 0 ? `
                      <div class="qo-promo-banner-bottom" style="gap: 6px;">
                        ${pr.gifts.map((g, gIdx) => {
                          const targetGiftId = `giftStock_${sku}_${prIdx}_${gIdx}`;
                          return `
                            <div class="qo-promo-gift-item" style="display: flex; flex-direction: column; gap: 2px; padding: 3px 0; ${gIdx > 0 ? 'border-top: 1px dotted #f1f5f9;' : ''}">
                              <div class="qo-promo-banner-gift">
                                🎁 Quà tặng ${pr.gifts.length > 1 ? `#${gIdx + 1}:` : ':'} 
                                <strong>${escapeHtml(g.name)}</strong>
                                ${g.quantity > 1 ? `<span style="color: #64748b; font-size: 11px;"> (SL: ${g.quantity})</span>` : ''}
                              </div>
                              <div class="qo-promo-gift-stock-wrap" id="${targetGiftId}">
                                <span class="qo-gift-stock-loading">⏳ Đang tra cứu tồn quà tặng...</span>
                              </div>
                            </div>
                          `;
                        }).join('')}
                      </div>
                    ` : (pr.gift ? `
                      <div class="qo-promo-banner-bottom">
                        <div class="qo-promo-banner-gift">Quà tặng: <strong>${escapeHtml(pr.gift)}</strong></div>
                        <div class="qo-promo-gift-stock-wrap" id="giftStock_${sku}_${prIdx}_0">
                          <span class="qo-gift-stock-loading">⏳ Đang tra cứu tồn quà tặng...</span>
                        </div>
                      </div>
                    ` : '')}
                  </div>
                `;
                }).join('')}
              </div>
            ` : ''}
            ${installmentPromos.length > 0 ? `
              <div style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px;">
                ${installmentPromos.map(ip => `
                  <div class="qo-installment-badge" title="Chính sách trả góp qua đối tác tài chính">
                    <span style="font-size: 11px;">💳</span>
                    <span style="font-weight: 600;">${escapeHtml(ip.name)}</span>
                  </div>
                `).join('')}
              </div>
            ` : ''}
          </td>
          <td style="text-align: right;">
            <div style="font-weight: 700; color: #1e293b;">${formatNumber(promoP)}</div>
            ${promoD > 0 ? `
              <div style="font-size: 10.5px; color: #94a3b8; text-decoration: line-through;">${formatNumber(listP)}</div>
              <div style="margin-top: 3px;">
                <span class="qo-promo-pill">-${Math.round((promoD / listP) * 100)}%</span>
              </div>
            ` : ''}
          </td>
          <td style="text-align: center;">
            <div class="qo-qty-ctrl">
              <button type="button" class="qo-qty-btn" onclick="changeQuantity('${sku}', -1)">-</button>
              <input type="number" class="qo-qty-input" value="${it.quantity}" min="1" 
                     onchange="setQuantity('${sku}', this.value)">
              <button type="button" class="qo-qty-btn" onclick="changeQuantity('${sku}', 1)">+</button>
            </div>
          </td>
          <td style="text-align: right;">
            <input type="number" class="qo-discount-input" value="${it.discount}" min="0" step="1000"
                   placeholder="0" onchange="changeItemDiscount('${sku}', this.value)"
                   title="Chiết khấu riêng cho từng món">
          </td>
          <td style="text-align: right; font-weight: 800; color: #15803d; font-size: 14px;">
            ${formatNumber(lineTotal)}
          </td>
          <td style="text-align: center;">
            <button type="button" class="qo-btn-del" title="Xóa món này" onclick="removeItem('${sku}')">×</button>
          </td>
        </tr>
        ${it.stockInfo ? `
        <tr class="qo-cart-stock-row">
          <td colspan="6">
            <div class="qo-cart-stock-badge ${it.stockInfo.quantity > 0 ? 'in-stock' : 'out-stock'}">
              <span>Tồn <strong>${escapeHtml(it.stockInfo.branch)}</strong>: <strong style="color: ${it.stockInfo.quantity > 0 ? '#15803d' : '#dc2626'};">${it.stockInfo.quantity}</strong></span>
              <span class="qo-stock-sep">|</span>
              <span>Bin tồn: <strong style="color: #475569;">${escapeHtml((it.stockInfo.binText || 'Chưa phân bin').replace(/\s*cái\b/gi, ''))}</strong></span>
            </div>
          </td>
        </tr>
        ` : (it._loading ? `
        <tr class="qo-cart-stock-row">
          <td colspan="6">
            <div class="qo-cart-stock-badge loading-stock">
              <span>Đang kiểm tra tồn kho & bin...</span>
            </div>
          </td>
        </tr>
        ` : '')}
      `;
    });

    tbody.innerHTML = html;
    updateSummary(totalList, totalPromo, totalManual, totalPayable);
    refreshVoucherSuggestions();

    // Tra cứu và hiển thị tồn kho quà tặng theo chi nhánh
    giftStockTasks.forEach(task => {
      loadGiftStock(task.giftName, task.giftSku, task.sku, currentBranchCode, task.targetId);
    });
  }

  // ==========================================
  // TRA CỨU TỒN KHO QUÀ TẶNG (GIFT STOCK)
  // ==========================================
  const giftStockCache = {};

  async function loadGiftStock(giftName, giftSku, parentSku, branch, targetId) {
    const el = document.getElementById(targetId);
    if (!el) return;

    const cacheKey = `${parentSku}_${giftSku || ''}_${giftName}_${branch}`;
    if (giftStockCache[cacheKey]) {
      renderGiftStockHtml(el, giftStockCache[cacheKey]);
      return;
    }

    try {
      let url = `/api/quick-order/gift-stock?sku=${encodeURIComponent(parentSku)}&branch=${encodeURIComponent(branch)}`;
      if (giftSku) url += `&giftSku=${encodeURIComponent(giftSku)}`;
      if (giftName) url += `&giftName=${encodeURIComponent(giftName)}`;

      const res = await fetch(url).then(r => r.json());
      if (res && res.ok && res.found) {
        giftStockCache[cacheKey] = res;
        renderGiftStockHtml(el, res);
      } else {
        el.innerHTML = `
          <div class="qo-promo-gift-stock-badge" style="color: #64748b; background: #f8fafc; border-color: #e2e8f0;">
            <span>Chưa tìm thấy mã tồn kho cho quà tặng này</span>
          </div>
        `;
      }
    } catch (e) {
      console.warn('Lỗi tra cứu tồn quà tặng:', e);
      el.innerHTML = '';
    }
  }

  function renderGiftStockHtml(el, data) {
    if (!el || !data) return;
    const isOut = (Number(data.quantity) || 0) <= 0;
    el.innerHTML = `
      <div class="qo-promo-gift-stock-badge">
        <span class="qo-gift-sku-tag">${escapeHtml(data.sku)}</span>
        <span class="qo-stock-sep">|</span>
        <span class="qo-gift-name-tag">${escapeHtml(data.product_name)}</span>
        <span class="qo-stock-sep">|</span>
        <span>Tồn <strong>${escapeHtml(data.branch)}</strong>: <strong style="color: ${isOut ? '#dc2626' : '#15803d'}; font-weight: 800;">${data.quantity}</strong></span>
        <span class="qo-stock-sep">|</span>
        <span>Bin tồn: <strong style="color: #475569;">${escapeHtml(data.binText || 'Chưa phân bin')}</strong></span>
      </div>
    `;
  }

  // ==========================================
  // XỬ LÝ MÃ GIẢM GIÁ / VOUCHER / QUÀ TẶNG CTKM
  // ==========================================
  let appliedVoucher = null;

  function resolvePromoCouponInfo(mp, brandStr) {
    if (!mp) return null;
    const directCoupon = (mp.coupon || mp.online_coupon || '').trim().toUpperCase();
    if (directCoupon) {
      return {
        code: directCoupon,
        gift: mp.gift || mp.gift_name || ''
      };
    }
    const nameUpper = (mp.name || mp.program_name || '').toUpperCase();
    const sheetUpper = (mp.sheet || mp.sheet_name || '').toUpperCase();
    const giftName = mp.gift || mp.gift_name || '';

    // BỘ QUÀ LAPTOP: Chỉ khi tên CTKM hoặc sheet chứa "BỘ QUÀ" hoặc có quà tặng phần cứng laptop
    const isBoQua = nameUpper.includes('BỘ QUÀ') || sheetUpper.includes('BỘ QUÀ') || !!giftName;
    if (isBoQua) {
      let code = '';
      if (brandStr.includes('ACER')) code = 'PVACERBQ260701';
      else if (brandStr.includes('ASUS')) code = 'PVASUSBQ260701';
      else if (brandStr.includes('MSI')) code = 'PVMSIBQ260701';
      else if (brandStr.includes('LENOVO')) code = 'PVLENOVOBQ260701';
      else if (brandStr.includes('HP')) code = 'PVHPBQ260701';
      else if (brandStr.includes('DELL')) code = 'PVDELLBQ260701';

      if (code) {
        return {
          code: code,
          gift: giftName || 'Ba lô Acer (Quà tặng)'
        };
      }
    }
    return null;
  }

  function refreshVoucherSuggestions() {
    const hintBtn = document.getElementById('voucherHintBtn');
    const countEl = document.getElementById('voucherSuggestionCount');
    const listEl = document.getElementById('voucherSuggestionList');
    const box = document.getElementById('voucherSuggestionBox');
    if (!hintBtn || !listEl) return;

    const suggestions = [];
    Object.values(cart).forEach(it => {
      const brandStr = ((it.brand || '') + ' ' + (it.name || '')).toUpperCase();
      const mPromos = (it.marketingPromotions || it.marketing_promotions || []);
      
      mPromos.forEach(mp => {
        const mName = (mp.name || '').trim();
        if (!mName) return;
        if (mName.includes('MÁY IN') && !brandStr.includes('MÁY IN')) return;

        // Chỉ gợi ý nếu chương trình này THỰC SỰ cần mã coupon
        const couponInfo = resolvePromoCouponInfo(mp, brandStr);
        if (couponInfo && couponInfo.code) {
          if (!suggestions.some(s => s.code === couponInfo.code)) {
            suggestions.push({
              code: couponInfo.code,
              name: mp.name,
              gift: couponInfo.gift || mp.gift || 'Quà tặng khuyến mãi',
              sku: it.sku
            });
          }
        }
      });

      const tPromos = (it.promotions || []);
      tPromos.forEach(tp => {
        const cCode = (tp.coupon || (tp.benefit && tp.benefit.coupon) || '').trim().toUpperCase();
        if (cCode && !suggestions.some(s => s.code === cCode)) {
          const tpGifts = extractPromotionGifts(tp);
          suggestions.push({
            code: cCode,
            name: tp.name || tp.description || 'Ưu đãi mã giảm giá',
            gift: tpGifts.length > 0 ? tpGifts.map(g => g.name).join(' + ') : '',
            sku: it.sku
          });
        }
      });
    });

    if (suggestions.length > 0) {
      countEl.textContent = suggestions.length;
      hintBtn.style.display = 'inline-flex';
      listEl.innerHTML = suggestions.map(s => `
        <div class="voucher-suggestion-item">
          <div style="font-size: 11.5px; line-height: 1.4; min-width: 0; flex: 1;">
            <div style="font-weight: 700; color: #9a3412;">🎁 ${escapeHtml(s.name)}</div>
            ${s.gift ? `<div style="color: #2563eb; font-weight: 600; font-size: 11px;">Quà tặng: ${escapeHtml(s.gift)}</div>` : ''}
            <div style="color: #475569; font-size: 11px; margin-top: 2px;">Mã khả dụng: <strong style="color: #dc2626; font-family: monospace; font-size: 11.5px; background: #fef2f2; padding: 1px 5px; border-radius: 4px; border: 1px solid #fecaca;">${escapeHtml(s.code)}</strong></div>
          </div>
          <button type="button" class="btn-use-voucher" onclick="applySuggestedVoucher('${escapeHtml(s.code)}')">Áp dụng mã</button>
        </div>
      `).join('');
      if (box && !appliedVoucher) {
        box.style.display = 'block';
      }
    } else {
      hintBtn.style.display = 'none';
      if (box) box.style.display = 'none';
    }
  }

  function toggleVoucherSuggestions() {
    const box = document.getElementById('voucherSuggestionBox');
    if (box) {
      box.style.display = (box.style.display === 'none' || !box.style.display) ? 'block' : 'none';
    }
  }

  function applySuggestedVoucher(code) {
    const input = document.getElementById('voucherCodeInput');
    if (input) input.value = code;
    applyVoucherCode();
  }

  function applyVoucherCode(customGift, customName) {
    const input = document.getElementById('voucherCodeInput');
    const code = (input ? input.value : '').trim().toUpperCase();
    if (!code) {
      alert('Vui lòng nhập mã giảm giá / voucher!');
      return;
    }

    let gift = customGift || '';
    let desc = customName || `Áp dụng mã ${code}`;

    if (!gift) {
      Object.values(cart).forEach(it => {
        const brandStr = ((it.brand || '') + ' ' + (it.name || '')).toUpperCase();
        const mPromos = (it.marketingPromotions || it.marketing_promotions || []);
        mPromos.forEach(mp => {
          const couponInfo = resolvePromoCouponInfo(mp, brandStr);
          if (couponInfo && couponInfo.code === code) {
            gift = couponInfo.gift || mp.gift || '';
            desc = mp.name || desc;
          }
        });
        const tPromos = (it.promotions || []);
        tPromos.forEach(tp => {
          const cCode = (tp.coupon || (tp.benefit && tp.benefit.coupon) || '').trim().toUpperCase();
          if (cCode === code) {
            const tpGifts = extractPromotionGifts(tp);
            gift = tpGifts.length > 0 ? tpGifts.map(g => g.name).join(' + ') : '';
            desc = tp.name || tp.description || desc;
          }
        });
      });
      if (!gift && (code.includes('ACER') || code.includes('BQ'))) {
        gift = 'Ba lô Acer (Quà tặng)';
        desc = 'ƯU ĐÃI BỘ QUÀ LAPTOP ĐẾN 3 TRIỆU Q3\'2026';
      }
    }

    appliedVoucher = {
      code,
      desc,
      gift: gift || 'Ưu đãi khuyến mãi theo mã',
      discount: 0
    };

    const tag = document.getElementById('appliedVoucherTag');
    if (tag) {
      tag.style.display = 'flex';
      document.getElementById('appliedVoucherCode').textContent = code;
      document.getElementById('appliedVoucherDesc').textContent = appliedVoucher.gift ? `Quà tặng: ${appliedVoucher.gift}` : desc;
    }

    const sugBox = document.getElementById('voucherSuggestionBox');
    if (sugBox) sugBox.style.display = 'none';

    renderCart();
  }

  window.applySuggestedVoucher = applySuggestedVoucher;
  window.applyVoucherCode = applyVoucherCode;
  window.toggleVoucherSuggestions = toggleVoucherSuggestions;

  function removeVoucherCode() {
    appliedVoucher = null;
    const tag = document.getElementById('appliedVoucherTag');
    if (tag) tag.style.display = 'none';
    const input = document.getElementById('voucherCodeInput');
    if (input) input.value = '';
    renderCart();
  }

  function updateSummary(list, promo, manual, finalPay) {
    document.getElementById('sumListPrice').textContent = formatVND(list);
    document.getElementById('sumPromoDisc').textContent = '-' + formatVND(promo);
    document.getElementById('sumManualDisc').textContent = '-' + formatVND(manual);

    const rowVoucherDisc = document.getElementById('rowVoucherDisc');
    const sumVoucherDisc = document.getElementById('sumVoucherDisc');
    const voucherDisc = (appliedVoucher && appliedVoucher.discount > 0) ? appliedVoucher.discount : 0;
    if (rowVoucherDisc && sumVoucherDisc) {
      if (voucherDisc > 0) {
        rowVoucherDisc.style.display = 'flex';
        sumVoucherDisc.textContent = '-' + formatVND(voucherDisc);
      } else {
        rowVoucherDisc.style.display = 'none';
      }
    }

    const rowGift = document.getElementById('rowGiftItem');
    const giftEl = document.getElementById('sumGiftItem');
    if (rowGift && giftEl) {
      if (appliedVoucher && appliedVoucher.gift) {
        rowGift.style.display = 'flex';
        giftEl.textContent = appliedVoucher.gift;
      } else {
        rowGift.style.display = 'none';
      }
    }

    const payable = Math.max(0, finalPay - voucherDisc);
    document.getElementById('sumFinalPayable').textContent = formatVND(payable);
  }

  // ==========================================
  // HÌNH THỨC NHẬN HÀNG (DELIVERY TYPE)
  // ==========================================
  function switchDeliveryType(type) {
    currentDeliveryType = type;
    const tabPickup = document.getElementById('tabPickup');
    const tabDelivery = document.getElementById('tabDelivery');
    const boxShowroom = document.getElementById('boxShowroomInfo');
    const boxDelivery = document.getElementById('boxDeliveryAddress');

    if (type === 'SHOWROOM') {
      tabPickup.classList.add('active');
      tabDelivery.classList.remove('active');
      boxShowroom.style.display = 'block';
      boxDelivery.style.display = 'none';
    } else {
      tabPickup.classList.remove('active');
      tabDelivery.classList.add('active');
      boxShowroom.style.display = 'none';
      boxDelivery.style.display = 'block';
      document.getElementById('deliveryAddressInput').focus();
    }
  }

  // ==========================================
  // SUBMIT TẠO ĐƠN HÀNG
  // ==========================================
  async function submitQuickOrder() {
    const custName = document.getElementById('custName').value.trim();
    const custPhone = document.getElementById('custPhone').value.trim();
    const orderNote = document.getElementById('orderNote').value.trim();
    const skus = Object.keys(cart);

    if (skus.length === 0) {
      alert('Vui lòng thêm ít nhất một sản phẩm vào giỏ hàng.');
      searchInput.focus();
      return;
    }

    if (!custName) {
      alert('Vui lòng nhập Tên khách hàng.');
      document.getElementById('custName').focus();
      return;
    }

    if (!custPhone || custPhone.length < 9) {
      alert('Vui lòng nhập Số điện thoại hợp lệ của khách hàng.');
      document.getElementById('custPhone').focus();
      return;
    }

    let deliveryAddress = '';
    if (currentDeliveryType === 'DELIVERY') {
      deliveryAddress = document.getElementById('deliveryAddressInput').value.trim();
      if (!deliveryAddress) {
        alert('Vui lòng nhập Địa chỉ giao hàng khi chọn hình thức Giao tận nơi.');
        document.getElementById('deliveryAddressInput').focus();
        return;
      }
    }

    const btnSubmit = document.getElementById('btnSubmitOrder');
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<span>⏳ Đang tạo đơn...</span>';

    // Chỉ giữ ghi chú thực tế do người dùng nhập (không tự gán mã KM vào ghi chú)
    const finalNote = orderNote || '';

    const orderPayload = {
      customer: {
        name: custName,
        phone: custPhone
      },
      delivery: {
        type: currentDeliveryType,
        useShowroomAddress: currentDeliveryType === 'SHOWROOM',
        address: deliveryAddress
      },
      items: skus.map(s => ({
        sku: s,
        name: cart[s].name,
        quantity: cart[s].quantity,
        listPrice: cart[s].listPrice,
        promoPrice: cart[s].promoPrice,
        discount: cart[s].discount,
        promotionId: cart[s].selectedPromotionId || (cart[s].promotions && cart[s].promotions.find(pr => (pr.benefit?.discount?.flat > 0 || pr.benefit?.discount?.percent > 0))?.id) || (cart[s].promotions?.[0]?.id) || undefined
      })),
      voucherCode: appliedVoucher ? appliedVoucher.code : (document.getElementById('voucherCodeInput').value.trim() || undefined),
      appliedPromo: appliedVoucher || null,
      note: finalNote,
      paymentMethod: selectedPaymentMethod,
      branchCode: currentBranchCode
    };

    try {
      tekoToken = localStorage.getItem('qe_teko_token') || '';
      const jwt = getJwtInfo(tekoToken);
      if (!tekoToken || (jwt && jwt.isExpired)) {
        const proceed = confirm('⚠️ Chú ý: Phiên kết nối SPOS của bạn chưa có hoặc đã hết hạn.\n\nĐể đơn hàng xuất hiện trong tab "Đang xử lý" trên app SPOS của bạn, bạn nên mở ERP để Extension đồng bộ token trước.\n\nBấm "Cancel" để dừng lại mở ERP, hoặc "OK" để tiếp tục tạo đơn.');
        if (!proceed) {
          openQoTokenModal();
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = '<span>Tạo đơn</span>';
          return;
        }
      }

      const res = await fetch('/api/quick-order/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-teko-token': tekoToken
        },
        body: JSON.stringify(orderPayload)
      });
      const data = await res.json();

      if (data && data.ok) {
        latestCreatedOrderCode = data.orderCode;
        showSuccessModal(data);
        saveToRecentOrders(data.orderData || {
          orderCode: data.orderCode,
          customer: { name: custName, phone: custPhone },
          pricing: { totalPayable: data.totalPayable },
          paymentMethod: selectedPaymentMethod,
          paymentMethodLabel: paymentMethodLabels[selectedPaymentMethod],
          createdAt: new Date().toISOString()
        });
      } else {
        alert('Không thể tạo đơn: ' + (data.error || 'Lỗi không xác định.'));
      }
    } catch (err) {
      alert('Lỗi kết nối khi tạo đơn hàng: ' + err.message);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = '<span>Tạo đơn</span>';
    }
  }

  // ==========================================
  // SUCCESS MODAL & BARCODE GENERATOR
  // ==========================================
  function showSuccessModal(data) {
    const code = String(data.orderCode || '').replace(/^#/, '');
    const displayCode = `#${code}`;
    latestCreatedOrderCode = code;

    document.getElementById('modalOrderCode').textContent = displayCode;
    document.getElementById('modalCustName').textContent = data.orderData?.customer?.name || document.getElementById('custName').value || 'Khách lẻ';
    document.getElementById('modalCustPhone').textContent = data.orderData?.customer?.phone || document.getElementById('custPhone').value || '---';
    document.getElementById('modalTotalPayable').textContent = formatVND(data.totalPayable);

    const chosenPm = data.paymentMethod || data.orderData?.paymentMethod || selectedPaymentMethod;
    const pmLabel = data.orderData?.paymentMethodLabel || paymentMethodLabels[chosenPm] || 'Tiền mặt';
    const modalPmEl = document.getElementById('modalPaymentMethod');
    if (modalPmEl) modalPmEl.textContent = pmLabel;

    const bCode = data.orderData?.branchCode || currentBranchCode;
    const bConfig = branchConfigMap[bCode] || branchConfigMap['DEFAULT'] || {};
    const bName = bConfig.name || bCode;
    const modalBranchEl = document.getElementById('modalBranchInfo');
    if (modalBranchEl) modalBranchEl.textContent = `${bCode} - ${bName}`;

    // Link mở đơn trên ERP Phong Vũ (Chi tiết đơn hàng Marketplace: https://erp.phongvu.vn/orders/marketplace/{orderCode})
    const erpLinkEl = document.getElementById('modalErpLink');
    if (erpLinkEl) {
      const targetOrderCode = data.orderCode || '';
      erpLinkEl.href = targetOrderCode ? `https://erp.phongvu.vn/orders/marketplace/${encodeURIComponent(targetOrderCode)}` : `https://erp.phongvu.vn/orders/marketplace`;
      const linkTextEl = document.getElementById('modalErpLinkText');
      if (linkTextEl) {
        linkTextEl.textContent = targetOrderCode ? `[Chi tiết đơn hàng #${targetOrderCode}]` : '[Chi tiết đơn hàng]';
      }
    }

    // Hiển thị VietQR hoặc Banner tương ứng phương thức thanh toán
    const qrBox = document.getElementById('modalVietQrBox');
    const bannerBox = document.getElementById('modalPaymentBanner');
    const bannerIcon = document.getElementById('modalPmBannerIcon');
    const bannerText = document.getElementById('modalPmBannerText');

    if (chosenPm === 'BANK_TRANSFER') {
      if (qrBox) qrBox.style.display = 'block';
      if (bannerBox) bannerBox.style.display = 'none';

      const bankAcc = bConfig.bankAccount || '18PVSFI';
      const bankHolder = bConfig.bankHolder || 'CTY CO PHAN THUONG MAI DV PHONG VU';
      const bankName = bConfig.bankName || 'VietinBank (Chi nhánh 2 TP.HCM)';

      const bankNameEl = document.getElementById('modalBankName');
      if (bankNameEl) bankNameEl.textContent = bankName;
      const bankAccEl = document.getElementById('modalBankAcc');
      if (bankAccEl) bankAccEl.textContent = bankAcc;
      const bankHolderEl = document.getElementById('modalBankHolder');
      if (bankHolderEl) bankHolderEl.textContent = bankHolder;
      const qrAmountEl = document.getElementById('modalQrAmount');
      if (qrAmountEl) qrAmountEl.textContent = formatVND(data.totalPayable);
      const qrContentEl = document.getElementById('modalQrContent');
      if (qrContentEl) qrContentEl.textContent = code;

      // URL ảnh VietQR chuẩn
      const qrUrl = `https://img.vietqr.io/image/ICB-${encodeURIComponent(bankAcc)}-compact2.jpg?amount=${Number(data.totalPayable || 0)}&addInfo=${encodeURIComponent(code)}&accountName=${encodeURIComponent(bankHolder)}`;
      const qrImg = document.getElementById('modalVietQrImg');
      if (qrImg) qrImg.src = qrUrl;
    } else {
      if (qrBox) qrBox.style.display = 'none';
      if (bannerBox) {
        bannerBox.style.display = 'flex';
        bannerBox.className = 'qo-pm-banner';
        if (chosenPm === 'CASH') {
          bannerBox.classList.add('cash');
          if (bannerIcon) bannerIcon.textContent = '💵';
          if (bannerText) {
            bannerText.innerHTML = `<strong>Tiền mặt tại quầy:</strong> Đã ghi nhận PTTT vào đơn. Vui lòng thu đúng <strong>${formatVND(data.totalPayable)}</strong> và bấm xác nhận trên SPOS.`;
          }
        } else if (chosenPm === 'CARD') {
          bannerBox.classList.add('card');
          if (bannerIcon) bannerIcon.textContent = '💳';
          if (bannerText) {
            bannerText.innerHTML = `<strong>Quẹt thẻ SmartPOS:</strong> Đã ghi nhận PTTT vào đơn. Mở đơn trên máy quầy/app SPOS chọn <strong>Quẹt thẻ</strong> số tiền <strong>${formatVND(data.totalPayable)}</strong> để in phiếu.`;
          }
        } else {
          bannerBox.classList.add('cod');
          if (bannerIcon) bannerIcon.textContent = '📦';
          if (bannerText) {
            bannerText.innerHTML = `<strong>Thanh toán khi nhận hàng (COD):</strong> Đã gán thu hộ <strong>${formatVND(data.totalPayable)}</strong> khi giao hàng tận nơi.`;
          }
        }
      }
    }

    // Sinh Barcode Code128 bằng JsBarcode (chỉ lấy chuỗi số, không lấy ký tự #)
    try {
      JsBarcode('#barcodeCanvas', code, {
        format: 'CODE128',
        lineColor: '#0f172a',
        width: 2.2,
        height: 50,
        displayValue: true,
        fontSize: 14,
        margin: 4
      });
    } catch (e) {
      console.warn('Lỗi vẽ barcode:', e);
    }

    document.getElementById('copyBtnText').textContent = 'Sao chép mã đơn';
    document.getElementById('orderSuccessModal').classList.add('active');
  }

  function copyText(text, label) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      alert(`Đã sao chép ${label || 'nội dung'}: ${text}`);
    }).catch(() => {});
  }

  function closeSuccessModal() {
    document.getElementById('orderSuccessModal').classList.remove('active');
  }

  function startNewOrder() {
    closeSuccessModal();
    // Làm mới giỏ và form
    for (const k in cart) delete cart[k];
    renderCart();
    document.getElementById('custName').value = '';
    document.getElementById('custPhone').value = '';
    document.getElementById('orderNote').value = '';
    document.getElementById('deliveryAddressInput').value = '';
    switchDeliveryType('SHOWROOM');
    selectPaymentMethod('COD');
    searchInput.focus();
  }

  function copyOrderCode() {
    if (!latestCreatedOrderCode) return;
    const clean = String(latestCreatedOrderCode).replace(/^#/, '');
    navigator.clipboard.writeText(clean).then(() => {
      document.getElementById('copyBtnText').textContent = 'Đã sao chép!';
      setTimeout(() => {
        document.getElementById('copyBtnText').textContent = 'Sao chép mã đơn';
      }, 2500);
    });
  }

  // ==========================================
  // LỊCH SỬ ĐƠN HÀNG GẦN ĐÂY
  // ==========================================
  function saveToRecentOrders(order) {
    recentOrders.unshift(order);
    if (recentOrders.length > 20) recentOrders.pop();
    try {
      localStorage.setItem('qo_recent_orders_' + currentUserId, JSON.stringify(recentOrders));
    } catch (e) {}
    renderRecentOrders();
  }

  function loadRecentOrders() {
    try {
      const stored = localStorage.getItem('qo_recent_orders_' + currentUserId);
      if (stored) {
        recentOrders = JSON.parse(stored) || [];
      }
    } catch (e) {
      recentOrders = [];
    }
    renderRecentOrders();
  }

  function renderRecentOrders() {
    const wrapper = document.getElementById('recentOrdersWrapper');
    const empty = document.getElementById('recentOrdersEmpty');
    const tbody = document.getElementById('recentOrdersBody');

    if (recentOrders.length === 0) {
      wrapper.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    wrapper.style.display = 'block';
    empty.style.display = 'none';

    let html = '';
    recentOrders.forEach((o) => {
      const timeStr = new Date(o.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
      const cleanCode = String(o.orderCode || '').replace(/^#/, '');
      const pmLabel = o.paymentMethodLabel || paymentMethodLabels[o.paymentMethod] || '📦 COD';
      html += `
        <tr>
          <td>
            <strong style="font-family: var(--qo-mono); color: #1d4ed8;">#${cleanCode}</strong>
            <span style="display: block; font-size: 11px; color: #166534; font-weight: 600;">Đang xử lý</span>
          </td>
          <td>${escapeHtml(o.customer?.name || 'Khách lẻ')}</td>
          <td>${escapeHtml(o.customer?.phone || '')}</td>
          <td>
            <span style="font-size: 11px; font-weight: 600; color: #1e40af; background: #eff6ff; padding: 2px 6px; border-radius: 4px; border: 1px solid #bfdbfe;">
              ${escapeHtml(pmLabel)}
            </span>
          </td>
          <td style="text-align: right; font-weight: 700; color: #15803d;">${formatVND(o.pricing?.totalPayable || 0)}</td>
          <td style="color: #64748b;">${timeStr}</td>
          <td style="text-align: center;">
            <button type="button" class="qo-btn-copy" style="margin: 0; padding: 3px 8px;" 
                    onclick="copySpecificCode('${cleanCode}')">Copy</button>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = html;
  }

  function copySpecificCode(code) {
    navigator.clipboard.writeText(code).then(() => {
      alert(`Đã sao chép mã đơn: ${code}`);
    });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Khởi tạo giao diện ban đầu
  onBranchChange(currentBranchCode);
  renderCart();
  loadRecentOrders();
</script>
