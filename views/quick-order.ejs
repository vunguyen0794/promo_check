<script>
  // ==========================================
  // STATE MANAGEMENT
  // ==========================================
  const branchConfigMap = <%- JSON.stringify(branches) %>;
  let currentBranchCode = localStorage.getItem('qo_selected_branch') || '<%= branchCode %>';
  if (!branchConfigMap[currentBranchCode]) {
    currentBranchCode = '<%= branchCode %>';
  }

  function onBranchChange(code) {
    if (!code || !branchConfigMap[code]) return;
    currentBranchCode = code;
    localStorage.setItem('qo_selected_branch', code);

    // Đồng bộ giá trị 2 thẻ select
    const sel1 = document.getElementById('branchSelect');
    if (sel1 && sel1.value !== code) sel1.value = code;
    const sel2 = document.getElementById('headerBranchSelect');
    if (sel2 && sel2.value !== code) sel2.value = code;

    // Cập nhật text hiển thị
    const bInfo = branchConfigMap[code];
    const addrVal = document.getElementById('showroomAddressVal');
    if (addrVal) addrVal.textContent = bInfo.address || 'Showroom Phong Vũ';

    const badgeCode = document.getElementById('showroomBadgeCode');
    if (badgeCode) badgeCode.textContent = code;

    const sumStoreEl = document.getElementById('sumStoreCode');
    if (sumStoreEl) sumStoreEl.textContent = `${code} (${bInfo.name})`;
  }

  const cart = {}; // { sku: { sku, name, listPrice, promoPrice, discount, quantity } }
  let currentDeliveryType = 'SHOWROOM';
  let selectedPaymentMethod = 'COD';
  let recentOrders = [];
  let latestCreatedOrderCode = '';

  const paymentMethodLabels = {
    COD: '📦 Thanh toán khi nhận hàng (COD)',
    BANK_TRANSFER: '🏦 Chuyển khoản',
    CARD: '💳 Quẹt thẻ POS',
    CASH: '💵 Tiền mặt'
  };

  function selectPaymentMethod(method) {
    selectedPaymentMethod = method;
    ['payOptCod', 'payOptBank', 'payOptCard', 'payOptCash'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('active');
    });

    const idMap = {
      COD: 'payOptCod',
      BANK_TRANSFER: 'payOptBank',
      CARD: 'payOptCard',
      CASH: 'payOptCash'
    };
    const activeEl = document.getElementById(idMap[method] || 'payOptCod');
    if (activeEl) activeEl.classList.add('active');

    const noteEl = document.getElementById('paymentMethodNoteText');
    if (noteEl) {
      if (method === 'COD') {
        noteEl.innerHTML = 'Gán hình thức <strong>Thanh toán khi nhận hàng (COD)</strong> vào đơn.';
      } else if (method === 'BANK_TRANSFER') {
        noteEl.innerHTML = 'Gán hình thức <strong>Chuyển khoản</strong>. Khi lên máy SPOS tại showroom, cho khách quét mã VietQR và xác nhận thanh toán.';
      } else if (method === 'CARD') {
        noteEl.innerHTML = 'Gán hình thức <strong>Quẹt thẻ</strong>. Khi lên máy SPOS tại showroom, quẹt thẻ khách qua máy SmartPOS và in phiếu.';
      } else {
        noteEl.innerHTML = 'Gán hình thức <strong>Tiền mặt</strong>. Khi lên máy SPOS tại showroom, bạn thu tiền mặt và in phiếu.';
      }
    }

    const sumPmEl = document.getElementById('sumPaymentMethod');
    if (sumPmEl) {
      sumPmEl.textContent = paymentMethodLabels[method] || method;
    }
  }

  const formatVND = (n) => new Intl.NumberFormat('vi-VN').format(Number(n || 0)) + ' đ';

  // ==========================================
  // SPOS / TEKO TOKEN MANAGEMENT
  // ==========================================
  let tekoToken = localStorage.getItem('qe_teko_token') || '';

  function getJwtInfo(token) {
    if (!token) return null;
    try {
      const parts = token.split('.');
      if (parts.length !== 3) return null;
      const payload = JSON.parse(atob(parts[1]));
      const now = Math.floor(Date.now() / 1000);
      const isExpired = payload.exp ? payload.exp < now : false;
      return { payload, isExpired, email: payload.email || payload.sub || '' };
    } catch (e) {
      return null;
    }
  }

  function updateTokenBadge() {
    const badge = document.getElementById('sposTokenBadge');
    const text = document.getElementById('sposTokenText');
    if (!badge || !text) return;
    tekoToken = localStorage.getItem('qe_teko_token') || '';
    const jwt = getJwtInfo(tekoToken);
    if (tekoToken && jwt && !jwt.isExpired) {
      badge.style.background = '#f0fdf4';
      badge.style.color = '#166534';
      badge.style.borderColor = '#bbf7d0';
      const staffName = jwt.email ? jwt.email.split('@')[0] : 'Nhân viên';
      text.innerHTML = `🟢 SPOS: Đã kết nối (${staffName})`;
    } else if (tekoToken && jwt && jwt.isExpired) {
      badge.style.background = '#fef2f2';
      badge.style.color = '#b91c1c';
      badge.style.borderColor = '#fecaca';
      text.innerHTML = `🔴 SPOS: Token hết hạn (Bấm gia hạn)`;
    } else {
      badge.style.background = '#fffbeb';
      badge.style.color = '#92400e';
      badge.style.borderColor = '#fde68a';
      text.innerHTML = `⚠️ SPOS: Chưa đồng bộ token`;
    }
  }

  function checkOrPromptToken() {
    tekoToken = localStorage.getItem('qe_teko_token') || '';
    const jwt = getJwtInfo(tekoToken);
    if (!tekoToken || (jwt && jwt.isExpired)) {
      if (confirm('Phiên làm việc SPOS/ERP chưa có hoặc đã hết hạn.\n\nBạn có muốn mở trang erp.phongvu.vn để Extension tự động gia hạn token kết nối SPOS không?')) {
        window.open('https://erp.phongvu.vn', '_blank');
      }
    } else {
      alert(`Đã kết nối tài khoản SPOS thành công: ${jwt?.email || 'Hợp lệ'}`);
    }
  }

  window.addEventListener('DOMContentLoaded', async () => {
    updateTokenBadge();
    // Nếu chưa có token hoặc token hết hạn, thử lấy token đã lưu từ máy chủ
    if (!tekoToken || getJwtInfo(tekoToken)?.isExpired) {
      try {
        const res = await fetch('/api/quick-export/settings');
        const data = await res.json();
        if (data && data.success && data.settings?.tekoToken) {
          localStorage.setItem('qe_teko_token', data.settings.tekoToken);
          tekoToken = data.settings.tekoToken;
          updateTokenBadge();
        }
      } catch (e) {}
    }
  });

  window.addEventListener('storage', (e) => {
    if (e.key === 'qe_teko_token') {
      tekoToken = e.newValue || '';
      updateTokenBadge();
    }
  });

  window.addEventListener('message', (event) => {
    if (event.data && event.data.type === 'PHONGVU_ERP_TOKEN_SYNC') {
      const newToken = event.data.token;
      if (newToken) {
        localStorage.setItem('qe_teko_token', newToken);
        tekoToken = newToken;
        updateTokenBadge();
      }
    }
  });

  // ==========================================
  // SEARCH SKU & AUTOCOMPLETE
  // ==========================================
  const searchInput = document.getElementById('skuSearchInput');
  const searchDropdown = document.getElementById('skuSearchDropdown');
  let searchTimeout = null;

  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const q = this.value.trim();
    if (!q || q.length < 2) {
      searchDropdown.style.display = 'none';
      return;
    }
    searchTimeout = setTimeout(() => fetchProducts(q), 220);
  });

  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      const q = this.value.trim();
      if (q) {
        // Nếu là quét barcode hoặc gõ đúng mã SKU, trực tiếp lấy chi tiết sản phẩm
        quickAddBySku(q);
      }
    }
  });

  async function fetchProducts(query) {
    try {
      const res = await fetch(`/api/quote/search-products?q=${encodeURIComponent(query)}`);
      const data = await res.json();
      const products = Array.isArray(data) ? data : (data.products || []);
      renderSearchDropdown(products);
    } catch (err) {
      console.warn('Lỗi tìm kiếm sản phẩm:', err);
    }
  }

  function renderSearchDropdown(products) {
    if (!products || products.length === 0) {
      searchDropdown.innerHTML = '<div style="padding: 12px; text-align: center; color: #94a3b8; font-size: 13px;">Không tìm thấy sản phẩm phù hợp.</div>';
      searchDropdown.style.display = 'block';
      return;
    }

    let html = '';
    products.slice(0, 15).forEach((p) => {
      const sku = p.sku;
      const name = p.product_name || p.name || `Sản phẩm ${sku}`;
      const listP = Number(p.list_price) || 0;
      const promoP = (p.promo_price && Number(p.promo_price) > 0) ? Number(p.promo_price) : listP;
      const hasDiscount = promoP < listP;

      html += `
        <div class="qo-search-item" onclick="addItemToCart('${sku}')">
          <div class="qo-item-info">
            <div class="qo-item-title">${escapeHtml(name)}</div>
            <div class="qo-item-meta">
              <span style="font-family: var(--qo-mono); font-weight: 700; color: #1d4ed8;">SKU: ${sku}</span>
              ${p.brand ? `<span>• Hiệu: ${escapeHtml(p.brand)}</span>` : ''}
              ${p.warranty ? `<span>• BH: ${escapeHtml(p.warranty)}</span>` : ''}
            </div>
          </div>
          <div class="qo-item-price-group">
            <div class="qo-item-price">${formatVND(promoP)}</div>
            ${hasDiscount ? `<div class="qo-item-original-price">${formatVND(listP)}</div>` : ''}
          </div>
        </div>
      `;
    });

    searchDropdown.innerHTML = html;
    searchDropdown.style.display = 'block';
  }

  // Đóng dropdown khi click ra ngoài
  document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
      searchDropdown.style.display = 'none';
    }
  });

  // Thêm nhanh khi quét barcode hoặc ấn Enter
  async function quickAddBySku(sku) {
    searchDropdown.style.display = 'none';
    searchInput.value = '';
    await addItemToCart(sku);
  }

  // ==========================================
  // THÊM & CẬP NHẬT GIỎ HÀNG (REALTIME PROMO)
  // ==========================================
  async function addItemToCart(sku) {
    searchDropdown.style.display = 'none';
    searchInput.value = '';

    // Nếu đã có trong giỏ -> Tăng số lượng
    if (cart[sku]) {
      cart[sku].quantity += 1;
      renderCart();
      return;
    }

    // Nếu chưa có -> Tạo tạm và gọi API lấy chi tiết giá KM mới nhất
    cart[sku] = {
      sku: sku,
      name: `Đang tải thông tin ${sku}...`,
      listPrice: 0,
      promoPrice: 0,
      discount: 0,
      quantity: 1,
      _loading: true
    };
    renderCart();

    try {
      const res = await fetch(`/api/sku/${encodeURIComponent(sku)}/details?refresh=1`);
      const data = await res.json();
      if (data && data.ok && data.product) {
        const p = data.product;
        const listP = Number(p.list_price) || 0;
        const promoP = (p.promo_price && Number(p.promo_price) > 0) ? Number(p.promo_price) : listP;
        const promoDiscount = (p.discount_amount && Number(p.discount_amount) > 0) 
            ? Number(p.discount_amount) 
            : Math.max(0, listP - promoP);

        if (cart[sku]) {
          cart[sku].name = p.product_name || `Sản phẩm ${sku}`;
          cart[sku].listPrice = listP;
          cart[sku].promoPrice = promoP;
          cart[sku].discount = promoDiscount;
          cart[sku].warranty = p.warranty || '';
          cart[sku].vat_rate = p.vat_rate;
          delete cart[sku]._loading;
        }
      } else {
        if (cart[sku]) {
          cart[sku].name = `Sản phẩm ${sku}`;
          delete cart[sku]._loading;
        }
      }
    } catch (e) {
      console.warn('Lỗi fetch chi tiết SKU:', e);
      if (cart[sku]) {
        cart[sku].name = `Sản phẩm SKU ${sku}`;
        delete cart[sku]._loading;
      }
    }

    renderCart();
  }

  function changeQuantity(sku, delta) {
    if (!cart[sku]) return;
    const newQty = cart[sku].quantity + delta;
    if (newQty <= 0) {
      delete cart[sku];
    } else {
      cart[sku].quantity = newQty;
    }
    renderCart();
  }

  function setQuantity(sku, val) {
    if (!cart[sku]) return;
    const qty = Math.max(1, parseInt(val) || 1);
    cart[sku].quantity = qty;
    renderCart();
  }

  function changeItemDiscount(sku, val) {
    if (!cart[sku]) return;
    cart[sku].discount = Math.max(0, parseFloat(val) || 0);
    renderCart();
  }

  function removeItem(sku) {
    delete cart[sku];
    renderCart();
  }

  function clearCart() {
    if (Object.keys(cart).length === 0) return;
    if (confirm('Bạn có chắc chắn muốn làm trống giỏ hàng?')) {
      for (const k in cart) delete cart[k];
      renderCart();
    }
  }

  // ==========================================
  // RENDER CART & TÍNH TOÁN TỔNG TIỀN
  // ==========================================
  function renderCart() {
    const skus = Object.keys(cart);
    const cartCountEl = document.getElementById('cartCount');
    const emptyStateEl = document.getElementById('cartEmptyState');
    const tableWrapperEl = document.getElementById('cartTableWrapper');
    const tbody = document.getElementById('cartTableBody');
    const btnSubmit = document.getElementById('btnSubmitOrder');

    cartCountEl.textContent = skus.length;

    if (skus.length === 0) {
      emptyStateEl.style.display = 'block';
      tableWrapperEl.style.display = 'none';
      btnSubmit.disabled = true;
      updateSummary(0, 0, 0, 0);
      return;
    }

    emptyStateEl.style.display = 'none';
    tableWrapperEl.style.display = 'block';
    btnSubmit.disabled = false;

    let totalList = 0;
    let totalPromo = 0;
    let totalManual = 0;
    let totalPayable = 0;

    let html = '';
    skus.forEach((sku) => {
      const it = cart[sku];
      const listP = it.listPrice || 0;
      const promoP = it.promoPrice > 0 ? it.promoPrice : listP;
      const promoD = Math.max(0, listP - promoP);
      const manualD = it.discount || 0;
      const finalP = Math.max(0, promoP - manualD);
      const lineTotal = finalP * it.quantity;

      totalList += listP * it.quantity;
      totalPromo += promoD * it.quantity;
      totalManual += manualD * it.quantity;
      totalPayable += lineTotal;

      html += `
        <tr>
          <td>
            <div style="font-weight: 600; color: #1e293b; line-height: 1.35;">${escapeHtml(it.name)}</div>
            <div style="font-size: 11px; color: #64748b; font-family: var(--qo-mono); margin-top: 2px;">
              SKU: <strong style="color: #1d4ed8;">${sku}</strong>
              ${it.warranty ? ` • BH: ${escapeHtml(it.warranty)}` : ''}
            </div>
          </td>
          <td style="text-align: right;">
            <div style="font-weight: 700; color: #1e293b;">${formatVND(promoP)}</div>
            ${promoD > 0 ? `<div style="font-size: 10.5px; color: #94a3b8; text-decoration: line-through;">${formatVND(listP)}</div>` : ''}
          </td>
          <td style="text-align: center;">
            <div class="qo-qty-ctrl">
              <button type="button" class="qo-qty-btn" onclick="changeQuantity('${sku}', -1)">-</button>
              <input type="number" class="qo-qty-input" value="${it.quantity}" min="1" 
                     onchange="setQuantity('${sku}', this.value)">
              <button type="button" class="qo-qty-btn" onclick="changeQuantity('${sku}', 1)">+</button>
            </div>
          </td>
          <td style="text-align: right;">
            <input type="number" class="qo-discount-input" value="${it.discount}" min="0" step="1000"
                   placeholder="0" onchange="changeItemDiscount('${sku}', this.value)"
                   title="Chiết khấu riêng cho từng món">
          </td>
          <td style="text-align: right; font-weight: 800; color: #15803d; font-size: 14px;">
            ${formatVND(lineTotal)}
          </td>
          <td style="text-align: center;">
            <button type="button" class="qo-btn-del" title="Xóa món này" onclick="removeItem('${sku}')">×</button>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;
    updateSummary(totalList, totalPromo, totalManual, totalPayable);
  }

  function updateSummary(list, promo, manual, finalPay) {
    document.getElementById('sumListPrice').textContent = formatVND(list);
    document.getElementById('sumPromoDisc').textContent = '-' + formatVND(promo);
    document.getElementById('sumManualDisc').textContent = '-' + formatVND(manual);
    document.getElementById('sumFinalPayable').textContent = formatVND(finalPay);
  }

  // ==========================================
  // HÌNH THỨC NHẬN HÀNG (DELIVERY TYPE)
  // ==========================================
  function switchDeliveryType(type) {
    currentDeliveryType = type;
    const tabPickup = document.getElementById('tabPickup');
    const tabDelivery = document.getElementById('tabDelivery');
    const boxShowroom = document.getElementById('boxShowroomInfo');
    const boxDelivery = document.getElementById('boxDeliveryAddress');

    if (type === 'SHOWROOM') {
      tabPickup.classList.add('active');
      tabDelivery.classList.remove('active');
      boxShowroom.style.display = 'block';
      boxDelivery.style.display = 'none';
    } else {
      tabPickup.classList.remove('active');
      tabDelivery.classList.add('active');
      boxShowroom.style.display = 'none';
      boxDelivery.style.display = 'block';
      document.getElementById('deliveryAddressInput').focus();
    }
  }

  // ==========================================
  // SUBMIT TẠO ĐƠN HÀNG
  // ==========================================
  async function submitQuickOrder() {
    const custName = document.getElementById('custName').value.trim();
    const custPhone = document.getElementById('custPhone').value.trim();
    const orderNote = document.getElementById('orderNote').value.trim();
    const skus = Object.keys(cart);

    if (skus.length === 0) {
      alert('Vui lòng thêm ít nhất một sản phẩm vào giỏ hàng.');
      searchInput.focus();
      return;
    }

    if (!custName) {
      alert('Vui lòng nhập Tên khách hàng.');
      document.getElementById('custName').focus();
      return;
    }

    if (!custPhone || custPhone.length < 9) {
      alert('Vui lòng nhập Số điện thoại hợp lệ của khách hàng.');
      document.getElementById('custPhone').focus();
      return;
    }

    let deliveryAddress = '';
    if (currentDeliveryType === 'DELIVERY') {
      deliveryAddress = document.getElementById('deliveryAddressInput').value.trim();
      if (!deliveryAddress) {
        alert('Vui lòng nhập Địa chỉ giao hàng khi chọn hình thức Giao tận nơi.');
        document.getElementById('deliveryAddressInput').focus();
        return;
      }
    }

    const btnSubmit = document.getElementById('btnSubmitOrder');
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '⏳ ĐANG TẠO ĐƠN HÀNG...';

    const orderPayload = {
      customer: {
        name: custName,
        phone: custPhone
      },
      delivery: {
        type: currentDeliveryType,
        useShowroomAddress: currentDeliveryType === 'SHOWROOM',
        address: deliveryAddress
      },
      items: skus.map(s => ({
        sku: s,
        name: cart[s].name,
        quantity: cart[s].quantity,
        listPrice: cart[s].listPrice,
        promoPrice: cart[s].promoPrice,
        discount: cart[s].discount
      })),
      note: orderNote,
      paymentMethod: selectedPaymentMethod,
      branchCode: currentBranchCode
    };

    try {
      tekoToken = localStorage.getItem('qe_teko_token') || '';
      const jwt = getJwtInfo(tekoToken);
      if (!tekoToken || (jwt && jwt.isExpired)) {
        const proceed = confirm('⚠️ Chú ý: Phiên kết nối SPOS của bạn chưa có hoặc đã hết hạn.\n\nĐể đơn hàng xuất hiện trong tab "Đang xử lý" trên app SPOS của bạn, bạn nên mở ERP để Extension đồng bộ token trước.\n\nBấm "Cancel" để dừng lại mở ERP, hoặc "OK" để tiếp tục tạo đơn.');
        if (!proceed) {
          window.open('https://erp.phongvu.vn', '_blank');
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = '<span>🚀</span><span>TẠO ĐƠN HÀNG (CHỜ THU TRÊN SPOS)</span>';
          return;
        }
      }

      const res = await fetch('/api/quick-order/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-teko-token': tekoToken
        },
        body: JSON.stringify(orderPayload)
      });
      const data = await res.json();

      if (data && data.ok) {
        latestCreatedOrderCode = data.orderCode;
        showSuccessModal(data);
        saveToRecentOrders(data.orderData || {
          orderCode: data.orderCode,
          customer: { name: custName, phone: custPhone },
          pricing: { totalPayable: data.totalPayable },
          paymentMethod: selectedPaymentMethod,
          paymentMethodLabel: paymentMethodLabels[selectedPaymentMethod],
          createdAt: new Date().toISOString()
        });
      } else {
        alert('Không thể tạo đơn: ' + (data.error || 'Lỗi không xác định.'));
      }
    } catch (err) {
      alert('Lỗi kết nối khi tạo đơn hàng: ' + err.message);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = '<span>🚀</span><span>TẠO ĐƠN HÀNG (CHỜ THU TRÊN SPOS)</span>';
    }
  }

  // ==========================================
  // SUCCESS MODAL & BARCODE GENERATOR
  // ==========================================
  function showSuccessModal(data) {
    const code = String(data.orderCode || '').replace(/^#/, '');
    const displayCode = `#${code}`;
    document.getElementById('modalOrderCode').textContent = displayCode;
    document.getElementById('modalCustName').textContent = data.orderData?.customer?.name || document.getElementById('custName').value;
    document.getElementById('modalCustPhone').textContent = data.orderData?.customer?.phone || document.getElementById('custPhone').value;
    document.getElementById('modalTotalPayable').textContent = formatVND(data.totalPayable);

    const pmLabel = data.orderData?.paymentMethodLabel || paymentMethodLabels[data.paymentMethod || selectedPaymentMethod] || 'Tiền mặt';
    const modalPmEl = document.getElementById('modalPaymentMethod');
    if (modalPmEl) modalPmEl.textContent = pmLabel;

    const bCode = data.orderData?.branchCode || currentBranchCode;
    const bName = branchConfigMap[bCode]?.name || bCode;
    const modalBranchEl = document.getElementById('modalBranchInfo');
    if (modalBranchEl) modalBranchEl.textContent = `${bCode} - ${bName}`;

    // Sinh Barcode Code128 bằng JsBarcode (chỉ lấy chuỗi số, không lấy ký tự #)
    try {
      JsBarcode('#barcodeCanvas', code, {
        format: 'CODE128',
        lineColor: '#0f172a',
        width: 2.2,
        height: 50,
        displayValue: true,
        fontSize: 14,
        margin: 4
      });
    } catch (e) {
      console.warn('Lỗi vẽ barcode:', e);
    }

    document.getElementById('copyBtnText').textContent = 'Sao chép mã đơn';
    document.getElementById('orderSuccessModal').classList.add('active');
  }

  function closeSuccessModal() {
    document.getElementById('orderSuccessModal').classList.remove('active');
  }

  function startNewOrder() {
    closeSuccessModal();
    // Làm mới giỏ và form
    for (const k in cart) delete cart[k];
    renderCart();
    document.getElementById('custName').value = '';
    document.getElementById('custPhone').value = '';
    document.getElementById('orderNote').value = '';
    document.getElementById('deliveryAddressInput').value = '';
    switchDeliveryType('SHOWROOM');
    selectPaymentMethod('COD');
    searchInput.focus();
  }

  function copyOrderCode() {
    if (!latestCreatedOrderCode) return;
    const clean = String(latestCreatedOrderCode).replace(/^#/, '');
    navigator.clipboard.writeText(clean).then(() => {
      document.getElementById('copyBtnText').textContent = 'Đã sao chép!';
      setTimeout(() => {
        document.getElementById('copyBtnText').textContent = 'Sao chép mã đơn';
      }, 2500);
    });
  }

  // ==========================================
  // LỊCH SỬ ĐƠN HÀNG GẦN ĐÂY
  // ==========================================
  function saveToRecentOrders(order) {
    recentOrders.unshift(order);
    if (recentOrders.length > 20) recentOrders.pop();
    try {
      localStorage.setItem('qo_recent_orders', JSON.stringify(recentOrders));
    } catch (e) {}
    renderRecentOrders();
  }

  function loadRecentOrders() {
    try {
      const stored = localStorage.getItem('qo_recent_orders');
      if (stored) {
        recentOrders = JSON.parse(stored) || [];
      }
    } catch (e) {
      recentOrders = [];
    }
    renderRecentOrders();
  }

  function renderRecentOrders() {
    const wrapper = document.getElementById('recentOrdersWrapper');
    const empty = document.getElementById('recentOrdersEmpty');
    const tbody = document.getElementById('recentOrdersBody');

    if (recentOrders.length === 0) {
      wrapper.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    wrapper.style.display = 'block';
    empty.style.display = 'none';

    let html = '';
    recentOrders.forEach((o) => {
      const timeStr = new Date(o.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
      const cleanCode = String(o.orderCode || '').replace(/^#/, '');
      const pmLabel = o.paymentMethodLabel || paymentMethodLabels[o.paymentMethod] || '📦 COD';
      html += `
        <tr>
          <td>
            <strong style="font-family: var(--qo-mono); color: #1d4ed8;">#${cleanCode}</strong>
            <span style="display: block; font-size: 11px; color: #166534; font-weight: 600;">Đang xử lý</span>
          </td>
          <td>${escapeHtml(o.customer?.name || 'Khách lẻ')}</td>
          <td>${escapeHtml(o.customer?.phone || '')}</td>
          <td>
            <span style="font-size: 11px; font-weight: 600; color: #1e40af; background: #eff6ff; padding: 2px 6px; border-radius: 4px; border: 1px solid #bfdbfe;">
              ${escapeHtml(pmLabel)}
            </span>
          </td>
          <td style="text-align: right; font-weight: 700; color: #15803d;">${formatVND(o.pricing?.totalPayable || 0)}</td>
          <td style="color: #64748b;">${timeStr}</td>
          <td style="text-align: center;">
            <button type="button" class="qo-btn-copy" style="margin: 0; padding: 3px 8px;" 
                    onclick="copySpecificCode('${cleanCode}')">Copy</button>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = html;
  }

  function copySpecificCode(code) {
    navigator.clipboard.writeText(code).then(() => {
      alert(`Đã sao chép mã đơn: ${code}`);
    });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // Khởi tạo giao diện ban đầu
  onBranchChange(currentBranchCode);
  renderCart();
  loadRecentOrders();
</script>
