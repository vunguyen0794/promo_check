<script>
  // ==========================================
  // STATE MANAGEMENT
  // ==========================================
  const branchConfigMap = <%- JSON.stringify(branches) %>;
  const assignedBranchCode = '<%= branchCode %>';
  const currentUserId = '<%= user ? user.id : "guest" %>';
  const currentUserEmail = '<%= user ? (user.email || "").toLowerCase().trim() : "" %>';
  const isManagerOrAdmin = <%= Boolean(user && (user.role === 'admin' || user.role === 'manager')) %>;

  function isVuAccount(email, id) {
    const e = (email || '').toLowerCase().trim();
    return e === 'vu.nt1@phongvu-mna.vn' || 
           e === 'vu.nt2@phongvu-mna.vn' || 
           id === 'f1bebeaf-fc7e-4e15-afd2-eccf5309cb40' || 
           id === '9b514d2c-f2d3-4ecb-ab2b-7530fcb3cf1a';
  }
  const isVuUser = isVuAccount(currentUserEmail, currentUserId);

  // Luồng hiển thị khi chưa lấy token: Mặc định branch & địa chỉ từ phân quyền Supabase
  let currentBranchCode = assignedBranchCode;
  if (!branchConfigMap[currentBranchCode]) {
    currentBranchCode = Object.keys(branchConfigMap).filter(k => k !== 'DEFAULT')[0] || 'CP01';
  }

  function onBranchChange(code) {
    if (!code) return;
    const bInfo = branchConfigMap[code] || branchConfigMap['DEFAULT'] || {};
    currentBranchCode = code;

