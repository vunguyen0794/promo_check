  // ==========================================
  let tekoToken = localStorage.getItem('qe_teko_token') || '';
  let _qoPollingTimer = null;
  let _qoPollingCount = 0;

  function getJwtInfo(token) {
    if (!token) return null;
    try {
      const clean = token.replace(/^Bearer\s+/i, '').trim();
      const parts = clean.split('.');
      if (parts.length !== 3) return null;
      const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
      const now = Math.floor(Date.now() / 1000);
      const isExpired = payload.exp ? payload.exp < now : false;
      const isVuSub = payload.sub === '7c9dc072cbdf45d9af7c1ee203e2c796';
      const email = payload.email || (isVuSub ? 'vu.nt1@phongvu-mna.vn' : (payload.sub || ''));
      const name = payload.name || payload.fullName || (isVuSub ? 'Nguyễn Tuấn Vũ' : '');
      const expiresDate = payload.exp ? new Date(payload.exp * 1000) : null;
      return { payload, isExpired, email, name, isVuSub, expiresDate };
    } catch (e) {
      return null;
    }
  }

  function validateAndApplyToken(rawToken, silent = false, isInitial = false) {
    if (!rawToken) {
      updateTokenBadge();
      return { valid: false };
    }
    const clean = rawToken.replace(/^Bearer\s+/i, '').trim();
    const jwt = getJwtInfo(clean);
    if (!jwt || jwt.isExpired) {
      updateTokenBadge();
      return { valid: false, expired: true };
    }

    // 1. ĐỐI CHIẾU TOKEN VỚI vu.nt1/vu.nt2:
    // Nếu token thuộc về Vũ nhưng user đăng nhập trên web miền KHÔNG PHẢI Vũ
    if (jwt.isVuSub && !isVuUser) {
      localStorage.removeItem('qe_teko_token');
      tekoToken = '';
      updateTokenBadge();
      if (!silent) {
        alert('⚠️ CẢNH BÁO AN TOÀN:\n\nToken SPOS này thuộc về tài khoản Vũ Nguyễn Tuấn!\nBạn không thể sử dụng token của người khác.\n\nVui lòng mở trang https://erp.phongvu.vn và đăng nhập tài khoản của bạn để kết nối token chính chủ.');
      }
      return { valid: false, misassigned: true };
    }

    // 2. CHECK BRANCH TRÊN TOKEN:
    let tokenBranch = '';
    if (jwt.payload) {
      const pl = jwt.payload;
      if (pl.terminalCode && branchConfigMap[pl.terminalCode]) tokenBranch = pl.terminalCode;
      else if (pl.storeCode && branchConfigMap[pl.storeCode]) tokenBranch = pl.storeCode;
      else if (Array.isArray(pl.terminals) && pl.terminals.length > 0) {
        const match = pl.terminals.find(t => branchConfigMap[t]);
        if (match) tokenBranch = match;
      }
    }

    // Chỉ tự đổi chi nhánh nếu JWT có chứa chi nhánh cụ thể hoặc lúc khởi tạo ban đầu
    if (tokenBranch && branchConfigMap[tokenBranch] && tokenBranch !== currentBranchCode) {
      onBranchChange(tokenBranch);
    } else if (isInitial && assignedBranchCode && branchConfigMap[assignedBranchCode]) {
      onBranchChange(assignedBranchCode);
    }

    tekoToken = clean;
    updateTokenBadge();
    return { valid: true, email: jwt.email, branch: currentBranchCode };
  }

  function updateTokenBadge() {
    const badge = document.getElementById('sposTokenBadge');
    const text = document.getElementById('sposTokenText');
    const dot = document.getElementById('dotToken');
    if (!badge || !text) return;
    tekoToken = localStorage.getItem('qe_teko_token') || '';
    const jwt = getJwtInfo(tekoToken);
    if (tekoToken && jwt && !jwt.isExpired) {
      if (jwt.isVuSub && !isVuUser) {
        if (dot) dot.classList.remove('active');
        text.innerHTML = `SPOS: Chưa kết nối`;
        return;
      }
      if (dot) dot.classList.add('active');
      const displayName = jwt.name || (jwt.email ? jwt.email.split('@')[0] : 'Đã kết nối');
      const expTime = jwt.expiresDate ? jwt.expiresDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '';
      text.innerHTML = `SPOS: Đã kết nối (${displayName}${expTime ? ' - Hạn: ' + expTime : ''})`;
    } else if (tekoToken && jwt && jwt.isExpired) {
      if (dot) dot.classList.remove('active');
      text.innerHTML = `SPOS: Token hết hạn (Bấm gia hạn)`;
    } else {
      if (dot) dot.classList.remove('active');
      text.innerHTML = `SPOS: Chưa kết nối (Bấm kết nối)`;
    }
  }

