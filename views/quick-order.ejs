            <div class="qo-item-price">${formatVND(promoP)}</div>
            ${hasDiscount ? `<div class="qo-item-original-price">${formatVND(listP)}</div>` : ''}
          </div>
        </div>
      `;
    });

    searchDropdown.innerHTML = html;
    searchDropdown.style.display = 'block';
  }

