  async function refreshCartStock(branch) {
    const skus = Object.keys(cart);
    if (skus.length === 0) return;
    for (const sku of skus) {
      if (cart[sku]) {
        fetchStockDetail(sku, branch).then(stock => {
          if (cart[sku]) {
            cart[sku].stockInfo = stock;
            renderCart();
          }
        });
        // Cập nhật giá niêm yết và giá khuyến mãi theo đúng showroom đang chọn
        fetch(`/api/sku/${encodeURIComponent(sku)}/details?branch=${encodeURIComponent(branch)}&refresh=1`)
          .then(r => r.json())
          .then(resProd => {
            if (resProd && resProd.ok && resProd.product && cart[sku]) {
              const p = resProd.product;
              const listP = Number(p.list_price) || 0;
              const promoP = (p.promo_price && Number(p.promo_price) > 0) ? Number(p.promo_price) : listP;
              cart[sku].listPrice = listP;
              cart[sku].promoPrice = promoP;
              cart[sku].promotions = p.promotions || [];
              const discountPromo = (p.promotions || []).find(pr => (pr.benefit?.discount?.flat > 0 || pr.benefit?.discount?.percent > 0));
              cart[sku].selectedPromotionId = discountPromo ? discountPromo.id : ((p.promotions && p.promotions.length > 0) ? p.promotions[0].id : null);
              cart[sku].flashSales = p.flash_sales || [];
              cart[sku].marketingPromotions = p.marketing_promotions || [];
              renderCart();
            }
          })
          .catch(() => null);
      }
    }
  }

