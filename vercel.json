{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "http://222.255.184.49/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-all",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/sync-promotions",
      "schedule": "30 12 * * *"
    }
  ]
}